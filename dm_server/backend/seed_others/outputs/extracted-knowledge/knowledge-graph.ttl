<urn:cpi:rule:v68:clause1539:r1> a cpi:PolicyRule ;
    rdfs:label "Suggested Training Prompt for Evidence Checklist Creation" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:d9fec564d2da12d10ad5> ;
