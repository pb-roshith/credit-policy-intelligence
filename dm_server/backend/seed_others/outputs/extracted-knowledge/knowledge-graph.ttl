    cpi:CLASSIFIED_AS <urn:cpi:policyclass:3f0beaa5d17bcb61b813> ;
    cpi:DERIVED_FROM <urn:cpi:source:59:494> ;
    cpi:PART_OF_VERSION <urn:cpi:version:59> ;
    cpi:requirement_text "Cure shall use approved payment and observation requirements and shall not be inferred from one isolated payment."^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v59:clause494:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:59:494> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v59:clause502:r1> a cpi:PolicyRule ;
    rdfs:label "Management Information Reporting Coverage Rule" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:08301552b025a4c29694> ;
    cpi:DERIVED_FROM <urn:cpi:source:59:502> ;
    cpi:PART_OF_VERSION <urn:cpi:version:59> ;
