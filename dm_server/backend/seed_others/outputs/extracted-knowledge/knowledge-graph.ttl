        <urn:cpi:rule:v48:clause230:r10:threshold:1> ;
    cpi:PART_OF_VERSION <urn:cpi:version:48> ;
    cpi:USES_METRIC <urn:cpi:riskmetric:d1b222d1e468ecab93d8> ;
    cpi:requirement_text """Similarly, an ICR between 2.00x
and 3.00x (for investment-grade borrowers) triggers a warning,"""^^xsd:string ;
    cpi:rule_kind "QUANTITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v48:clause230:r10"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:48:230> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v49:clause252:r6> a cpi:PolicyRule ;
    rdfs:label "Credit Risk Committee Exception Approval for Eligibility Non-Compliance" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:9ec908f0bf2d80d3eebe>,
        <urn:cpi:policyclass:acb66a8f8a7f374455cb> ;
    cpi:DERIVED_FROM <urn:cpi:source:49:252> ;
    cpi:HAS_EXCEPTION <urn:cpi:rule:v49:clause252:r7:exception> ;
    cpi:PART_OF_VERSION <urn:cpi:version:49> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v49:clause252:r6:approval:0> ;
    cpi:REQUIRES_EVIDENCE <urn:cpi:rule:v49:clause252:r6:evidence:0>,
        <urn:cpi:rule:v49:clause252:r6:evidence:1> ;
    cpi:requirement_text """In cases where the collateral does not fully meet the bank’s eligibility criteria, the credit officer may seek an exception through
the bank’s formal exception management process. Exceptions require detailed justification, including an assessment of the
incremental risk and the mitigating factors. These are reviewed and approved by the CRC, with higher-risk exceptions requiring
Board approval. All exceptions are documented in the bank’s exception log and are subject to enhanced monitoring."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v49:clause252:r6"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:49:252> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v51:clause290:r6> a cpi:PolicyRule ;
    rdfs:label "Structured Credit Products RAROC Floor" ;
    cpi:APPLIES_TO_PRODUCT <urn:cpi:product:20c182cd64809b599cab>,
        <urn:cpi:product:476da81418418673d607>,
        <urn:cpi:product:604f9de4e0d7c46a8f05> ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:51785e55a44e8ac3604c>,
        <urn:cpi:policyclass:c60494e8688cdde53c52> ;
    cpi:DERIVED_FROM <urn:cpi:source:51:290> ;
    cpi:EVALUATES_RISK_ATTRIBUTE <urn:cpi:riskmetric:23b545fc3cf095436993> ;
    cpi:HAS_THRESHOLD <urn:cpi:rule:v51:clause290:r6:threshold:0> ;
    cpi:PART_OF_VERSION <urn:cpi:version:51> ;
    cpi:USES_METRIC <urn:cpi:riskmetric:23b545fc3cf095436993> ;
    cpi:requirement_text """Structured Credit Products, including collateralized loan obligations (CLOs) and
credit derivatives, are subject to a floor of 22%, reflecting their leverage, complexity, and potential for tail risk."""^^xsd:string ;
    cpi:rule_kind "QUANTITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v51:clause290:r6"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:51:290> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v54:clause353:r2> a cpi:PolicyRule ;
    rdfs:label "Regional Credit Officer Approval Requirement for Mid-Tier Loans" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:9357aa360ca9e8840c5b>,
