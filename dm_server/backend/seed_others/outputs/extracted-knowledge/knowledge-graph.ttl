    cpi:USES_METRIC <urn:cpi:riskmetric:061447e63c40306cf34e> ;
    cpi:requirement_text """The scope of this Policy explicitly excludes retail lending products with durations of less than 1 year, as these are deemed to
have immaterial duration risk under normal market conditions."""^^xsd:string ;
    cpi:rule_kind "QUANTITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v72:clause1611:r2"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:72:1611> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

