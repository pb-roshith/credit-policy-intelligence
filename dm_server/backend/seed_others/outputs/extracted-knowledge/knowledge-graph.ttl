    cpi:USES_METRIC <urn:cpi:riskmetric:5af29cff4d7e25f8e7df> ;
    cpi:requirement_text "The first trigger is activated when the Bank’s Common Equity Tier 1 (CET1) capital ratio falls below 10.5%."^^xsd:string ;
    cpi:rule_kind "QUANTITATIVE"^^xsd:string ;
