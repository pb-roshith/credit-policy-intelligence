<urn:cpi:rule:v56:clause385:r7> a cpi:PolicyRule ;
    rdfs:label "Low-Risk Transaction Exclusions and Discretionary Escalation" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:24a661299ba3ba4cd0b5>,
        <urn:cpi:policyclass:51785e55a44e8ac3604c> ;
    cpi:DERIVED_FROM <urn:cpi:source:56:385> ;
    cpi:EVALUATES_RISK_ATTRIBUTE <urn:cpi:riskmetric:6f74a08e871a4534b660> ;
    cpi:HAS_CONDITION <urn:cpi:rule:v56:clause385:r7:logic:b0def8c11a24ef4c> ;
    cpi:HAS_THRESHOLD <urn:cpi:rule:v56:clause385:r7:threshold:0> ;
    cpi:PART_OF_VERSION <urn:cpi:version:56> ;
    cpi:USES_METRIC <urn:cpi:riskmetric:6f74a08e871a4534b660> ;
    cpi:requirement_text """Exclusions from this policy are limited to transactions that fall below the USD 1 million threshold and are classified as low-risk
under the bank’s internal risk assessment framework. However, even for such transactions, the relationship manager retains
the discretion to escalate if they deem it necessary based on qualitative factors or market conditions. The CCO may also direct
ad-hoc escalations for specific portfolios or counterparties as part of targeted risk reviews."""^^xsd:string ;
    cpi:rule_kind "QUANTITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v56:clause385:r7"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:56:385> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

