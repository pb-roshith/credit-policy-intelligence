    cpi:HAS_THRESHOLD <urn:cpi:rule:v37:clause181:r6:threshold:0> ;
    cpi:PART_OF_VERSION <urn:cpi:version:37> ;
    cpi:USES_METRIC <urn:cpi:riskmetric:1e8c333066dae0c2c8ad> ;
    cpi:requirement_text """Conversely, if the portfolio contracts by more than 10% in a single quarter,
the limits are increased by 20% to provide flexibility during downturns."""^^xsd:string ;
    cpi:rule_kind "QUANTITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v37:clause181:r6"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:37:181> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

