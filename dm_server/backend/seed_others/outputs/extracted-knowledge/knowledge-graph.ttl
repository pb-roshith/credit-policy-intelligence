    cpi:PART_OF_VERSION <urn:cpi:version:15> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v15:clause104:r3:approval:0> ;
    cpi:REQUIRES_APPROVAL_ABOVE_THRESHOLD <urn:cpi:rule:v15:clause104:r3:approval:0> ;
    cpi:requirement_text "Loans exceeding these limits require approval from a credit manager or higher authority."^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v15:clause104:r3"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:15:104> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v15:clause104:r4> a cpi:PolicyRule ;
    rdfs:label "Approval Escalation for Loans Below Minimum DSCR Down to Hard Floor" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:9ec908f0bf2d80d3eebe>,
        <urn:cpi:policyclass:acb66a8f8a7f374455cb> ;
    cpi:DERIVED_FROM <urn:cpi:source:15:104> ;
    cpi:PART_OF_VERSION <urn:cpi:version:15> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v15:clause104:r4:approval:0> ;
    cpi:requirement_text """For borrowers who fall below the DSCR minimum but meet the hard floor of 1.00x, approval must be escalated to a credit
manager."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v15:clause104:r4"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:15:104> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v15:clause96:r2> a cpi:PolicyRule ;
    rdfs:label "Mandatory DSCR for All Retail Borrowers" ;
    cpi:APPLIES_TO_SEGMENT <urn:cpi:customersegment:a6371301a04be284af4d> ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:24a661299ba3ba4cd0b5>,
        <urn:cpi:policyclass:ef181960a2e7ddb709f2> ;
    cpi:DERIVED_FROM <urn:cpi:source:15:96> ;
    cpi:PART_OF_VERSION <urn:cpi:version:15> ;
    cpi:requirement_text """The DSCR minimums defined herein are mandatory for all retail borrowers, regardless of their credit tier or
relationship with the bank."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v15:clause96:r2"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:15:96> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v15:clause96:r5> a cpi:PolicyRule ;
    rdfs:label "Regional or Product-Specific DSCR Adjustments Approval" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:24a661299ba3ba4cd0b5>,
        <urn:cpi:policyclass:9ec908f0bf2d80d3eebe> ;
    cpi:DERIVED_FROM <urn:cpi:source:15:96> ;
    cpi:PART_OF_VERSION <urn:cpi:version:15> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v15:clause96:r5:approval:0> ;
    cpi:requirement_text """However, regional or product-specific adjustments to DSCR minimums may be permitted with the approval of the Chief Risk
Officer (CRO) or their designated delegate."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v15:clause96:r5"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:15:96> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v15:clause98:r2> a cpi:PolicyRule ;
    rdfs:label "Underwriting Standards Team Implementation Governance" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:9ec908f0bf2d80d3eebe>,
        <urn:cpi:policyclass:ad98f77b21b765d56232> ;
    cpi:DERIVED_FROM <urn:cpi:source:15:98> ;
    cpi:PART_OF_VERSION <urn:cpi:version:15> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v15:clause98:r2:approval:0> ;
    cpi:requirement_text """The Underwriting Standards Team, a subcommittee of the RCRC, is tasked with the day-to-day implementation of this clause.
This team is responsible for developing underwriting guidelines, training materials, and tools to support the consistent
application of DSCR minimums. They also conduct periodic audits to verify adherence to the policy and address any identified
gaps or inconsistencies."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v15:clause98:r2"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:15:98> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v21:clause121:r3> a cpi:PolicyRule ;
    rdfs:label "Exclusion of Unsecured Lending" ;
    cpi:APPLIES_TO_PRODUCT <urn:cpi:product:274458e3276f8b37abbe>,
        <urn:cpi:product:9fc4852f833eaa134d63> ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:24a661299ba3ba4cd0b5> ;
    cpi:DERIVED_FROM <urn:cpi:source:21:121> ;
    cpi:PART_OF_VERSION <urn:cpi:version:21> ;
    cpi:requirement_text """This clause does not apply to unsecured lending products, such as credit cards or unsecured personal loans, as these do not
involve collateral."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v21:clause121:r3"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:21:121> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v21:clause125:r7> a cpi:PolicyRule ;
    rdfs:label "Reduced LTV Ceiling for Low Credit Score" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:ef181960a2e7ddb709f2>,
        <urn:cpi:policyclass:f675c4161d15d5396022> ;
    cpi:DERIVED_FROM <urn:cpi:source:21:125> ;
    cpi:HAS_CONDITION <urn:cpi:rule:v21:clause125:r7:logic:4c4e91ad08544ea0> ;
    cpi:PART_OF_VERSION <urn:cpi:version:21> ;
    cpi:requirement_text """For instance, a borrower with a credit score below 650 may be subject to a reduced LTV
ceiling, regardless of the collateral type."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v21:clause125:r7"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:21:125> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v37:clause179:r1> a cpi:PolicyRule ;
    rdfs:label "Prohibition of New Exposures to Restricted Sectors Without Committee Approval" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:51785e55a44e8ac3604c>,
        <urn:cpi:policyclass:9ec908f0bf2d80d3eebe> ;
    cpi:DERIVED_FROM <urn:cpi:source:37:179> ;
    cpi:PART_OF_VERSION <urn:cpi:version:37> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v37:clause179:r1:approval:0> ;
    cpi:requirement_text """The CRM department also identifies
sectors that are deemed ‘Restricted’ due to elevated risk levels, and no new exposures to these sectors are permitted without
explicit approval from the Credit Committee."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v37:clause179:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:37:179> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v47:clause220:r1> a cpi:PolicyRule ;
    rdfs:label "Parent Policy Annual Review Requirement" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:9ec908f0bf2d80d3eebe>,
        <urn:cpi:policyclass:ad98f77b21b765d56232> ;
    cpi:DERIVED_FROM <urn:cpi:source:47:220> ;
    cpi:PART_OF_VERSION <urn:cpi:version:47> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v47:clause220:r1:approval:0> ;
    cpi:requirement_text "The parent policy RAF-2026-v1.0, under which this Country Risk clause operates, is reviewed annually by the RMC."^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v47:clause220:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:47:220> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v47:clause220:r2> a cpi:PolicyRule ;
    rdfs:label "Material Policy Changes Board Approval Requirement" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:51785e55a44e8ac3604c>,
        <urn:cpi:policyclass:9ec908f0bf2d80d3eebe> ;
    cpi:DERIVED_FROM <urn:cpi:source:47:220> ;
    cpi:PART_OF_VERSION <urn:cpi:version:47> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v47:clause220:r2:approval:0> ;
    cpi:requirement_text """If the changes are material, such as
adjustments to the bank’s risk appetite or quantitative limits, they must be approved by the Board."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v47:clause220:r2"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:47:220> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v48:clause222:r2> a cpi:PolicyRule ;
    rdfs:label "Quarterly Review of Adjustments by Credit Risk Committee" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:9357aa360ca9e8840c5b>,
        <urn:cpi:policyclass:9ec908f0bf2d80d3eebe> ;
    cpi:DERIVED_FROM <urn:cpi:source:48:222> ;
    cpi:PART_OF_VERSION <urn:cpi:version:48> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v48:clause222:r2:approval:0> ;
    cpi:requirement_text """Such adjustments
must be documented in the Credit Policy Exception Log and reviewed quarterly by the Credit Risk Committee (CRC)."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v48:clause222:r2"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:48:222> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v48:clause224:r9> a cpi:PolicyRule ;
    rdfs:label "Standardized Template Deviation Approval Requirement" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:9357aa360ca9e8840c5b>,
        <urn:cpi:policyclass:9ec908f0bf2d80d3eebe> ;
    cpi:DERIVED_FROM <urn:cpi:source:48:224> ;
    cpi:PART_OF_VERSION <urn:cpi:version:48> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v48:clause224:r9:approval:0> ;
    cpi:requirement_text "Deviations from these templates require approval from the Head of Credit Analytics."^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v48:clause224:r9"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:48:224> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v48:clause232:r1> a cpi:PolicyRule ;
    rdfs:label "Approval Requirement for Coverage Ratio Below Minimum and Above Warning Level" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:9357aa360ca9e8840c5b>,
        <urn:cpi:policyclass:9ec908f0bf2d80d3eebe> ;
    cpi:DERIVED_FROM <urn:cpi:source:48:232> ;
    cpi:PART_OF_VERSION <urn:cpi:version:48> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v48:clause232:r1:approval:0> ;
    cpi:requirement_text """However, any application where a coverage ratio falls below the minimum threshold but remains
above the warning level must be escalated to the Head of Underwriting for approval."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v48:clause232:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:48:232> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v48:clause234:r1> a cpi:PolicyRule ;
    rdfs:label "Borrower Quarterly Financial Statement Submission Requirement" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:a05a0a4f8c8c7ff19a51>,
        <urn:cpi:policyclass:e9df5184319d3db58971> ;
    cpi:DERIVED_FROM <urn:cpi:source:48:234> ;
