    cpi:EVALUATES_RISK_ATTRIBUTE <urn:cpi:riskmetric:8a97dfb03e0af1b3eb73> ;
    cpi:HAS_THRESHOLD <urn:cpi:rule:v21:clause125:r1:threshold:0> ;
    cpi:PART_OF_VERSION <urn:cpi:version:21> ;
    cpi:USES_METRIC <urn:cpi:riskmetric:8a97dfb03e0af1b3eb73> ;
    cpi:requirement_text """For mortgage loans, the maximum LTV ceiling is set at 80% for conventional loans, 90% for loans insured by a government
agency (e.g., FHA, VA), and 70% for investment properties."""^^xsd:string ;
    cpi:rule_kind "QUANTITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v21:clause125:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:21:125> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

