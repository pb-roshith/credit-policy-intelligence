<urn:cpi:source:64:1036> a cpi:SourcePassage ;
    rdfs:label "Source clause 1036" ;
    cpi:SOURCE_IN_VERSION <urn:cpi:version:64> ;
    cpi:clause_reference "6"^^xsd:string ;
    cpi:document_reference "26"^^xsd:string ;
    cpi:origin "POLICY_SOURCE"^^xsd:string ;
