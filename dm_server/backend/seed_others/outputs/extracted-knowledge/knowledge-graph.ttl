    cpi:USES_METRIC <urn:cpi:riskmetric:5af29cff4d7e25f8e7df> ;
    cpi:requirement_text "A second trigger is activated when the CET1 capital ratio falls below 9.5%."^^xsd:string ;
    cpi:rule_kind "QUANTITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v58:clause432:r3"^^xsd:string ;
