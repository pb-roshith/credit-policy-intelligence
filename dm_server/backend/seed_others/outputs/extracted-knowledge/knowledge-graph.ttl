    cpi:sourceRef <urn:cpi:source:68:1543> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v68:clause1545:r1> a cpi:PolicyRule ;
    rdfs:label "Production Use Replacement of Synthetic Values" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:9ec908f0bf2d80d3eebe> ;
    cpi:DERIVED_FROM <urn:cpi:source:68:1545> ;
    cpi:PART_OF_VERSION <urn:cpi:version:68> ;
    cpi:requirement_text "Before production use, replace synthetic roles, formulas, criteria, thresholds, legal references and frequencies with approved values."^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v68:clause1545:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:68:1545> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v68:clause1545:r2> a cpi:PolicyRule ;
    rdfs:label "Policy Change Management Requirements" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:9ec908f0bf2d80d3eebe> ;
    cpi:DERIVED_FROM <urn:cpi:source:68:1545> ;
    cpi:PART_OF_VERSION <urn:cpi:version:68> ;
    cpi:requirement_text "Changes require impact assessment, approval, versioning, testing, communication and retrieval-index update."^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v68:clause1545:r2"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:68:1545> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v68:clause1545:r3> a cpi:PolicyRule ;
    rdfs:label "Prohibition on Retrieving Superseded Policy Versions as Current" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:a05a0a4f8c8c7ff19a51> ;
    cpi:DERIVED_FROM <urn:cpi:source:68:1545> ;
    cpi:PART_OF_VERSION <urn:cpi:version:68> ;
    cpi:requirement_text "Superseded versions remain auditable but shall not be retrieved as current."^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v68:clause1545:r3"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:68:1545> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v69:clause1547:r2> a cpi:PolicyRule ;
    rdfs:label "Mandatory Compliance with Credit Rating Standards" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:24a661299ba3ba4cd0b5> ;
    cpi:DERIVED_FROM <urn:cpi:source:69:1547> ;
    cpi:PART_OF_VERSION <urn:cpi:version:69> ;
    cpi:requirement_text """This policy applies to all business units, risk management teams, and personnel involved in the credit assessment process. It is
mandatory for underwriters, credit analysts, relationship managers, and senior management to comply with the provisions of
this document."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v69:clause1547:r2"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:69:1547> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v69:clause1549:r4> a cpi:PolicyRule ;
    rdfs:label "Exclusion of External Rating Agency Compliance Ratings" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:24a661299ba3ba4cd0b5> ;
    cpi:DERIVED_FROM <urn:cpi:source:69:1549> ;
    cpi:PART_OF_VERSION <urn:cpi:version:69> ;
    cpi:requirement_text """The policy also excludes credit ratings assigned by external credit rating agencies (e.g., Moody’s, S&P, Fitch) for the purpose of
regulatory compliance, where such ratings are used directly without internal override."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v69:clause1549:r4"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:69:1549> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v69:clause1551:r2> a cpi:PolicyRule ;
    rdfs:label "CRM Department Administrative Ownership" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:9ec908f0bf2d80d3eebe> ;
    cpi:DERIVED_FROM <urn:cpi:source:69:1551> ;
    cpi:PART_OF_VERSION <urn:cpi:version:69> ;
    cpi:requirement_text """The Credit Risk Management (CRM) department is the primary owner of this policy and is tasked with its day-to-day
administration. The CRM department is responsible for developing and maintaining the credit rating methodologies, tools, and
systems used by the bank. It also oversees the training of personnel involved in the rating process and ensures that all ratings
are assigned in accordance with the established criteria. The Head of CRM reports directly to the CRO and provides regular
updates on the performance and effectiveness of the rating standards."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v69:clause1551:r2"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:69:1551> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v69:clause1553:r1> a cpi:PolicyRule ;
    rdfs:label "Dual Approach Credit Rating Methodology" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:ef181960a2e7ddb709f2> ;
    cpi:DERIVED_FROM <urn:cpi:source:69:1553> ;
    cpi:PART_OF_VERSION <urn:cpi:version:69> ;
    cpi:requirement_text """The credit rating methodologies outlined in RAT-1.0 are designed to provide a systematic and objective framework for
assessing the creditworthiness of counterparties. The bank employs a dual approach, combining quantitative models and
qualitative assessments to ensure a comprehensive evaluation of credit risk. Quantitative models are used to analyze financial
metrics, while qualitative assessments consider factors such as management quality, industry dynamics, and macroeconomic
conditions."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v69:clause1553:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:69:1553> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v69:clause1561:r4:approval:0> a cpi:ApprovalRequirement ;
    rdfs:label "APPROVAL by Global Credit Committee" ;
    cpi:REQUIRES_APPROVAL_FROM <urn:cpi:approvalauthority:9d924c2a40ee3e6eb7a4> ;
    cpi:decision_type "APPROVAL"^^xsd:string ;
    cpi:notes "Global Credit Committee"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:69:1561> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v69:clause1561:r6> a cpi:PolicyRule ;
    rdfs:label "Multiple Approval Authority Seniority Rule" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:9ec908f0bf2d80d3eebe> ;
    cpi:DERIVED_FROM <urn:cpi:source:69:1561> ;
    cpi:PART_OF_VERSION <urn:cpi:version:69> ;
    cpi:requirement_text """In cases where a credit exposure requires approval from multiple authorities (e.g., due to its size, risk rating, or complexity), the
most senior authority’s approval is required."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v69:clause1561:r6"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:69:1561> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v69:clause1563:r1> a cpi:PolicyRule ;
    rdfs:label "Daily Automated Monitoring Framework" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:ad98f77b21b765d56232> ;
    cpi:DERIVED_FROM <urn:cpi:source:69:1563> ;
    cpi:PART_OF_VERSION <urn:cpi:version:69> ;
    cpi:requirement_text """All credit exposures are subject to automated monitoring on a daily basis, with the bank’s Risk Monitoring team tracking key
financial and non-financial indicators for signs of deterioration. These indicators include financial ratio trends, payment behavior,
credit rating changes, and adverse news events. Automated alerts are generated when predefined thresholds are breached,
such as a decline in the counterparty’s interest coverage ratio below 1.5x or a downgrade in its external credit rating."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v69:clause1563:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:69:1563> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v69:clause1565:r1> a cpi:PolicyRule ;
    rdfs:label "Exception Definition and Justification Requirement" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:acb66a8f8a7f374455cb> ;
    cpi:DERIVED_FROM <urn:cpi:source:69:1565> ;
    cpi:PART_OF_VERSION <urn:cpi:version:69> ;
    cpi:requirement_text """RAT-1.0 recognizes that there may be circumstances where strict adherence to the credit policy is not feasible or appropriate.
In such cases, the bank permits exceptions and waivers, provided they are properly justified, documented, and approved in
accordance with the framework outlined in this section. The exception handling process is designed to balance the need for
flexibility with the bank’s commitment to risk discipline and regulatory compliance."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v69:clause1565:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:69:1565> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v71:clause1607:r1> a cpi:PolicyRule ;
    rdfs:label "Policy Review Frequency" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:ad98f77b21b765d56232> ;
    cpi:DERIVED_FROM <urn:cpi:source:71:1607> ;
    cpi:PART_OF_VERSION <urn:cpi:version:71> ;
    cpi:requirement_text """The policy is reviewed at least annually, or more frequently if triggered by
material changes in the bank’s risk profile or external conditions."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v71:clause1607:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:71:1607> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v72:clause1609:r1> a cpi:PolicyRule ;
    rdfs:label "Policy Purpose and Objective" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:2d118e50d28316552944> ;
    cpi:DERIVED_FROM <urn:cpi:source:72:1609> ;
    cpi:PART_OF_VERSION <urn:cpi:version:72> ;
    cpi:requirement_text """1. 1. Purpose
The DUR-1.0 Credit Duration Risk Policy (hereinafter referred to as 'this Policy') establishes the framework for identifying,
assessing, mitigating, and monitoring duration risk within the Bank’s credit portfolio."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v72:clause1609:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:72:1609> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v72:clause1611:r1> a cpi:PolicyRule ;
    rdfs:label "General Policy Scope" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:24a661299ba3ba4cd0b5> ;
    cpi:DERIVED_FROM <urn:cpi:source:72:1611> ;
    cpi:PART_OF_VERSION <urn:cpi:version:72> ;
    cpi:requirement_text """2. 2. Scope
This Policy applies to all business units, subsidiaries, and legal entities within the Bank that engage in credit-related activities
with material duration risk exposure."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v72:clause1611:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:72:1611> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v72:clause1615:r1> a cpi:PolicyRule ;
    rdfs:label "Credit Application Duration Risk Assessment Requirement" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:ef181960a2e7ddb709f2> ;
    cpi:DERIVED_FROM <urn:cpi:source:72:1615> ;
    cpi:PART_OF_VERSION <urn:cpi:version:72> ;
    cpi:requirement_text """4. 4. Underwriting Criteria
Underwriting criteria for duration risk are designed to ensure that new credit exposures are consistent with the Bank’s risk
appetite and the limits established in this Policy. All credit applications must include a duration risk assessment, which
evaluates the potential impact of interest rate changes on the borrower’s ability to service debt and the Bank’s overall portfolio."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v72:clause1615:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:72:1615> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v73:clause1631:r3> a cpi:PolicyRule ;
    rdfs:label "Third-Party Service Provider Scope Extension" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:24a661299ba3ba4cd0b5> ;
    cpi:DERIVED_FROM <urn:cpi:source:73:1631> ;
    cpi:PART_OF_VERSION <urn:cpi:version:73> ;
    cpi:requirement_text """Third-party service providers
engaged in credit-related activities are also subject to the provisions of this Policy to the extent that their actions impact the
Bank’s liquidity profile."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v73:clause1631:r3"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:73:1631> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v73:clause1633:r1> a cpi:PolicyRule ;
    rdfs:label "Board and ALCO Governance and Oversight" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:9ec908f0bf2d80d3eebe> ;
    cpi:DERIVED_FROM <urn:cpi:source:73:1633> ;
    cpi:PART_OF_VERSION <urn:cpi:version:73> ;
    cpi:requirement_text """Ultimate responsibility for the Policy rests with the Board of
Directors (the 'Board'), which delegates operational oversight to ALCO."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v73:clause1633:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:73:1633> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v73:clause1633:r3> a cpi:PolicyRule ;
    rdfs:label "Internal Audit Annual Independent Review" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:ad98f77b21b765d56232> ;
    cpi:DERIVED_FROM <urn:cpi:source:73:1633> ;
    cpi:PART_OF_VERSION <urn:cpi:version:73> ;
    cpi:requirement_text "Internal Audit conducts independent reviews of the Policy’s effectiveness at least annually."^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v73:clause1633:r3"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:73:1633> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v73:clause1641:r2> a cpi:PolicyRule ;
    rdfs:label "Quarterly Portfolio Liquidity Stress Testing" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:ad98f77b21b765d56232> ;
    cpi:DERIVED_FROM <urn:cpi:source:73:1641> ;
    cpi:PART_OF_VERSION <urn:cpi:version:73> ;
    cpi:requirement_text """Stress tests are conducted at least quarterly, with the results reported to ALCO and the
Board."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v73:clause1641:r2"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:73:1641> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v73:clause1647:r4> a cpi:PolicyRule ;
    rdfs:label "CRM Implementation Self-Assessment" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:ad98f77b21b765d56232> ;
    cpi:DERIVED_FROM <urn:cpi:source:73:1647> ;
    cpi:PART_OF_VERSION <urn:cpi:version:73> ;
    cpi:requirement_text """CRM conducts a
self-assessment of the Policy’s implementation at least annually, focusing on the adequacy of controls, the accuracy of
reporting, and the compliance of business units with the Policy’s provisions."""^^xsd:string ;
