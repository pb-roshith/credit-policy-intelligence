    cpi:rule_kind "QUANTITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v15:clause102:r4"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:15:102> ;
    cpi:status "APPROVED" ;
