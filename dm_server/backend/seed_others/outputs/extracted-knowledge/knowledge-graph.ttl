<urn:cpi:source:65:1121> a cpi:SourcePassage ;
    rdfs:label "Source clause 1121" ;
    cpi:SOURCE_IN_VERSION <urn:cpi:version:65> ;
    cpi:clause_reference "3"^^xsd:string ;
    cpi:document_reference "27"^^xsd:string ;
    cpi:origin "POLICY_SOURCE"^^xsd:string ;
    cpi:source_checksum "359c75f36ef12c992d0cf594af32fa080c6fea79daf8f762749d051b578333c9"^^xsd:string ;
    cpi:status "APPROVED" ;
