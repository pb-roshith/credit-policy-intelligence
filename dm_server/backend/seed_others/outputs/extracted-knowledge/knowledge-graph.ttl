        <urn:cpi:policyclass:51785e55a44e8ac3604c> ;
    cpi:DERIVED_FROM <urn:cpi:source:58:432> ;
    cpi:EVALUATES_RISK_ATTRIBUTE <urn:cpi:riskmetric:5af29cff4d7e25f8e7df> ;
