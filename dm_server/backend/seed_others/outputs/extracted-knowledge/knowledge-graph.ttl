    rdfs:label "Tier 1 and Tier 2 Investment-Grade Financial Thresholds" ;
    cpi:APPLIES_TO_SEGMENT <urn:cpi:customersegment:6286169df196940d9f62>,
        <urn:cpi:customersegment:79b116a28eaa8c613d87> ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:7913e31ed423c0a8ac83>,
        <urn:cpi:policyclass:9cdad92394b23d28c4ac>,
        <urn:cpi:policyclass:ef181960a2e7ddb709f2> ;
    cpi:CONCERNS <urn:cpi:policyconcern:bd3f2db41963c5ad0767> ;
    cpi:DERIVED_FROM <urn:cpi:source:1:8> ;
    cpi:EVALUATES_RISK_ATTRIBUTE <urn:cpi:riskmetric:6117c1cba2f59be2e897>,
        <urn:cpi:riskmetric:d1b222d1e468ecab93d8> ;
