<urn:cpi:rule:v56:clause398:r2> a cpi:PolicyRule ;
    rdfs:label "BUCO Exception Approval Authority and Escalation Rule for Policy Breaches" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:9ec908f0bf2d80d3eebe>,
        <urn:cpi:policyclass:acb66a8f8a7f374455cb> ;
    cpi:DERIVED_FROM <urn:cpi:source:56:398> ;
    cpi:HAS_CONDITION <urn:cpi:rule:v56:clause398:r2:logic:739bc20999ba435a> ;
    cpi:PART_OF_VERSION <urn:cpi:version:56> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v56:clause398:r2:approval:0>,
        <urn:cpi:rule:v56:clause398:r2:approval:1> ;
    cpi:REQUIRES_APPROVAL_ON_BREACH <urn:cpi:rule:v56:clause398:r2:approval:1> ;
    cpi:requirement_text """Exception requests are reviewed by the Business Unit Credit Officer (BUCO), who assesses the merits of the case and the
adequacy of the proposed mitigants. The BUCO may approve exceptions for transactions within their delegated authority,
provided that the incremental risk is deemed acceptable and the mitigants are sufficient. However, exceptions that involve
policy breaches, such as waivers of standard covenants or underwriting criteria, must be escalated to the Regional Credit
Officer (RCO) for approval. The RCO may consult with the bank’s Risk Management Division (RMD) or Legal team to assess
the implications of the exception."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v56:clause398:r2"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:56:398> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v69:clause1556:r4> a cpi:PolicyRule ;
    rdfs:label "Credit File Retention Period Minimum" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:a05a0a4f8c8c7ff19a51>,
        <urn:cpi:policyclass:e9df5184319d3db58971> ;
    cpi:DERIVED_FROM <urn:cpi:source:69:1556> ;
    cpi:EVALUATES_RISK_ATTRIBUTE <urn:cpi:riskmetric:ce0746924190ffa47a00> ;
    cpi:HAS_THRESHOLD <urn:cpi:rule:v69:clause1556:r4:threshold:0> ;
    cpi:PART_OF_VERSION <urn:cpi:version:69> ;
    cpi:REQUIRES_EVIDENCE <urn:cpi:rule:v69:clause1556:r4:evidence:0> ;
    cpi:USES_METRIC <urn:cpi:riskmetric:ce0746924190ffa47a00> ;
    cpi:requirement_text """All evidence gathered during the underwriting process must be retained in the bank’s credit file system for a minimum of seven
years from the date of the last action on the credit facility."""^^xsd:string ;
    cpi:rule_kind "QUANTITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v69:clause1556:r4"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:69:1556> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v69:clause1558:r4> a cpi:PolicyRule ;
    rdfs:label "Single Industry Sector Exposure Limit" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:51785e55a44e8ac3604c>,
        <urn:cpi:policyclass:ae6a67c0bab119d96d75> ;
    cpi:CONCERNS <urn:cpi:policyconcern:4e1267273eec80a32991> ;
    cpi:DERIVED_FROM <urn:cpi:source:69:1558> ;
    cpi:EVALUATES_RISK_ATTRIBUTE <urn:cpi:riskmetric:d5b06272f74410bbed73> ;
    cpi:HAS_THRESHOLD <urn:cpi:rule:v69:clause1558:r4:threshold:0> ;
    cpi:PART_OF_VERSION <urn:cpi:version:69> ;
    cpi:USES_METRIC <urn:cpi:riskmetric:d5b06272f74410bbed73> ;
    cpi:requirement_text """The bank’s exposure to any one
industry sector may not exceed 20% of its total credit exposures. Sectors are defined using the Global Industry Classification
Standard (GICS), and exposures are aggregated at the two-digit GICS level."""^^xsd:string ;
    cpi:rule_kind "QUANTITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v69:clause1558:r4"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:69:1558> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

