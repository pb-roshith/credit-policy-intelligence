    cpi:HAS_THRESHOLD <urn:cpi:rule:v1:clause8:r2:threshold:0> ;
    cpi:PART_OF_VERSION <urn:cpi:version:1> ;
    cpi:USES_METRIC <urn:cpi:riskmetric:bec522dd4e3f62244cb0> ;
    cpi:requirement_text "accounts receivable are typically valued at 80% of their face value"^^xsd:string ;
    cpi:rule_kind "QUANTITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v1:clause8:r2"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:1:8> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v21:clause125:r1> a cpi:PolicyRule ;
    rdfs:label "Conventional Mortgage Maximum LTV Ceiling" ;
    cpi:APPLIES_TO_PRODUCT <urn:cpi:product:1cc4cb067f533cd6a2d5> ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:51785e55a44e8ac3604c>,
        <urn:cpi:policyclass:fc966078f763f57e4193> ;
    cpi:CONCERNS <urn:cpi:policyconcern:a0148a51d610b28abff8> ;
