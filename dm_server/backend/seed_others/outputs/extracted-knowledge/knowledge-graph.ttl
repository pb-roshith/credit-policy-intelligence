<urn:cpi:rule:v13:clause55:r1> a cpi:PolicyRule ;
    rdfs:label "Wholesale Banking Tenor Limits Scope" ;
    cpi:APPLIES_TO_SEGMENT <urn:cpi:customersegment:876ee5ec77452d5014e5>,
        <urn:cpi:customersegment:c07e778f63017a1d3244>,
        <urn:cpi:customersegment:e15802ef8f437279d0ea> ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:24a661299ba3ba4cd0b5> ;
    cpi:DERIVED_FROM <urn:cpi:source:13:55> ;
    cpi:PART_OF_VERSION <urn:cpi:version:13> ;
    cpi:requirement_text """Clause 4.3 Tenor Limits applies to all wholesale banking activities conducted by the bank, including its domestic and
international operations. The scope of this clause encompasses all credit facilities extended to corporate clients, financial
institutions, and other wholesale counterparties, regardless of the jurisdiction or currency of the transaction."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v13:clause55:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:13:55> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v13:clause55:r3> a cpi:PolicyRule ;
    rdfs:label "Scope Exclusions for Retail Consumer and Card Facilities" ;
    cpi:APPLIES_TO_PRODUCT <urn:cpi:product:879842508f039e3c48b3>,
        <urn:cpi:product:9fc4852f833eaa134d63>,
        <urn:cpi:product:a8732ff795f8124ad702> ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:24a661299ba3ba4cd0b5> ;
    cpi:DERIVED_FROM <urn:cpi:source:13:55> ;
    cpi:PART_OF_VERSION <urn:cpi:version:13> ;
    cpi:requirement_text """Exclusions from this policy include retail banking products, consumer lending, and credit card facilities, which are governed by
separate policies tailored to their unique risk profiles."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v13:clause55:r3"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:13:55> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v13:clause59:r1> a cpi:PolicyRule ;
    rdfs:label "Underwriter Debt Service Stress Testing Requirement" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:710d37ea2613a714b46c>,
        <urn:cpi:policyclass:a05a0a4f8c8c7ff19a51>,
        <urn:cpi:policyclass:ef181960a2e7ddb709f2> ;
    cpi:DERIVED_FROM <urn:cpi:source:13:59> ;
    cpi:PART_OF_VERSION <urn:cpi:version:13> ;
    cpi:REQUIRES_EVIDENCE <urn:cpi:rule:v13:clause59:r1:evidence:0> ;
    cpi:requirement_text """Underwriters are required to conduct a thorough analysis of the borrower’s ability to service debt over the proposed tenor. This
analysis includes stress testing the borrower’s financials under various scenarios, such as economic downturns,
industry-specific shocks, and changes in interest rates. The results of these stress tests must be documented in the credit
proposal and reviewed by CRM."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v13:clause59:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:13:59> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v1:clause4:r2> a cpi:PolicyRule ;
    rdfs:label "Global Credit Policy Committee Exemption Authority" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:9ec908f0bf2d80d3eebe>,
        <urn:cpi:policyclass:acb66a8f8a7f374455cb> ;
    cpi:DERIVED_FROM <urn:cpi:source:1:4> ;
    cpi:PART_OF_VERSION <urn:cpi:version:1> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v1:clause4:r2:approval:0> ;
    cpi:REQUIRES_EVIDENCE <urn:cpi:rule:v1:clause4:r2:evidence:0> ;
    cpi:requirement_text """The clause applies to all business lines and geographic regions where the bank operates, unless explicitly exempted by the
Global Credit Policy Committee."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v1:clause4:r2"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:1:4> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v21:clause131:r1> a cpi:PolicyRule ;
    rdfs:label "Monthly Pre-Funding Monitoring Sample Requirement" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:ad98f77b21b765d56232> ;
    cpi:DERIVED_FROM <urn:cpi:source:21:131> ;
    cpi:EVALUATES_RISK_ATTRIBUTE <urn:cpi:riskmetric:cf62bdecb19eab35fbae> ;
    cpi:HAS_THRESHOLD <urn:cpi:rule:v21:clause131:r1:threshold:0> ;
    cpi:PART_OF_VERSION <urn:cpi:version:21> ;
    cpi:USES_METRIC <urn:cpi:riskmetric:cf62bdecb19eab35fbae> ;
    cpi:requirement_text """This review is conducted on a monthly basis and covers at least 10% of all
loan applications."""^^xsd:string ;
    cpi:rule_kind "QUANTITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v21:clause131:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:21:131> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v21:clause133:r1> a cpi:PolicyRule ;
    rdfs:label "Compensating Factors for LTV Exceptions" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:acb66a8f8a7f374455cb>,
        <urn:cpi:policyclass:f47f1f14ecf0186aeb10>,
        <urn:cpi:policyclass:f675c4161d15d5396022> ;
    cpi:DERIVED_FROM <urn:cpi:source:21:133> ;
    cpi:HAS_CONDITION <urn:cpi:rule:v21:clause133:r1:logic:0424163a1c4daeb3> ;
    cpi:PART_OF_VERSION <urn:cpi:version:21> ;
    cpi:requirement_text """Compensating factors may include a high credit score (e.g., above 750), a low DTI ratio (e.g., below 30%), stable
employment history, or additional collateral."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v21:clause133:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:21:133> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v29:clause164:r2> a cpi:PolicyRule ;
    rdfs:label "Policy Amendment Approval by CPC and Board Risk Committee" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:9ec908f0bf2d80d3eebe>,
        <urn:cpi:policyclass:acb66a8f8a7f374455cb> ;
    cpi:DERIVED_FROM <urn:cpi:source:29:164> ;
    cpi:PART_OF_VERSION <urn:cpi:version:29> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v29:clause164:r2:approval:0>,
        <urn:cpi:rule:v29:clause164:r2:approval:1> ;
    cpi:requirement_text "All amendments to the policy must be approved by the CPC and, where required, the Board Risk Committee."^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v29:clause164:r2"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:29:164> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v37:clause183:r1> a cpi:PolicyRule ;
    rdfs:label "Escalation for Projected Exposure Exceeding Limits" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:51785e55a44e8ac3604c>,
        <urn:cpi:policyclass:9ec908f0bf2d80d3eebe> ;
    cpi:DERIVED_FROM <urn:cpi:source:37:183> ;
    cpi:PART_OF_VERSION <urn:cpi:version:37> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v37:clause183:r1:approval:0> ;
    cpi:REQUIRES_APPROVAL_ON_BREACH <urn:cpi:rule:v37:clause183:r1:approval:0> ;
    cpi:requirement_text """If the projected exposure to any sector, industry, or sub-industry exceeds the applicable limit (SEL, IEL, or SIEL), the application
must be escalated to the CRM department for further review."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v37:clause183:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:37:183> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v37:clause183:r2> a cpi:PolicyRule ;
    rdfs:label "Credit Committee Approval for Restricted Sector Applications" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:9ec908f0bf2d80d3eebe>,
        <urn:cpi:policyclass:a05a0a4f8c8c7ff19a51> ;
    cpi:DERIVED_FROM <urn:cpi:source:37:183> ;
    cpi:PART_OF_VERSION <urn:cpi:version:37> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v37:clause183:r2:approval:0> ;
    cpi:REQUIRES_EVIDENCE <urn:cpi:rule:v37:clause183:r2:evidence:0> ;
    cpi:requirement_text """In cases where the borrower operates in a sector classified as ‘Restricted’ under the Policy, the application must be
accompanied by a detailed justification explaining why the exposure is necessary and how the associated risks will be
managed. Such applications require approval from the Credit Committee, regardless of the size of the exposure."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v37:clause183:r2"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:37:183> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v37:clause185:r3> a cpi:PolicyRule ;
    rdfs:label "Major Breach and Restricted Sector Board Approval" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:9ec908f0bf2d80d3eebe>,
        <urn:cpi:policyclass:acb66a8f8a7f374455cb> ;
    cpi:DERIVED_FROM <urn:cpi:source:37:185> ;
    cpi:PART_OF_VERSION <urn:cpi:version:37> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v37:clause185:r3:approval:0> ;
    cpi:REQUIRES_APPROVAL_ON_BREACH <urn:cpi:rule:v37:clause185:r3:approval:0> ;
    cpi:requirement_text """Major breaches, where exposure exceeds the limit by more than 10%, or any request for an exception to the Policy for a
‘Restricted’ sector, must be escalated to the Board for approval."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v37:clause185:r3"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:37:185> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v37:clause189:r1> a cpi:PolicyRule ;
    rdfs:label "Maximum Exception Validity Period" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:acb66a8f8a7f374455cb> ;
    cpi:DERIVED_FROM <urn:cpi:source:37:189> ;
    cpi:EVALUATES_RISK_ATTRIBUTE <urn:cpi:riskmetric:fe762577ff5e2c307caa> ;
    cpi:HAS_THRESHOLD <urn:cpi:rule:v37:clause189:r1:threshold:0> ;
    cpi:PART_OF_VERSION <urn:cpi:version:37> ;
    cpi:USES_METRIC <urn:cpi:riskmetric:fe762577ff5e2c307caa> ;
    cpi:requirement_text """Exceptions are typically granted for a maximum period of 12 months, after
which they must be reviewed and re-approved if still required."""^^xsd:string ;
    cpi:rule_kind "QUANTITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v37:clause189:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:37:189> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v48:clause222:r1> a cpi:PolicyRule ;
    rdfs:label "Mandatory Financial Statement Requirement for Ratio Calculations" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:a05a0a4f8c8c7ff19a51>,
        <urn:cpi:policyclass:e9df5184319d3db58971> ;
    cpi:DERIVED_FROM <urn:cpi:source:48:222> ;
    cpi:PART_OF_VERSION <urn:cpi:version:48> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v48:clause222:r1:approval:0> ;
    cpi:REQUIRES_EVIDENCE <urn:cpi:rule:v48:clause222:r1:evidence:0> ;
    cpi:requirement_text """To maintain the integrity of the credit process, this policy mandates the use of audited or certified financial statements for ratio
calculations, unless otherwise approved by the Chief Credit Officer (CCO)."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v48:clause222:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:48:222> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v48:clause224:r8> a cpi:PolicyRule ;
    rdfs:label "Independent Valuation of Collateral Frequency" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:7400994ea0b297e87025>,
        <urn:cpi:policyclass:ebcd620636c948c2d6c5> ;
    cpi:CONCERNS <urn:cpi:policyconcern:a0148a51d610b28abff8> ;
    cpi:DERIVED_FROM <urn:cpi:source:48:224> ;
    cpi:PART_OF_VERSION <urn:cpi:version:48> ;
    cpi:REQUIRES_EVIDENCE <urn:cpi:rule:v48:clause224:r8:evidence:0> ;
    cpi:requirement_text """The policy requires independent
valuation of collateral at least annually, with more frequent assessments triggered by material changes in market conditions or
borrower financial performance."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v48:clause224:r8"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:48:224> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

