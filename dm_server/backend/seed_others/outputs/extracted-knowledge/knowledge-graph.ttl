    cpi:HAS_THRESHOLD <urn:cpi:rule:v51:clause297:r1:threshold:0> ;
    cpi:PART_OF_VERSION <urn:cpi:version:51> ;
    cpi:USES_METRIC <urn:cpi:riskmetric:6f493da7c856822ab8c7> ;
    cpi:requirement_text """Exceptions are categorized as either temporary or permanent,
with temporary exceptions granted for a maximum period of 12 months, subject to renewal."""^^xsd:string ;
    cpi:rule_kind "QUANTITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v51:clause297:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:51:297> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

