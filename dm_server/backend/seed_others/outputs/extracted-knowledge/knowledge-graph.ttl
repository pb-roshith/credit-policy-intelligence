    cpi:requirement_text "Retain policy version, clauses, inputs, source locations, calculations, transformations, system and user actions, timestamps, model version, human review, final decision, authority, exceptions and changes under approved access and retention controls."^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v59:clause529:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:59:529> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

