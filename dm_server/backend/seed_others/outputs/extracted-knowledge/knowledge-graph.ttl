<urn:cpi:source:37:176> a cpi:SourcePassage ;
    rdfs:label "Source clause 176" ;
    cpi:SOURCE_IN_VERSION <urn:cpi:version:37> ;
    cpi:clause_reference "RAF-2026"^^xsd:string ;
    cpi:document_reference "8"^^xsd:string ;
