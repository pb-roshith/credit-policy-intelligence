    cpi:sourceRef <urn:cpi:source:54:349> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v54:clause351:r10> a cpi:PolicyRule ;
    rdfs:label "Maximum Construction Loan Term Limit" ;
