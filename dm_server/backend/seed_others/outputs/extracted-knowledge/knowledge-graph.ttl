    cpi:USES_METRIC <urn:cpi:riskmetric:8634d69f3e694113e876> ;
    cpi:requirement_text """The maximum term for a construction loan is 36 months,
with an option to extend for an additional 12 months subject to CLC approval."""^^xsd:string ;
    cpi:rule_kind "QUANTITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v54:clause351:r10"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:54:351> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v56:clause383:r1> a cpi:PolicyRule ;
    rdfs:label "Policy Purpose and Applicability" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:24a661299ba3ba4cd0b5>,
        <urn:cpi:policyclass:2d118e50d28316552944>,
        <urn:cpi:policyclass:9ec908f0bf2d80d3eebe> ;
    cpi:DERIVED_FROM <urn:cpi:source:56:383> ;
    cpi:PART_OF_VERSION <urn:cpi:version:56> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v56:clause383:r1:approval:0>,
        <urn:cpi:rule:v56:clause383:r1:approval:1> ;
    cpi:requirement_text """This document, titled 'Clause 3.2: Escalation Rules,' is a synthetic demonstration policy derived from the parent framework
DEL-v3.3. It establishes the escalation protocols for credit-related decisions within the bank, ensuring that risks are managed
hierarchically and that no single point of failure exists in the approval or review process. The purpose of this clause is to define
clear, actionable pathways for escalating credit decisions that exceed predefined thresholds, involve high-risk counterparties, or
require exceptions to standard underwriting criteria.
The policy applies universally across all business units, subsidiaries, and geographic regions where the bank operates. It
governs the escalation of credit applications, limit increases, risk grade downgrades, and any deviations from established credit
policies. By standardizing escalation procedures, the bank aims to enhance transparency, accountability, and the consistency
of decision-making, while mitigating operational, financial, and reputational risks.
All employees, contractors, and third-party agents involved in credit origination, underwriting, monitoring, or risk management
are required to adhere to these escalation rules. Compliance with this policy is mandatory, and failure to escalate as prescribed
may result in disciplinary action, up to and including termination of employment or contractual relationships. The policy is
designed to complement, not replace, existing governance frameworks such as the bank’s Enterprise Risk Management Policy
and the Credit Risk Appetite Statement.
The synthetic nature of this document is emphasized to clarify that it is intended for demonstration, training, and system testing
purposes only. While the thresholds, roles, and processes described herein are realistic and internally consistent, they do not
reflect the actual credit policies of any real financial institution. Users of this document must treat it as illustrative content and
not as a binding operational directive.
This clause is effective immediately upon issuance and remains in force until superseded by a revised version or explicitly
withdrawn by the Chief Credit Officer (CCO). Any updates or amendments to this policy will be communicated through official
bank channels and will require approval from the Credit Policy Committee (CPC). The CCO retains the authority to interpret this
policy and resolve any ambiguities that may arise during its implementation."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v56:clause383:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:56:383> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v56:clause385:r3> a cpi:PolicyRule ;
    rdfs:label "Mandatory Escalation for New Counterparties in High-Risk Jurisdictions" ;
    cpi:APPLIES_IN <urn:cpi:geography:8c34dec8f9b598d67075> ;
    cpi:APPLIES_TO_SEGMENT <urn:cpi:customersegment:c3c4606e4c366990b64c> ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:24a661299ba3ba4cd0b5>,
        <urn:cpi:policyclass:29c939e919a29dfc93ce> ;
    cpi:DERIVED_FROM <urn:cpi:source:56:385> ;
    cpi:HAS_CONDITION <urn:cpi:rule:v56:clause385:r3:logic:0c826ea0f5e4fad8> ;
    cpi:PART_OF_VERSION <urn:cpi:version:56> ;
    cpi:requirement_text """Additionally, any transaction involving a
new counterparty in a high-risk jurisdiction, as defined by the bank’s Anti-Money Laundering (AML) policy, must be escalated
regardless of size."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v56:clause385:r3"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:56:385> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v56:clause389:r4> a cpi:PolicyRule ;
    rdfs:label "Minimum DSCR Underwriting Threshold" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:51785e55a44e8ac3604c>,
        <urn:cpi:policyclass:8c4767711b32877b5b4e> ;
    cpi:DERIVED_FROM <urn:cpi:source:56:389> ;
    cpi:EVALUATES_RISK_ATTRIBUTE <urn:cpi:riskmetric:52fed51ef401d0513394> ;
    cpi:HAS_THRESHOLD <urn:cpi:rule:v56:clause389:r4:threshold:0> ;
    cpi:PART_OF_VERSION <urn:cpi:version:56> ;
    cpi:USES_METRIC <urn:cpi:riskmetric:52fed51ef401d0513394> ;
    cpi:requirement_text "These include debt service coverage ratios (DSCR) below 1.25x,"^^xsd:string ;
    cpi:rule_kind "QUANTITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v56:clause389:r4"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:56:389> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v56:clause389:r5> a cpi:PolicyRule ;
    rdfs:label "Maximum Leverage Ratio Underwriting Threshold" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:51785e55a44e8ac3604c>,
        <urn:cpi:policyclass:9cdad92394b23d28c4ac> ;
    cpi:DERIVED_FROM <urn:cpi:source:56:389> ;
    cpi:EVALUATES_RISK_ATTRIBUTE <urn:cpi:riskmetric:90552734fc79bc2bfc7f> ;
    cpi:HAS_THRESHOLD <urn:cpi:rule:v56:clause389:r5:threshold:0> ;
    cpi:PART_OF_VERSION <urn:cpi:version:56> ;
    cpi:USES_METRIC <urn:cpi:riskmetric:90552734fc79bc2bfc7f> ;
    cpi:requirement_text "leverage ratios (total debt to EBITDA) above 4.0x,"^^xsd:string ;
    cpi:rule_kind "QUANTITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v56:clause389:r5"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:56:389> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v56:clause392:r7> a cpi:PolicyRule ;
    rdfs:label "Corporate Minimum Current Ratio Threshold" ;
    cpi:APPLIES_TO_SEGMENT <urn:cpi:customersegment:c07e778f63017a1d3244> ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:51785e55a44e8ac3604c> ;
    cpi:DERIVED_FROM <urn:cpi:source:56:392> ;
    cpi:EVALUATES_RISK_ATTRIBUTE <urn:cpi:riskmetric:e5e3b898a943636e6145> ;
    cpi:HAS_THRESHOLD <urn:cpi:rule:v56:clause392:r7:threshold:0> ;
