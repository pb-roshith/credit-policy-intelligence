    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v68:clause1533:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:68:1533> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

