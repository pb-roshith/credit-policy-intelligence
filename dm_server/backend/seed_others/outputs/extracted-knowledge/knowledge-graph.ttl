    cpi:requirement_text """This clause applies to all retail credit products originated, renewed, or refinanced under the parent policy CP-Retail-v3.1. It
encompasses unsecured and secured lending, including but not limited to personal loans, auto loans, credit cards, and home
equity lines of credit."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
