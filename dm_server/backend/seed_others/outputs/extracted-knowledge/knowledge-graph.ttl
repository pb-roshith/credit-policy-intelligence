    cpi:requirement_text """All inputs used to populate the Spread Grid must be supported by verifiable evidence, such as audited financial statements,
third-party valuations, or internal risk assessments."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v52:clause309:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:52:309> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v52:clause311:r12> a cpi:PolicyRule ;
    rdfs:label "Currency Risk Spread Adjustment" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:51785e55a44e8ac3604c>,
        <urn:cpi:policyclass:53662c5d21f4c1fa8c63> ;
    cpi:DERIVED_FROM <urn:cpi:source:52:311> ;
    cpi:EVALUATES_RISK_ATTRIBUTE <urn:cpi:riskmetric:9d47d1bdac2959195b5e> ;
    cpi:HAS_THRESHOLD <urn:cpi:rule:v52:clause311:r12:threshold:0> ;
    cpi:PART_OF_VERSION <urn:cpi:version:52> ;
    cpi:USES_METRIC <urn:cpi:riskmetric:9d47d1bdac2959195b5e> ;
    cpi:requirement_text """Exposures denominated in currencies with high volatility or
limited liquidity (e.g., emerging market currencies) may receive an additional spread adjustment of up to 50 bps."""^^xsd:string ;
    cpi:rule_kind "QUANTITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v52:clause311:r12"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:52:311> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v54:clause349:r11> a cpi:PolicyRule ;
    rdfs:label "Maximum Land Valuation Limit for Equity Contribution" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:7400994ea0b297e87025>,
