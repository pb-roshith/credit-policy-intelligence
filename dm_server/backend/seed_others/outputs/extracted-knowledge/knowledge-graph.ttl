<urn:cpi:rule:v13:clause55:r5> a cpi:PolicyRule ;
    rdfs:label "Scope Exception Documentation and CRO Approval Requirement" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:9ec908f0bf2d80d3eebe>,
        <urn:cpi:policyclass:acb66a8f8a7f374455cb> ;
    cpi:DERIVED_FROM <urn:cpi:source:13:55> ;
    cpi:PART_OF_VERSION <urn:cpi:version:13> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v13:clause55:r5:approval:0> ;
    cpi:requirement_text """All exceptions to the scope of this policy must be documented and approved by the Chief Risk Officer (CRO) or their designated
delegate."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v13:clause55:r5"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:13:55> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v13:clause57:r1> a cpi:PolicyRule ;
    rdfs:label "Tenor Limits Oversight Responsibility" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:710d37ea2613a714b46c>,
        <urn:cpi:policyclass:9ec908f0bf2d80d3eebe> ;
    cpi:DERIVED_FROM <urn:cpi:source:13:57> ;
    cpi:PART_OF_VERSION <urn:cpi:version:13> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v13:clause57:r1:approval:0> ;
    cpi:requirement_text """Oversight of this clause rests with the Group Credit Committee (GCC), which is
responsible for approving any changes to the tenor limits and ensuring their alignment with the bank’s overall risk appetite."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v13:clause57:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:13:57> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v13:clause63:r1> a cpi:PolicyRule ;
    rdfs:label "Standard Credit Facility Approval Authority" ;
    cpi:APPLIES_TO_PRODUCT <urn:cpi:product:724f781465305b8aa229> ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:9ec908f0bf2d80d3eebe> ;
    cpi:DERIVED_FROM <urn:cpi:source:13:63> ;
    cpi:PART_OF_VERSION <urn:cpi:version:13> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v13:clause63:r1:approval:0> ;
    cpi:requirement_text """For standard credit facilities that comply with the tenor limits outlined in this clause, approval authority rests with the Business
Unit Head, provided that the facility size does not exceed the unit’s delegated authority."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v13:clause63:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:13:63> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v13:clause65:r3> a cpi:PolicyRule ;
    rdfs:label "Maturity Review Timeline Requirement" ;
    cpi:APPLIES_TO_PRODUCT <urn:cpi:product:f3632fb76df7e3870618> ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:710d37ea2613a714b46c>,
        <urn:cpi:policyclass:ad98f77b21b765d56232> ;
    cpi:DERIVED_FROM <urn:cpi:source:13:65> ;
    cpi:PART_OF_VERSION <urn:cpi:version:13> ;
    cpi:requirement_text """Any facilities approaching their maturity date must be reviewed at least 12
months in advance to determine whether they should be renewed, restructured, or allowed to mature."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v13:clause65:r3"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:13:65> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

