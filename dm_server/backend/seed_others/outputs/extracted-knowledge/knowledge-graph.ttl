<urn:cpi:rule:v69:clause1549:r2> a cpi:PolicyRule ;
    rdfs:label "Obligation to Assign Credit Rating to All Exposures" ;
    cpi:APPLIES_TO_PRODUCT <urn:cpi:product:1e9e47a9297c3a171556>,
        <urn:cpi:product:4d2244f6aecb8daf0152>,
        <urn:cpi:product:604f9de4e0d7c46a8f05> ;
    cpi:APPLIES_TO_SEGMENT <urn:cpi:customersegment:359cd88821fce67a193c>,
        <urn:cpi:customersegment:c07e778f63017a1d3244>,
        <urn:cpi:customersegment:c85c5aaa55c833147892>,
        <urn:cpi:customersegment:c9fc184816b43b9b9601>,
        <urn:cpi:customersegment:e15802ef8f437279d0ea> ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:24a661299ba3ba4cd0b5>,
        <urn:cpi:policyclass:ef181960a2e7ddb709f2> ;
    cpi:DERIVED_FROM <urn:cpi:source:69:1549> ;
    cpi:PART_OF_VERSION <urn:cpi:version:69> ;
    cpi:requirement_text """All credit exposures, regardless of size or complexity, fall within the scope of this policy. This includes exposures to corporate
entities, small and medium-sized enterprises (SMEs), retail customers, financial institutions, and sovereign entities. The policy
also covers specialized lending areas such as project finance, leveraged finance, and structured credit products. Each
exposure must be assigned a credit rating in accordance with the methodologies outlined in this document."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v69:clause1549:r2"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:69:1549> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

