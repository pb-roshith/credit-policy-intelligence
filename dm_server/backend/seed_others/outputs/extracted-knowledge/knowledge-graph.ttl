<urn:cpi:rule:v70:clause1585:r2> a cpi:PolicyRule ;
    rdfs:label "Tier 1 and Tier 2 Exception Approval Requirement" ;
    cpi:APPLIES_TO_INDUSTRY_TIER <urn:cpi:industrytier:716d2afeadae59567f7b>,
        <urn:cpi:industrytier:ab95a5707693bff1307f> ;
    cpi:APPLIES_TO_SEGMENT <urn:cpi:customersegment:d36a94e3891c5a5ad200> ;
