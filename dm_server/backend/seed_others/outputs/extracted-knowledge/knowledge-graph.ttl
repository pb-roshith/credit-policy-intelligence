    cpi:CONCERNS <urn:cpi:policyconcern:4e1267273eec80a32991> ;
    cpi:DERIVED_FROM <urn:cpi:source:72:1617> ;
    cpi:EVALUATES_RISK_ATTRIBUTE <urn:cpi:riskmetric:6e65813c6288bc28aec1> ;
    cpi:HAS_CONDITION <urn:cpi:rule:v72:clause1617:r5:logic:334d3b5e1c47a0fa> ;
    cpi:HAS_THRESHOLD <urn:cpi:rule:v72:clause1617:r5:threshold:0> ;
    cpi:PART_OF_VERSION <urn:cpi:version:72> ;
    cpi:USES_METRIC <urn:cpi:riskmetric:6e65813c6288bc28aec1> ;
    cpi:requirement_text """Similarly, the Bank’s exposure to any single borrower with a duration of greater than 7 years may not exceed 5% of the Bank’s
Tier 1 capital."""^^xsd:string ;
    cpi:rule_kind "QUANTITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v72:clause1617:r5"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:72:1617> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

