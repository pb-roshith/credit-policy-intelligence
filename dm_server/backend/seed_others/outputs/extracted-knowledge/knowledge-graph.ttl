    cpi:PART_OF_VERSION <urn:cpi:version:13> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v13:clause55:r4:approval:0> ;
    cpi:requirement_text """Additionally, intra-group transactions and exposures to sovereign entities
may be subject to customized tenor limits as approved by the Group Risk Committee."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v13:clause55:r4"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:13:55> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v13:clause59:r4> a cpi:PolicyRule ;
    rdfs:label "Project Finance Facility Maximum Tenor" ;
    cpi:APPLIES_TO_PRODUCT <urn:cpi:product:1e9e47a9297c3a171556> ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:51785e55a44e8ac3604c>,
