<urn:cpi:rule:v68:clause1540:r1> a cpi:PolicyRule ;
    rdfs:label "Suggested Training Prompt for Finding Classification" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:d9fec564d2da12d10ad5> ;
    cpi:DERIVED_FROM <urn:cpi:source:68:1540> ;
    cpi:PART_OF_VERSION <urn:cpi:version:68> ;
    cpi:requirement_text "Identify compliant, non-compliant, conditional and unresolved findings."^^xsd:string ;
