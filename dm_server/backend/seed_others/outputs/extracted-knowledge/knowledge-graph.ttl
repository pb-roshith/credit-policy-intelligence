<urn:cpi:rule:v56:clause396:r1> a cpi:PolicyRule ;
    rdfs:label "CMS Real-Time Monitoring and Alert Routing" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:ad98f77b21b765d56232> ;
    cpi:DERIVED_FROM <urn:cpi:source:56:396> ;
    cpi:PART_OF_VERSION <urn:cpi:version:56> ;
    cpi:requirement_text """The bank’s Credit Management System (CMS) includes a real-time monitoring module that tracks key credit metrics for all
counterparties, including financial ratios, risk ratings, covenant compliance, and exposure levels. The system generates
automated alerts when predefined thresholds are breached, such as a decline in a borrower’s risk rating, a breach of financial
covenants, or an increase in exposure beyond approved limits. These alerts are routed to the relevant Relationship Manager
and their supervisor, with escalation to higher authorities if the issue is not resolved within the stipulated timeframe."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v56:clause396:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:56:396> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v56:clause398:r2:approval:1> a cpi:ApprovalRequirement ;
    rdfs:label "APPROVAL by Regional Credit Officer" ;
    cpi:REQUIRES_APPROVAL_FROM <urn:cpi:approvalauthority:b975a70e8d27258a3605> ;
    cpi:decision_type "APPROVAL"^^xsd:string ;
    cpi:notes """escalated to the Regional Credit
Officer (RCO) for approval"""^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:56:398> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v56:clause400:r1> a cpi:PolicyRule ;
    rdfs:label "Mandatory CMS Documentation for Escalations, Approvals, and Exceptions" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:a05a0a4f8c8c7ff19a51> ;
    cpi:DERIVED_FROM <urn:cpi:source:56:400> ;
    cpi:PART_OF_VERSION <urn:cpi:version:56> ;
    cpi:requirement_text """All escalations, approvals, and exceptions must be documented in the bank’s Credit Management System (CMS) at the time
they occur."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v56:clause400:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:56:400> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v57:clause422:r3> a cpi:PolicyRule ;
    rdfs:label "Documentation of Policy Amendments in Central Repository Change Log" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:a05a0a4f8c8c7ff19a51> ;
    cpi:DERIVED_FROM <urn:cpi:source:57:422> ;
    cpi:PART_OF_VERSION <urn:cpi:version:57> ;
    cpi:requirement_text """The policy requires that all amendments be documented in a change log, which is
maintained in the bank’s central repository and includes a summary of the changes, the rationale for the amendments, and the
approval date."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v57:clause422:r3"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:57:422> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v58:clause424:r1> a cpi:PolicyRule ;
    rdfs:label "Capital Floors Policy Purpose" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:2d118e50d28316552944> ;
    cpi:DERIVED_FROM <urn:cpi:source:58:424> ;
    cpi:PART_OF_VERSION <urn:cpi:version:58> ;
    cpi:requirement_text """The purpose of this Capital Floors Policy (the 'Policy') is to establish a robust framework for the implementation, monitoring, and
enforcement of capital floor requirements in accordance with the Basel IV regulatory standards."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v58:clause424:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:58:424> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v58:clause430:r1> a cpi:PolicyRule ;
    rdfs:label "IRB Parameter Validation Requirement" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:ad98f77b21b765d56232> ;
    cpi:DERIVED_FROM <urn:cpi:source:58:430> ;
    cpi:PART_OF_VERSION <urn:cpi:version:58> ;
    cpi:requirement_text """The PD, LGD, and EAD estimates must be validated annually by an independent party, such as
the Model Validation Team (MVT), to ensure their accuracy and reliability."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v58:clause430:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:58:430> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

