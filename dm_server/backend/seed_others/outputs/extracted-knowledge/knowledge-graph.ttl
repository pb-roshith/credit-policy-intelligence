<urn:cpi:rule:v69:clause1547:r3> a cpi:PolicyRule ;
    rdfs:label "Third-Party Vendor Exemption Requirement for Credit Standards" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:24a661299ba3ba4cd0b5>,
        <urn:cpi:policyclass:acb66a8f8a7f374455cb> ;
