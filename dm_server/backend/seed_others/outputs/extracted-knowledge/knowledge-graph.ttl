    cpi:sourceRef <urn:cpi:source:1:8> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v2:clause30:r2> a cpi:PolicyRule ;
    rdfs:label "Non-Investment-Grade Corporate Maximum Quantitative Leverage Limit" ;
    cpi:APPLIES_TO_SEGMENT <urn:cpi:customersegment:71a4273390f9229601a2> ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:51785e55a44e8ac3604c>,
        <urn:cpi:policyclass:9cdad92394b23d28c4ac> ;
    cpi:CONCERNS <urn:cpi:policyconcern:bd3f2db41963c5ad0767> ;
    cpi:DERIVED_FROM <urn:cpi:source:2:30> ;
    cpi:EVALUATES_RISK_ATTRIBUTE <urn:cpi:riskmetric:90552734fc79bc2bfc7f> ;
    cpi:HAS_CONDITION <urn:cpi:rule:v2:clause30:r2:logic:55e41c1221eb13e1> ;
    cpi:HAS_THRESHOLD <urn:cpi:rule:v2:clause30:r2:threshold:0> ;
    cpi:PART_OF_VERSION <urn:cpi:version:2> ;
    cpi:USES_METRIC <urn:cpi:riskmetric:90552734fc79bc2bfc7f> ;
    cpi:requirement_text """while
for non-investment-grade borrowers, the limit is capped at 3.5x."""^^xsd:string ;
    cpi:rule_kind "QUANTITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v2:clause30:r2"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:2:30> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v37:clause185:r1> a cpi:PolicyRule ;
    rdfs:label "Minor Breach Temporary Approval by Head of CRM" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:9ec908f0bf2d80d3eebe>,
        <urn:cpi:policyclass:acb66a8f8a7f374455cb> ;
    cpi:DERIVED_FROM <urn:cpi:source:37:185> ;
    cpi:EVALUATES_RISK_ATTRIBUTE <urn:cpi:riskmetric:f213b943478c501781e6> ;
    cpi:HAS_THRESHOLD <urn:cpi:rule:v37:clause185:r1:threshold:0> ;
    cpi:PART_OF_VERSION <urn:cpi:version:37> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v37:clause185:r1:approval:0> ;
    cpi:REQUIRES_APPROVAL_ON_BREACH <urn:cpi:rule:v37:clause185:r1:approval:0> ;
    cpi:REQUIRES_EVIDENCE <urn:cpi:rule:v37:clause185:r1:evidence:0> ;
    cpi:USES_METRIC <urn:cpi:riskmetric:f213b943478c501781e6> ;
    cpi:requirement_text """Minor breaches of the quantitative limits, as defined in Section 5, must be escalated to the Head of CRM within 24 hours of
identification. The Head of CRM has the authority to approve temporary breaches of up to 5% above the limit for a maximum
period of 30 days, provided that a corrective action plan is in place to bring the exposure back within the limit."""^^xsd:string ;
    cpi:rule_kind "QUANTITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v37:clause185:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:37:185> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

