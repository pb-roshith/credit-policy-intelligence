<urn:cpi:rule:v50:clause276:r1> a cpi:PolicyRule ;
    rdfs:label "Credit Risk Committee Approval for Major Exception Reductions" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:9ec908f0bf2d80d3eebe>,
        <urn:cpi:policyclass:acb66a8f8a7f374455cb> ;
    cpi:CONCERNS <urn:cpi:policyconcern:a0148a51d610b28abff8> ;
    cpi:DERIVED_FROM <urn:cpi:source:50:276> ;
    cpi:EVALUATES_RISK_ATTRIBUTE <urn:cpi:riskmetric:885d480e1925df2355a9>,
        <urn:cpi:riskmetric:fa510243fc1d07443f4a> ;
    cpi:HAS_THRESHOLD <urn:cpi:rule:v50:clause276:r1:threshold:0>,
        <urn:cpi:rule:v50:clause276:r1:threshold:1> ;
    cpi:PART_OF_VERSION <urn:cpi:version:50> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v50:clause276:r1:approval:0> ;
    cpi:REQUIRES_APPROVAL_ABOVE_THRESHOLD <urn:cpi:rule:v50:clause276:r1:approval:0> ;
    cpi:USES_METRIC <urn:cpi:riskmetric:885d480e1925df2355a9>,
        <urn:cpi:riskmetric:fa510243fc1d07443f4a> ;
    cpi:requirement_text """Exceptions that involve a haircut reduction of more than 5 percentage points or a collateral value exceeding USD 5 million
require approval from the Credit Risk Committee (CRC)."""^^xsd:string ;
    cpi:rule_kind "QUANTITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v50:clause276:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:50:276> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

