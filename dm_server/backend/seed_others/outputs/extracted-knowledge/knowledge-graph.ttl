    cpi:USES_METRIC <urn:cpi:riskmetric:e5e3b898a943636e6145> ;
    cpi:requirement_text "and a minimum current ratio of 1.2x."^^xsd:string ;
    cpi:rule_kind "QUANTITATIVE"^^xsd:string ;
