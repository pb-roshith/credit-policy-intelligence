    cpi:USES_METRIC <urn:cpi:riskmetric:d1b222d1e468ecab93d8> ;
    cpi:requirement_text """Automated alerts are generated when predefined thresholds are breached,
such as a decline in the counterparty’s interest coverage ratio below 1.5x or a downgrade in its external credit rating."""^^xsd:string ;
    cpi:rule_kind "QUANTITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v69:clause1563:r2"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:69:1563> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v72:clause1611:r3> a cpi:PolicyRule ;
    rdfs:label "Retail Portfolio Exception Approval Requirement" ;
    cpi:APPLIES_TO_PRODUCT <urn:cpi:product:ff9cf03c8dcd454a9925> ;
    cpi:APPLIES_TO_SEGMENT <urn:cpi:customersegment:d1abf04afbb802b31ed3> ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:9ec908f0bf2d80d3eebe>,
        <urn:cpi:policyclass:acb66a8f8a7f374455cb> ;
    cpi:DERIVED_FROM <urn:cpi:source:72:1611> ;
    cpi:PART_OF_VERSION <urn:cpi:version:72> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v72:clause1611:r3:approval:0> ;
    cpi:requirement_text """However, exceptions may be made for retail portfolios with
embedded options or structured features that introduce duration risk, such as long-term mortgages with prepayment options. In
such cases, the relevant business unit must seek approval from the Risk Management Committee (RMC) to include these
products within the Policy’s scope."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v72:clause1611:r3"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:72:1611> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v72:clause1617:r6> a cpi:PolicyRule ;
    rdfs:label "Asset-Liability Duration Gap Limit" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:51785e55a44e8ac3604c>,
        <urn:cpi:policyclass:710d37ea2613a714b46c> ;
    cpi:DERIVED_FROM <urn:cpi:source:72:1617> ;
    cpi:EVALUATES_RISK_ATTRIBUTE <urn:cpi:riskmetric:76dabd69a8b7265621b8> ;
    cpi:HAS_THRESHOLD <urn:cpi:rule:v72:clause1617:r6:threshold:0> ;
    cpi:PART_OF_VERSION <urn:cpi:version:72> ;
    cpi:USES_METRIC <urn:cpi:riskmetric:76dabd69a8b7265621b8> ;
    cpi:requirement_text """The Asset-Liability
Duration Gap Limit restricts the difference between the weighted average duration of the Bank’s credit assets and its funding
liabilities to a maximum of 2.0 years."""^^xsd:string ;
    cpi:rule_kind "QUANTITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v72:clause1617:r6"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:72:1617> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

