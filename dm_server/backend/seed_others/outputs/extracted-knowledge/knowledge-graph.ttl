    cpi:CLASSIFIED_AS <urn:cpi:policyclass:d9fec564d2da12d10ad5> ;
    cpi:DERIVED_FROM <urn:cpi:source:68:1536> ;
    cpi:PART_OF_VERSION <urn:cpi:version:68> ;
    cpi:requirement_text "Payment after cut-off | Customer pays during transfer period. | Reconcile ownership, allocation and buyer settlement."^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v68:clause1536:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:68:1536> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

