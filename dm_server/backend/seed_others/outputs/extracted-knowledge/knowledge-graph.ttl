    cpi:rule_reference "urn:cpi:rule:v68:clause1541:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:68:1541> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v68:clause1542:r1> a cpi:PolicyRule ;
    rdfs:label "Suggested Training Prompt for Drafting an Exception Record Without Approval" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:d9fec564d2da12d10ad5> ;
    cpi:DERIVED_FROM <urn:cpi:source:68:1542> ;
    cpi:PART_OF_VERSION <urn:cpi:version:68> ;
    cpi:requirement_text "Draft an exception record without approving it."^^xsd:string ;
