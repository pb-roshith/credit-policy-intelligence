    cpi:sourceRef <urn:cpi:source:68:1542> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v68:clause1543:r1> a cpi:PolicyRule ;
    rdfs:label "Suggested Training Prompt for Explaining Human Review Requirements" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:d9fec564d2da12d10ad5> ;
    cpi:DERIVED_FROM <urn:cpi:source:68:1543> ;
    cpi:PART_OF_VERSION <urn:cpi:version:68> ;
    cpi:requirement_text "Explain which conclusions require human review."^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
