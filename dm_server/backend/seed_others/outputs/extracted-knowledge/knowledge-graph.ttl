    cpi:EVALUATES_RISK_ATTRIBUTE <urn:cpi:riskmetric:6ec48fa8b547deefe563> ;
    cpi:HAS_EXCEPTION <urn:cpi:rule:v54:clause351:r1:in-statement-exception> ;
