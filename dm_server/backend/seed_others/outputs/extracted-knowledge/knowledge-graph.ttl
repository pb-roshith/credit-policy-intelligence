    cpi:EVALUATES_RISK_ATTRIBUTE <urn:cpi:riskmetric:c6e32a68cdddf8f4ab43> ;
    cpi:HAS_THRESHOLD <urn:cpi:rule:v56:clause387:r2:threshold:0> ;
