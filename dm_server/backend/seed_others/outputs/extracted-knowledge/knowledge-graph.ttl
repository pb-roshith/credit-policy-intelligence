    cpi:DERIVED_FROM <urn:cpi:source:73:1631> ;
    cpi:PART_OF_VERSION <urn:cpi:version:73> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v73:clause1631:r2:approval:0>,
        <urn:cpi:rule:v73:clause1631:r2:approval:1> ;
    cpi:requirement_text """It
covers both the Bank’s domestic and international operations, unless explicitly exempted by the Chief Risk Officer (CRO) in
consultation with the Asset and Liability Committee (ALCO)."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v73:clause1631:r2"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:73:1631> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v73:clause1631:r4> a cpi:PolicyRule ;
    rdfs:label "Enhanced Liquidity Risk Assessments for High-Risk Assets" ;
    cpi:APPLIES_TO_PRODUCT <urn:cpi:product:473c14d256759d8abd22>,
        <urn:cpi:product:c997f6e22fb9b21d05bf> ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:ad98f77b21b765d56232>,
        <urn:cpi:policyclass:ef181960a2e7ddb709f2> ;
    cpi:DERIVED_FROM <urn:cpi:source:73:1631> ;
    cpi:PART_OF_VERSION <urn:cpi:version:73> ;
    cpi:REQUIRES_EVIDENCE <urn:cpi:rule:v73:clause1631:r4:evidence:0> ;
    cpi:requirement_text """High-risk or illiquid credit assets, such as leveraged loans or distressed debt, are subject to
enhanced liquidity risk assessments and more frequent reporting under this Policy."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v73:clause1631:r4"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:73:1631> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v73:clause1637:r3> a cpi:PolicyRule ;
    rdfs:label "Illiquid Credit Asset Portfolio Concentration Limit" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:51785e55a44e8ac3604c>,
        <urn:cpi:policyclass:ae6a67c0bab119d96d75> ;
    cpi:DERIVED_FROM <urn:cpi:source:73:1637> ;
    cpi:EVALUATES_RISK_ATTRIBUTE <urn:cpi:riskmetric:8aeefbc14dff2e4eb0b8> ;
    cpi:HAS_THRESHOLD <urn:cpi:rule:v73:clause1637:r3:threshold:0> ;
    cpi:PART_OF_VERSION <urn:cpi:version:73> ;
    cpi:USES_METRIC <urn:cpi:riskmetric:8aeefbc14dff2e4eb0b8> ;
    cpi:requirement_text """No more than 20% of the Bank’s total credit portfolio may
consist of illiquid assets, defined as those that cannot be converted into cash within 30 days without a significant loss of value."""^^xsd:string ;
    cpi:rule_kind "QUANTITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v73:clause1637:r3"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:73:1637> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v73:clause1637:r6> a cpi:PolicyRule ;
    rdfs:label "Early Warning Trigger for LCR Breach" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:ad98f77b21b765d56232>,
        <urn:cpi:policyclass:dbee7b1fa11fe46b26ed> ;
    cpi:DERIVED_FROM <urn:cpi:source:73:1637> ;
    cpi:EVALUATES_RISK_ATTRIBUTE <urn:cpi:riskmetric:1850d0e0ab079be352de> ;
    cpi:HAS_THRESHOLD <urn:cpi:rule:v73:clause1637:r6:threshold:0> ;
    cpi:PART_OF_VERSION <urn:cpi:version:73> ;
    cpi:USES_METRIC <urn:cpi:riskmetric:1850d0e0ab079be352de> ;
    cpi:requirement_text """If the LCR for the credit portfolio falls below 110%, or if the
concentration of illiquid assets exceeds 15%, CRM must immediately notify ALCO and the CRO."""^^xsd:string ;
    cpi:rule_kind "QUANTITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v73:clause1637:r6"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:73:1637> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v73:clause1637:r7> a cpi:PolicyRule ;
    rdfs:label "Early Warning Trigger for Illiquid Asset Concentration" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:ad98f77b21b765d56232>,
        <urn:cpi:policyclass:ae6a67c0bab119d96d75> ;
    cpi:DERIVED_FROM <urn:cpi:source:73:1637> ;
    cpi:EVALUATES_RISK_ATTRIBUTE <urn:cpi:riskmetric:e8b326344d057cf2dbbb> ;
    cpi:HAS_THRESHOLD <urn:cpi:rule:v73:clause1637:r7:threshold:0> ;
    cpi:PART_OF_VERSION <urn:cpi:version:73> ;
    cpi:USES_METRIC <urn:cpi:riskmetric:e8b326344d057cf2dbbb> ;
    cpi:requirement_text """If the LCR for the credit portfolio falls below 110%, or if the
concentration of illiquid assets exceeds 15%, CRM must immediately notify ALCO and the CRO."""^^xsd:string ;
    cpi:rule_kind "QUANTITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v73:clause1637:r7"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:73:1637> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v73:clause1639:r1> a cpi:PolicyRule ;
    rdfs:label "Approval Authority for Small Credit Exposures" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:9ec908f0bf2d80d3eebe> ;
    cpi:DERIVED_FROM <urn:cpi:source:73:1639> ;
    cpi:EVALUATES_RISK_ATTRIBUTE <urn:cpi:riskmetric:143cf9c58be0f7c98c42> ;
    cpi:HAS_THRESHOLD <urn:cpi:rule:v73:clause1639:r1:threshold:0> ;
    cpi:PART_OF_VERSION <urn:cpi:version:73> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v73:clause1639:r1:approval:0> ;
    cpi:USES_METRIC <urn:cpi:riskmetric:143cf9c58be0f7c98c42> ;
    cpi:requirement_text """For credit exposures below 1% of the Bank’s total liquid assets, approval authority rests with the relevant business unit head,
provided that the exposure complies with the underwriting criteria and quantitative limits set forth in this Policy."""^^xsd:string ;
    cpi:rule_kind "QUANTITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v73:clause1639:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:73:1639> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v73:clause1645:r1> a cpi:PolicyRule ;
    rdfs:label "Report Archive Retention Period" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:08301552b025a4c29694>,
        <urn:cpi:policyclass:a05a0a4f8c8c7ff19a51> ;
    cpi:DERIVED_FROM <urn:cpi:source:73:1645> ;
    cpi:EVALUATES_RISK_ATTRIBUTE <urn:cpi:riskmetric:38afe2d65bdefd388328> ;
    cpi:HAS_THRESHOLD <urn:cpi:rule:v73:clause1645:r1:threshold:0> ;
    cpi:PART_OF_VERSION <urn:cpi:version:73> ;
    cpi:USES_METRIC <urn:cpi:riskmetric:38afe2d65bdefd388328> ;
    cpi:requirement_text """CRM
maintains an archive of all reports for at least seven years, with older reports retained in accordance with the Bank’s records
management policy."""^^xsd:string ;
    cpi:rule_kind "QUANTITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v73:clause1645:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:73:1645> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

