    cpi:DERIVED_FROM <urn:cpi:source:48:226> ;
    cpi:PART_OF_VERSION <urn:cpi:version:48> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v48:clause226:r1:approval:0>,
        <urn:cpi:rule:v48:clause226:r1:approval:1> ;
    cpi:requirement_text """The CCO is empowered to issue clarifications, temporary waivers, or
adjustments to ratio thresholds, provided such actions are documented and reported to the CRC within 30 days."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v48:clause226:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:48:226> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v48:clause226:r2> a cpi:PolicyRule ;
    rdfs:label "Independent Annual Valuation of Coverage Ratio Calculations" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:ad98f77b21b765d56232>,
        <urn:cpi:policyclass:e9df5184319d3db58971> ;
    cpi:DERIVED_FROM <urn:cpi:source:48:226> ;
    cpi:PART_OF_VERSION <urn:cpi:version:48> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v48:clause226:r2:approval:0> ;
    cpi:REQUIRES_EVIDENCE <urn:cpi:rule:v48:clause226:r2:evidence:0> ;
    cpi:requirement_text "Independent validation of coverage ratio calculations is performed by the Internal Audit team on an annual basis."^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v48:clause226:r2"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:48:226> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v49:clause248:r3> a cpi:PolicyRule ;
    rdfs:label "Financial Instruments Collateral Eligibility" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:ebcd620636c948c2d6c5>,
        <urn:cpi:policyclass:ef181960a2e7ddb709f2> ;
    cpi:CONCERNS <urn:cpi:policyconcern:a0148a51d610b28abff8> ;
    cpi:DERIVED_FROM <urn:cpi:source:49:248> ;
    cpi:HAS_CONDITION <urn:cpi:rule:v49:clause248:r3:logic:27b2ca57e0500089> ;
    cpi:PART_OF_VERSION <urn:cpi:version:49> ;
    cpi:requirement_text """Financial instruments accepted as collateral must be listed on recognized exchanges or have a readily determinable market
value."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v49:clause248:r3"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:49:248> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v49:clause252:r2> a cpi:PolicyRule ;
    rdfs:label "Credit Officer Verification of Eligibility and Documentation Duty" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:a05a0a4f8c8c7ff19a51>,
        <urn:cpi:policyclass:ebcd620636c948c2d6c5> ;
    cpi:CONCERNS <urn:cpi:policyconcern:a0148a51d610b28abff8> ;
    cpi:DERIVED_FROM <urn:cpi:source:49:252> ;
    cpi:PART_OF_VERSION <urn:cpi:version:49> ;
    cpi:REQUIRES_EVIDENCE <urn:cpi:rule:v49:clause252:r2:evidence:0> ;
    cpi:requirement_text """The credit officer must verify that the
collateral meets the bank’s eligibility criteria and that all required documentation, such as title deeds or valuation reports, is in
order."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v49:clause252:r2"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:49:252> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v49:clause252:r5> a cpi:PolicyRule ;
    rdfs:label "Credit Approval Committee Final Acceptance and Memo Retention" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:9ec908f0bf2d80d3eebe>,
        <urn:cpi:policyclass:a05a0a4f8c8c7ff19a51> ;
    cpi:DERIVED_FROM <urn:cpi:source:49:252> ;
    cpi:PART_OF_VERSION <urn:cpi:version:49> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v49:clause252:r5:approval:0> ;
    cpi:REQUIRES_EVIDENCE <urn:cpi:rule:v49:clause252:r5:evidence:0> ;
    cpi:requirement_text """The final approval for collateral acceptance rests with the Credit Approval Committee (CAC), which is composed of senior
representatives from Credit Risk, Legal, and Compliance. The CAC reviews all high-value or high-risk credit applications,
ensuring that the collateral is adequate and that the transaction aligns with the bank’s risk appetite. The CAC’s decision is
documented in the credit approval memo, which is retained for audit purposes."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v49:clause252:r5"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:49:252> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v49:clause254:r8> a cpi:PolicyRule ;
    rdfs:label "Monitoring Reporting to Stakeholders" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:08301552b025a4c29694>,
        <urn:cpi:policyclass:ad98f77b21b765d56232> ;
    cpi:DERIVED_FROM <urn:cpi:source:49:254> ;
    cpi:PART_OF_VERSION <urn:cpi:version:49> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v49:clause254:r8:approval:0>,
        <urn:cpi:rule:v49:clause254:r8:approval:1> ;
    cpi:requirement_text """The results of monitoring activities are documented in regular reports, which are distributed to the CRC, CAC, and other
relevant stakeholders."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v49:clause254:r8"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:49:254> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v49:clause256:r2> a cpi:PolicyRule ;
    rdfs:label "Exception Request Contents Requirement" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:a05a0a4f8c8c7ff19a51>,
        <urn:cpi:policyclass:acb66a8f8a7f374455cb> ;
    cpi:CONCERNS <urn:cpi:policyconcern:a0148a51d610b28abff8> ;
    cpi:DERIVED_FROM <urn:cpi:source:49:256> ;
    cpi:PART_OF_VERSION <urn:cpi:version:49> ;
    cpi:REQUIRES_EVIDENCE <urn:cpi:rule:v49:clause256:r2:evidence:0> ;
    cpi:requirement_text """The request for an
exception must include a detailed analysis of the collateral’s risk profile, the reasons for the deviation from policy, and the
proposed mitigating actions."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v49:clause256:r2"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:49:256> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v49:clause256:r7> a cpi:PolicyRule ;
    rdfs:label "Exception Logging and Internal Audit Review Duty" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:a05a0a4f8c8c7ff19a51>,
        <urn:cpi:policyclass:acb66a8f8a7f374455cb>,
        <urn:cpi:policyclass:ad98f77b21b765d56232> ;
    cpi:DERIVED_FROM <urn:cpi:source:49:256> ;
    cpi:PART_OF_VERSION <urn:cpi:version:49> ;
    cpi:REQUIRES_EVIDENCE <urn:cpi:rule:v49:clause256:r7:evidence:0> ;
    cpi:requirement_text """All approved exceptions are documented in the bank’s exception log, which includes the rationale, the
approved mitigating actions, and the expiration date of the exception. The log is reviewed regularly by Internal Audit to ensure
compliance with the process."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v49:clause256:r7"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:49:256> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v49:clause258:r3> a cpi:PolicyRule ;
    rdfs:label "Monthly Collateral Portfolio Status Reporting to CRC and CAC" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:08301552b025a4c29694>,
        <urn:cpi:policyclass:ad98f77b21b765d56232> ;
    cpi:DERIVED_FROM <urn:cpi:source:49:258> ;
    cpi:PART_OF_VERSION <urn:cpi:version:49> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v49:clause258:r3:approval:0>,
        <urn:cpi:rule:v49:clause258:r3:approval:1> ;
    cpi:requirement_text "Monthly reports are provided to the CRC and CAC, summarizing the overall status of the collateral portfolio."^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v49:clause258:r3"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:49:258> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v52:clause311:r10> a cpi:PolicyRule ;
    rdfs:label "Total Spread Minimum Boundary" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:51785e55a44e8ac3604c> ;
    cpi:DERIVED_FROM <urn:cpi:source:52:311> ;
    cpi:EVALUATES_RISK_ATTRIBUTE <urn:cpi:riskmetric:4f62414791515082f717> ;
    cpi:HAS_THRESHOLD <urn:cpi:rule:v52:clause311:r10:threshold:0> ;
    cpi:PART_OF_VERSION <urn:cpi:version:52> ;
    cpi:USES_METRIC <urn:cpi:riskmetric:4f62414791515082f717> ;
    cpi:requirement_text "The total spread (base + adjustments) must not fall below the minimum threshold of 100 bps"^^xsd:string ;
    cpi:rule_kind "QUANTITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v52:clause311:r10"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:52:311> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v52:clause315:r1> a cpi:PolicyRule ;
    rdfs:label "Minimum Manual Sample Review Requirement" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:ad98f77b21b765d56232> ;
    cpi:DERIVED_FROM <urn:cpi:source:52:315> ;
    cpi:EVALUATES_RISK_ATTRIBUTE <urn:cpi:riskmetric:3fa6af5bc728b7ac197f> ;
    cpi:HAS_THRESHOLD <urn:cpi:rule:v52:clause315:r1:threshold:0> ;
    cpi:PART_OF_VERSION <urn:cpi:version:52> ;
    cpi:USES_METRIC <urn:cpi:riskmetric:3fa6af5bc728b7ac197f> ;
    cpi:requirement_text "The CRM department selects a minimum of 10% of all new and renewed exposures for detailed review each quarter"^^xsd:string ;
    cpi:rule_kind "QUANTITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v52:clause315:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:52:315> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v53:clause333:r3> a cpi:PolicyRule ;
    rdfs:label "Loan Approval Authority Exceeding 20 Million" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:9357aa360ca9e8840c5b>,
        <urn:cpi:policyclass:9ec908f0bf2d80d3eebe> ;
    cpi:DERIVED_FROM <urn:cpi:source:53:333> ;
    cpi:PART_OF_VERSION <urn:cpi:version:53> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v53:clause333:r3:approval:0> ;
    cpi:REQUIRES_APPROVAL_ABOVE_THRESHOLD <urn:cpi:rule:v53:clause333:r3:approval:0> ;
    cpi:requirement_text """while loans exceeding $20 million must be approved by the Chief Credit Officer (CCO) or
their delegate."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v53:clause333:r3"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:53:333> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v54:clause349:r10> a cpi:PolicyRule ;
    rdfs:label "Minimum Equity Contribution Requirement" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:ef181960a2e7ddb709f2> ;
    cpi:DERIVED_FROM <urn:cpi:source:54:349> ;
    cpi:EVALUATES_RISK_ATTRIBUTE <urn:cpi:riskmetric:a7ac3fab07d64222490f> ;
    cpi:HAS_THRESHOLD <urn:cpi:rule:v54:clause349:r10:threshold:0> ;
    cpi:PART_OF_VERSION <urn:cpi:version:54> ;
    cpi:USES_METRIC <urn:cpi:riskmetric:a7ac3fab07d64222490f> ;
    cpi:requirement_text """Borrowers are required to contribute a minimum of 20% of the total project cost as equity, which must be injected prior to the
first disbursement of loan funds."""^^xsd:string ;
    cpi:rule_kind "QUANTITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v54:clause349:r10"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:54:349> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v54:clause349:r3> a cpi:PolicyRule ;
    rdfs:label "Minimum Track Record of Similar Projects Completed" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:ef181960a2e7ddb709f2> ;
    cpi:DERIVED_FROM <urn:cpi:source:54:349> ;
    cpi:EVALUATES_RISK_ATTRIBUTE <urn:cpi:riskmetric:10884e64b848002d3094> ;
    cpi:HAS_THRESHOLD <urn:cpi:rule:v54:clause349:r3:threshold:0> ;
    cpi:PART_OF_VERSION <urn:cpi:version:54> ;
    cpi:USES_METRIC <urn:cpi:riskmetric:10884e64b848002d3094> ;
    cpi:requirement_text """For project-specific underwriting, the borrower must demonstrate a track record of successfully completing
at least three similar projects within the past five years,"""^^xsd:string ;
    cpi:rule_kind "QUANTITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v54:clause349:r3"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:54:349> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v54:clause355:r3> a cpi:PolicyRule ;
    rdfs:label "Mandatory Lien Waivers and Evidence of Payment for Disbursement" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:a05a0a4f8c8c7ff19a51>,
        <urn:cpi:policyclass:e9df5184319d3db58971> ;
    cpi:DERIVED_FROM <urn:cpi:source:54:355> ;
    cpi:PART_OF_VERSION <urn:cpi:version:54> ;
    cpi:REQUIRES_EVIDENCE <urn:cpi:rule:v54:clause355:r3:evidence:0>,
        <urn:cpi:rule:v54:clause355:r3:evidence:1> ;
    cpi:requirement_text """Each disbursement request must be
accompanied by lien waivers from contractors and suppliers, as well as evidence of payment for prior disbursements."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v54:clause355:r3"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:54:355> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v54:clause359:r1> a cpi:PolicyRule ;
    rdfs:label "Mandatory Document Retention Period" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:a05a0a4f8c8c7ff19a51> ;
    cpi:DERIVED_FROM <urn:cpi:source:54:359> ;
    cpi:EVALUATES_RISK_ATTRIBUTE <urn:cpi:riskmetric:061ad9a34c5dee433215> ;
    cpi:HAS_THRESHOLD <urn:cpi:rule:v54:clause359:r1:threshold:0> ;
    cpi:PART_OF_VERSION <urn:cpi:version:54> ;
    cpi:USES_METRIC <urn:cpi:riskmetric:061ad9a34c5dee433215> ;
    cpi:requirement_text "The bank retains all construction loan documentation for a minimum of seven years after the loan is repaid or charged off."^^xsd:string ;
    cpi:rule_kind "QUANTITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v54:clause359:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:54:359> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v56:clause385:r6> a cpi:PolicyRule ;
    rdfs:label "Escalation for Uncured Covenant Breaches" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:3cc501323e7be26b148a>,
        <urn:cpi:policyclass:ad98f77b21b765d56232> ;
    cpi:DERIVED_FROM <urn:cpi:source:56:385> ;
    cpi:PART_OF_VERSION <urn:cpi:version:56> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v56:clause385:r6:approval:0> ;
    cpi:REQUIRES_APPROVAL_ON_BREACH <urn:cpi:rule:v56:clause385:r6:approval:0> ;
    cpi:requirement_text """Similarly, any breach of financial or non-financial covenants that is not cured
within the stipulated grace period must be escalated to the Credit Risk Committee (CRC)."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v56:clause385:r6"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:56:385> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v56:clause389:r6> a cpi:PolicyRule ;
    rdfs:label "Minimum Current Ratio Underwriting Threshold" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:51785e55a44e8ac3604c> ;
    cpi:DERIVED_FROM <urn:cpi:source:56:389> ;
    cpi:EVALUATES_RISK_ATTRIBUTE <urn:cpi:riskmetric:e5e3b898a943636e6145> ;
    cpi:HAS_THRESHOLD <urn:cpi:rule:v56:clause389:r6:threshold:0> ;
    cpi:PART_OF_VERSION <urn:cpi:version:56> ;
    cpi:USES_METRIC <urn:cpi:riskmetric:e5e3b898a943636e6145> ;
    cpi:requirement_text "and current ratios below 1.0x."^^xsd:string ;
    cpi:rule_kind "QUANTITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v56:clause389:r6"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:56:389> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v56:clause398:r4> a cpi:PolicyRule ;
    rdfs:label "Exception Audit Trail and Post-Approval Monitoring Requirements" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:a05a0a4f8c8c7ff19a51>,
        <urn:cpi:policyclass:acb66a8f8a7f374455cb>,
        <urn:cpi:policyclass:ad98f77b21b765d56232> ;
    cpi:DERIVED_FROM <urn:cpi:source:56:398> ;
    cpi:PART_OF_VERSION <urn:cpi:version:56> ;
    cpi:REQUIRES_EVIDENCE <urn:cpi:rule:v56:clause398:r4:evidence:0> ;
    cpi:requirement_text """All approved exceptions are documented in the CMS, with clear records of the rationale, the mitigating factors, and the identities
of the approving authorities. The bank’s Internal Audit function conducts periodic reviews of exception handling to ensure
compliance with this policy and to assess the effectiveness of the controls in place. Exceptions are also subject to post-approval
monitoring, with the RM required to provide quarterly updates on the performance of the transaction and the continued validity
of the mitigating factors. If the risk profile of the transaction deteriorates, the RM must escalate the case for reassessment,
which may result in the withdrawal of the exception or the imposition of additional controls."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v56:clause398:r4"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:56:398> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v58:clause426:r1> a cpi:PolicyRule ;
    rdfs:label "Standardized Approach Capital Floor Percentage" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:51785e55a44e8ac3604c> ;
    cpi:DERIVED_FROM <urn:cpi:source:58:426> ;
    cpi:EVALUATES_RISK_ATTRIBUTE <urn:cpi:riskmetric:d6405c50f1f041a92dfc> ;
    cpi:HAS_THRESHOLD <urn:cpi:rule:v58:clause426:r1:threshold:0> ;
    cpi:PART_OF_VERSION <urn:cpi:version:58> ;
    cpi:USES_METRIC <urn:cpi:riskmetric:d6405c50f1f041a92dfc> ;
    cpi:requirement_text """The floor is set
at 72.5% of the standardized RWAs, as per Basel IV requirements, to ensure consistency and comparability."""^^xsd:string ;
    cpi:rule_kind "QUANTITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v58:clause426:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:58:426> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v58:clause426:r2> a cpi:PolicyRule ;
    rdfs:label "Materiality Threshold for Exclusion from Policy Scope" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:51785e55a44e8ac3604c> ;
    cpi:DERIVED_FROM <urn:cpi:source:58:426> ;
    cpi:EVALUATES_RISK_ATTRIBUTE <urn:cpi:riskmetric:bc83d980b240ec5843f0> ;
    cpi:HAS_THRESHOLD <urn:cpi:rule:v58:clause426:r2:threshold:0> ;
    cpi:PART_OF_VERSION <urn:cpi:version:58> ;
    cpi:USES_METRIC <urn:cpi:riskmetric:bc83d980b240ec5843f0> ;
    cpi:requirement_text "The materiality threshold for exclusion is defined as any exposure that constitutes less than 1% of the Bank’s total RWAs."^^xsd:string ;
    cpi:rule_kind "QUANTITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v58:clause426:r2"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:58:426> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v58:clause432:r1> a cpi:PolicyRule ;
    rdfs:label "Capital Floor Minimum Percentage Limit" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:51785e55a44e8ac3604c> ;
    cpi:DERIVED_FROM <urn:cpi:source:58:432> ;
    cpi:EVALUATES_RISK_ATTRIBUTE <urn:cpi:riskmetric:d32263a00acf35332f92> ;
    cpi:HAS_THRESHOLD <urn:cpi:rule:v58:clause432:r1:threshold:0> ;
    cpi:PART_OF_VERSION <urn:cpi:version:58> ;
    cpi:USES_METRIC <urn:cpi:riskmetric:d32263a00acf35332f92> ;
    cpi:requirement_text """The primary limit is the capital floor, which is set at 72.5% of the RWAs calculated using the
standardized approach. This means that the RWAs calculated under the Bank’s internal models must not be less than 72.5% of
the RWAs calculated under the standardized approach for the same exposures."""^^xsd:string ;
    cpi:rule_kind "QUANTITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v58:clause432:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:58:432> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v65:clause1140:r1> a cpi:PolicyRule ;
    rdfs:label "Case Transfer Criteria and Evidence Handoff" ;
    cpi:APPLIES_TO_SEGMENT <urn:cpi:customersegment:0732653e72e9cc1948e6> ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:a05a0a4f8c8c7ff19a51>,
        <urn:cpi:policyclass:ef181960a2e7ddb709f2> ;
    cpi:DERIVED_FROM <urn:cpi:source:65:1140> ;
    cpi:PART_OF_VERSION <urn:cpi:version:65> ;
    cpi:REQUIRES_EVIDENCE <urn:cpi:rule:v65:clause1140:r1:evidence:0> ;
    cpi:requirement_text "Cases meeting approved criteria shall be transferred with complete evidence and handoff."^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v65:clause1140:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:65:1140> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v69:clause1547:r1> a cpi:PolicyRule ;
    rdfs:label "Credit Rating Standards Purpose and Compliance Scope" ;
    cpi:APPLIES_TO_SEGMENT <urn:cpi:customersegment:976acc2d3f29f4b2df54>,
        <urn:cpi:customersegment:c07e778f63017a1d3244>,
        <urn:cpi:customersegment:f38e368860580fb673d0> ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:24a661299ba3ba4cd0b5> ;
    cpi:DERIVED_FROM <urn:cpi:source:69:1547> ;
    cpi:PART_OF_VERSION <urn:cpi:version:69> ;
    cpi:requirement_text """This document, titled RAT-1.0 Credit Rating Standards, establishes the foundational framework for credit rating assignments
within the synthetic demonstration environment of the bank. It is designed to ensure consistency, transparency, and regulatory
compliance in the evaluation of creditworthiness for all counterparties, including corporate, commercial, and retail clients. The
standards outlined herein are aligned with the parent policy RAT-v1.0 and serve as a critical component of the bank’s risk
management infrastructure."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v69:clause1547:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:69:1547> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v69:clause1553:r2> a cpi:PolicyRule ;
    rdfs:label "Corporate and Commercial Rating Scoring Model" ;
    cpi:APPLIES_TO_SEGMENT <urn:cpi:customersegment:c07e778f63017a1d3244>,
        <urn:cpi:customersegment:c733f1f18b6a679928cd> ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:8286b68d49a05514b406>,
        <urn:cpi:policyclass:ef181960a2e7ddb709f2> ;
    cpi:DERIVED_FROM <urn:cpi:source:69:1553> ;
    cpi:PART_OF_VERSION <urn:cpi:version:69> ;
    cpi:requirement_text """For corporate and commercial counterparties, the bank utilizes a scoring model that assigns weights to key financial ratios,
including leverage, liquidity, profitability, and interest coverage. The model generates a preliminary score, which is then
adjusted based on qualitative factors. The final score corresponds to a specific rating on the bank’s internal rating scale, which
ranges from AAA (highest credit quality) to D (default). The internal scale is mapped to external rating scales for consistency
and comparability."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v69:clause1553:r2"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:69:1553> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v69:clause1567:r3> a cpi:PolicyRule ;
    rdfs:label "Monthly Senior Committee Reporting" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:08301552b025a4c29694>,
        <urn:cpi:policyclass:ad98f77b21b765d56232> ;
    cpi:DERIVED_FROM <urn:cpi:source:69:1567> ;
    cpi:PART_OF_VERSION <urn:cpi:version:69> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v69:clause1567:r3:approval:0>,
        <urn:cpi:rule:v69:clause1567:r3:approval:1> ;
    cpi:requirement_text """Monthly reports are submitted to the CRO and the Global Credit
Committee, with a focus on emerging risks, trend analyses, and the status of remediation actions."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v69:clause1567:r3"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:69:1567> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v69:clause1567:r4> a cpi:PolicyRule ;
    rdfs:label "External Regulatory Reporting Validation" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:08301552b025a4c29694>,
        <urn:cpi:policyclass:45b84dd2dfe7afa3a554> ;
    cpi:DERIVED_FROM <urn:cpi:source:69:1567> ;
    cpi:PART_OF_VERSION <urn:cpi:version:69> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v69:clause1567:r4:approval:0>,
        <urn:cpi:rule:v69:clause1567:r4:approval:1> ;
    cpi:requirement_text """The CRM department is responsible for ensuring the accuracy and timeliness of all
external reports, which are subject to independent validation by the IRV team prior to submission."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v69:clause1567:r4"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:69:1567> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v69:clause1567:r6> a cpi:PolicyRule ;
    rdfs:label "Material Policy Changes Approval Requirement" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:9ec908f0bf2d80d3eebe>,
        <urn:cpi:policyclass:acb66a8f8a7f374455cb> ;
    cpi:DERIVED_FROM <urn:cpi:source:69:1567> ;
    cpi:PART_OF_VERSION <urn:cpi:version:69> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v69:clause1567:r6:approval:0>,
        <urn:cpi:rule:v69:clause1567:r6:approval:1> ;
    cpi:requirement_text """Material changes to the policy, such as updates to the credit rating methodologies, underwriting criteria, or quantitative limits,
require the approval of the CRO and the Board’s Risk Committee."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v69:clause1567:r6"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:69:1567> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v72:clause1619:r1> a cpi:PolicyRule ;
    rdfs:label "Approval Document Retention Period" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:a05a0a4f8c8c7ff19a51> ;
    cpi:DERIVED_FROM <urn:cpi:source:72:1619> ;
    cpi:EVALUATES_RISK_ATTRIBUTE <urn:cpi:riskmetric:5e091e3b0e13b1357b45> ;
    cpi:HAS_THRESHOLD <urn:cpi:rule:v72:clause1619:r1:threshold:0> ;
    cpi:PART_OF_VERSION <urn:cpi:version:72> ;
    cpi:USES_METRIC <urn:cpi:riskmetric:5e091e3b0e13b1357b45> ;
    cpi:requirement_text """6. 6. Approvals
The approvals process for duration risk is designed to ensure that all material exposures are reviewed and authorized by the
appropriate level of management, in accordance with the Bank’s delegation of authority framework. This section outlines the
roles, responsibilities, and escalation paths for approving credit transactions, limit breaches, and exceptions under this Policy.
All approvals must be documented in the Bank’s credit system and retained for a minimum of 7 years."""^^xsd:string ;
    cpi:rule_kind "QUANTITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v72:clause1619:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:72:1619> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v72:clause1623:r2> a cpi:PolicyRule ;
    rdfs:label "Approved Exception Maximum Duration Limit" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:acb66a8f8a7f374455cb> ;
    cpi:DERIVED_FROM <urn:cpi:source:72:1623> ;
    cpi:EVALUATES_RISK_ATTRIBUTE <urn:cpi:riskmetric:6f493da7c856822ab8c7> ;
    cpi:HAS_THRESHOLD <urn:cpi:rule:v72:clause1623:r2:threshold:0> ;
    cpi:PART_OF_VERSION <urn:cpi:version:72> ;
    cpi:USES_METRIC <urn:cpi:riskmetric:6f493da7c856822ab8c7> ;
    cpi:requirement_text "All approved exceptions are subject to a maximum duration of 12 months, unless otherwise specified by the RMC."^^xsd:string ;
    cpi:rule_kind "QUANTITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v72:clause1623:r2"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:72:1623> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v73:clause1637:r1> a cpi:PolicyRule ;
    rdfs:label "Liquidity Coverage Ratio Target and Minimum Threshold" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:51785e55a44e8ac3604c> ;
    cpi:DERIVED_FROM <urn:cpi:source:73:1637> ;
    cpi:EVALUATES_RISK_ATTRIBUTE <urn:cpi:riskmetric:1850d0e0ab079be352de> ;
    cpi:HAS_THRESHOLD <urn:cpi:rule:v73:clause1637:r1:threshold:0> ;
    cpi:PART_OF_VERSION <urn:cpi:version:73> ;
    cpi:USES_METRIC <urn:cpi:riskmetric:1850d0e0ab079be352de> ;
    cpi:requirement_text """The Bank’s target LCR for the credit portfolio is 120%,
with a minimum threshold of 100%."""^^xsd:string ;
    cpi:rule_kind "QUANTITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v73:clause1637:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:73:1637> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v73:clause1643:r1> a cpi:PolicyRule ;
    rdfs:label "Temporary Exception Duration Limit" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:acb66a8f8a7f374455cb> ;
    cpi:DERIVED_FROM <urn:cpi:source:73:1643> ;
    cpi:EVALUATES_RISK_ATTRIBUTE <urn:cpi:riskmetric:bdf825d26edf7c92a2e5> ;
    cpi:HAS_THRESHOLD <urn:cpi:rule:v73:clause1643:r1:threshold:0> ;
    cpi:PART_OF_VERSION <urn:cpi:version:73> ;
    cpi:USES_METRIC <urn:cpi:riskmetric:bdf825d26edf7c92a2e5> ;
    cpi:requirement_text """Temporary exceptions are granted for a
specified period, typically not exceeding 90 days, and are subject to regular review."""^^xsd:string ;
    cpi:rule_kind "QUANTITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v73:clause1643:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:73:1643> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

