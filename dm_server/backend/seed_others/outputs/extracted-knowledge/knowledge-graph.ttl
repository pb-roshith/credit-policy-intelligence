    cpi:PART_OF_VERSION <urn:cpi:version:69> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v69:clause1547:r3:approval:0> ;
    cpi:requirement_text """Third-party vendors or partners engaged in credit-related activities on behalf of the bank must also adhere to
these standards unless explicitly exempted by the Chief Risk Officer (CRO)."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v69:clause1547:r3"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:69:1547> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v69:clause1553:r3> a cpi:PolicyRule ;
    rdfs:label "Retail Counterparty Scoring Model Scale" ;
    cpi:APPLIES_TO_SEGMENT <urn:cpi:customersegment:b3a02a0381845e03f521> ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:8286b68d49a05514b406>,
        <urn:cpi:policyclass:ef181960a2e7ddb709f2> ;
    cpi:DERIVED_FROM <urn:cpi:source:69:1553> ;
    cpi:PART_OF_VERSION <urn:cpi:version:69> ;
    cpi:requirement_text """Retail counterparties are evaluated using a separate scoring model that incorporates factors such as credit history, income
stability, debt-to-income ratio, and collateral coverage. The model is calibrated to the bank’s historical default data and is
regularly updated to reflect changes in the economic environment. Retail ratings are assigned on a scale from 1 (lowest risk) to"""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v69:clause1553:r3"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:69:1553> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v69:clause1554:r2> a cpi:PolicyRule ;
    rdfs:label "Standardized Qualitative Assessment Checklists" ;
    cpi:APPLIES_TO_SEGMENT <urn:cpi:customersegment:b3a02a0381845e03f521>,
        <urn:cpi:customersegment:c07e778f63017a1d3244> ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:ef181960a2e7ddb709f2> ;
    cpi:DERIVED_FROM <urn:cpi:source:69:1554> ;
    cpi:PART_OF_VERSION <urn:cpi:version:69> ;
    cpi:requirement_text """Qualitative assessments are conducted using a standardized checklist that evaluates non-financial factors. For corporate
counterparties, this includes an analysis of the industry’s competitive landscape, the counterparty’s market position, the
experience and track record of its management team, and the quality of its risk management practices. For retail counterparties,
qualitative factors may include employment stability, residential status, and behavioral patterns observed in past transactions."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v69:clause1554:r2"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:69:1554> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v69:clause1561:r4> a cpi:PolicyRule ;
    rdfs:label "Global Credit Committee Approval for Limit Breaches and Complex Products" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:9ec908f0bf2d80d3eebe> ;
    cpi:DERIVED_FROM <urn:cpi:source:69:1561> ;
    cpi:PART_OF_VERSION <urn:cpi:version:69> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v69:clause1561:r4:approval:0> ;
    cpi:REQUIRES_APPROVAL_ON_BREACH <urn:cpi:rule:v69:clause1561:r4:approval:0> ;
    cpi:requirement_text """The Global Credit Committee also reviews and
approves all exposures that breach the bank’s internal risk-based limits or involve new or complex products."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v69:clause1561:r4"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:69:1561> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v69:clause1565:r2> a cpi:PolicyRule ;
    rdfs:label "Exception Submission and CRM Review Process" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:9ec908f0bf2d80d3eebe>,
        <urn:cpi:policyclass:acb66a8f8a7f374455cb> ;
    cpi:DERIVED_FROM <urn:cpi:source:69:1565> ;
    cpi:PART_OF_VERSION <urn:cpi:version:69> ;
    cpi:REQUIRES_EVIDENCE <urn:cpi:rule:v69:clause1565:r2:evidence:0> ;
    cpi:requirement_text """The process for requesting an exception begins with the submission of an Exception Request Form by the relationship manager
or underwriter. The form must include a detailed rationale for the exception, an assessment of the incremental risk, and a
description of any mitigating factors or controls. The request is then reviewed by the CRM department, which assesses its
compliance with the bank’s risk appetite and regulatory expectations. If the CRM department supports the request, it is
forwarded to the appropriate approval authority, which varies based on the nature and size of the exception."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v69:clause1565:r2"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:69:1565> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v69:clause1567:r1> a cpi:PolicyRule ;
    rdfs:label "Daily Risk Monitoring Dashboard Reporting" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:08301552b025a4c29694>,
        <urn:cpi:policyclass:ad98f77b21b765d56232> ;
    cpi:DERIVED_FROM <urn:cpi:source:69:1567> ;
    cpi:PART_OF_VERSION <urn:cpi:version:69> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v69:clause1567:r1:approval:0> ;
    cpi:requirement_text """The Risk Monitoring team provides daily dashboards to the CRM department, summarizing key portfolio metrics such as
exposure concentrations, rating migrations, and limit breaches."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v69:clause1567:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:69:1567> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

