    cpi:HAS_THRESHOLD <urn:cpi:rule:v54:clause349:r11:threshold:0> ;
    cpi:PART_OF_VERSION <urn:cpi:version:54> ;
    cpi:USES_METRIC <urn:cpi:riskmetric:8c3aa1836d27dec5acfd> ;
    cpi:requirement_text """Equity contributions may include cash, land (valued at no more than 50% of its appraised
value), or other unencumbered assets acceptable to the bank."""^^xsd:string ;
    cpi:rule_kind "QUANTITATIVE"^^xsd:string ;
