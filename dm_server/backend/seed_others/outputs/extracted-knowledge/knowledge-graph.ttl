<urn:cpi:rule:v69:clause1549:r1> a cpi:PolicyRule ;
    rdfs:label "Global Scope of Credit Rating Activities" ;
    cpi:APPLIES_IN <urn:cpi:geography:c47a2767fa3b44f46627> ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:24a661299ba3ba4cd0b5> ;
    cpi:DERIVED_FROM <urn:cpi:source:69:1549> ;
    cpi:PART_OF_VERSION <urn:cpi:version:69> ;
    cpi:requirement_text """The scope of RAT-1.0 Credit Rating Standards encompasses all credit rating activities conducted by the bank, including the
initial assignment, periodic review, and ad-hoc reassessment of ratings. This includes ratings for internal risk management
purposes as well as those used for regulatory reporting, such as under the Basel III framework. The policy is global in nature,
applying to all jurisdictions in which the bank operates, unless local regulations impose stricter requirements."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v69:clause1549:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:69:1549> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v69:clause1551:r3> a cpi:PolicyRule ;
    rdfs:label "Underwriter and Analyst Execution and Annual Training Requirement" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:9ec908f0bf2d80d3eebe>,
        <urn:cpi:policyclass:d9fec564d2da12d10ad5> ;
    cpi:DERIVED_FROM <urn:cpi:source:69:1551> ;
    cpi:PART_OF_VERSION <urn:cpi:version:69> ;
    cpi:requirement_text """Credit analysts and underwriters are responsible for the execution of the rating process, including the collection and analysis of
relevant data, the application of rating methodologies, and the documentation of rating rationales. These individuals must
possess the necessary qualifications and experience, as defined in the bank’s Competency Framework for Credit
Professionals. Analysts and underwriters are required to complete annual training on the RAT-1.0 standards and any updates
thereto."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v69:clause1551:r3"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:69:1551> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v69:clause1551:r4> a cpi:PolicyRule ;
    rdfs:label "Independent Risk Validation Oversight Responsibilities" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:9ec908f0bf2d80d3eebe>,
        <urn:cpi:policyclass:ad98f77b21b765d56232> ;
    cpi:DERIVED_FROM <urn:cpi:source:69:1551> ;
    cpi:PART_OF_VERSION <urn:cpi:version:69> ;
    cpi:requirement_text """The Independent Risk Validation (IRV) team plays a critical role in the governance framework by providing an independent
review of the credit rating process. The IRV team is responsible for validating the accuracy and consistency of ratings,
assessing the effectiveness of the rating methodologies, and identifying any potential biases or weaknesses in the process. The
IRV team reports its findings directly to the CRO and the Board’s Risk Committee, ensuring that any issues are addressed
promptly and transparently."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v69:clause1551:r4"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:69:1551> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v69:clause1567:r5> a cpi:PolicyRule ;
    rdfs:label "Annual Policy Review by CRM Department" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:ad98f77b21b765d56232> ;
    cpi:DERIVED_FROM <urn:cpi:source:69:1567> ;
    cpi:PART_OF_VERSION <urn:cpi:version:69> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v69:clause1567:r5:approval:0> ;
    cpi:requirement_text """The policy is reviewed at least annually by the CRM department, with input from the
IRV team, internal audit, and the business units."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v69:clause1567:r5"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:69:1567> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v72:clause1619:r2> a cpi:PolicyRule ;
    rdfs:label "Standard Credit Transaction Approval Delegation" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:9ec908f0bf2d80d3eebe> ;
    cpi:DERIVED_FROM <urn:cpi:source:72:1619> ;
    cpi:PART_OF_VERSION <urn:cpi:version:72> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v72:clause1619:r2:approval:0> ;
    cpi:requirement_text """For standard credit transactions that comply with the quantitative limits and underwriting criteria set forth in this Policy, approval
authority is delegated to the relevant business unit head or their designated proxy."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v72:clause1619:r2"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:72:1619> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v73:clause1633:r2> a cpi:PolicyRule ;
    rdfs:label "ALCO Quarterly Review Duty" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:9ec908f0bf2d80d3eebe>,
        <urn:cpi:policyclass:ad98f77b21b765d56232> ;
    cpi:DERIVED_FROM <urn:cpi:source:73:1633> ;
    cpi:PART_OF_VERSION <urn:cpi:version:73> ;
    cpi:requirement_text """It meets
quarterly to review liquidity risk exposures, assess the adequacy of liquidity buffers, and evaluate the Bank’s adherence to the
Policy’s thresholds and controls."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v73:clause1633:r2"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:73:1633> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v73:clause1635:r4> a cpi:PolicyRule ;
    rdfs:label "Collateral Liquidity Reassessment Frequency" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:ad98f77b21b765d56232>,
        <urn:cpi:policyclass:ebcd620636c948c2d6c5> ;
    cpi:DERIVED_FROM <urn:cpi:source:73:1635> ;
    cpi:PART_OF_VERSION <urn:cpi:version:73> ;
    cpi:requirement_text """The liquidity of collateral is reassessed at least annually or upon the occurrence of a material event,
such as a downgrade in the borrower’s credit rating or a change in market conditions."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v73:clause1635:r4"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:73:1635> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v73:clause1647:r1> a cpi:PolicyRule ;
    rdfs:label "CRO Annual Review of Policy" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:9ec908f0bf2d80d3eebe>,
        <urn:cpi:policyclass:ad98f77b21b765d56232> ;
    cpi:DERIVED_FROM <urn:cpi:source:73:1647> ;
    cpi:PART_OF_VERSION <urn:cpi:version:73> ;
    cpi:requirement_text "The CRO is responsible for initiating and overseeing the review of this Policy at least annually."^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v73:clause1647:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:73:1647> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

