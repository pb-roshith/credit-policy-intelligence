standard retail loans is set at 1.25x, meaning that the borrower's net operating income must be at least 1.25 times their total
debt service."""^^xsd:string ;
    cpi:rule_kind "QUANTITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v15:clause100:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:15:100> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

