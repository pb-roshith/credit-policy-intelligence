    cpi:CLASSIFIED_AS <urn:cpi:policyclass:9ec908f0bf2d80d3eebe> ;
    cpi:DERIVED_FROM <urn:cpi:source:59:553> ;
    cpi:PART_OF_VERSION <urn:cpi:version:59> ;
