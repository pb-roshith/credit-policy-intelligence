    cpi:DERIVED_FROM <urn:cpi:source:13:59> ;
    cpi:EVALUATES_RISK_ATTRIBUTE <urn:cpi:riskmetric:061447e63c40306cf34e> ;
    cpi:HAS_THRESHOLD <urn:cpi:rule:v13:clause59:r4:threshold:0> ;
    cpi:PART_OF_VERSION <urn:cpi:version:13> ;
    cpi:USES_METRIC <urn:cpi:riskmetric:061447e63c40306cf34e> ;
    cpi:requirement_text """In contrast, project
finance facilities may have longer tenors, up to 15 years, to align with the long-term nature of the underlying assets and cash
flows."""^^xsd:string ;
    cpi:rule_kind "QUANTITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v13:clause59:r4"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:13:59> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v13:clause61:r3> a cpi:PolicyRule ;
    rdfs:label "Revolving Credit Facilities Maximum Tenor Limit" ;
    cpi:APPLIES_TO_PRODUCT <urn:cpi:product:58c3008dad1b9a5cec7f> ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:51785e55a44e8ac3604c>,
