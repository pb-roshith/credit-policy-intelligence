    cpi:REQUIRES_EVIDENCE <urn:cpi:rule:v48:clause234:r1:evidence:0> ;
    cpi:requirement_text """Borrowers are required
to provide financial statements and other relevant data on a quarterly basis"""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v48:clause234:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:48:234> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v48:clause238:r2> a cpi:PolicyRule ;
    rdfs:label "Credit File Documentation Retention Requirement" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:a05a0a4f8c8c7ff19a51>,
        <urn:cpi:policyclass:e9df5184319d3db58971> ;
    cpi:DERIVED_FROM <urn:cpi:source:48:238> ;
    cpi:PART_OF_VERSION <urn:cpi:version:48> ;
    cpi:REQUIRES_EVIDENCE <urn:cpi:rule:v48:clause238:r2:evidence:0> ;
    cpi:requirement_text "The policy requires that all coverage ratio calculations and supporting documentation be retained in the borrower’s credit file."^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v48:clause238:r2"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:48:238> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v49:clause246:r1> a cpi:PolicyRule ;
    rdfs:label "Governance Oversight by Credit Risk Committee" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:9ec908f0bf2d80d3eebe>,
        <urn:cpi:policyclass:ad98f77b21b765d56232> ;
    cpi:DERIVED_FROM <urn:cpi:source:49:246> ;
    cpi:PART_OF_VERSION <urn:cpi:version:49> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v49:clause246:r1:approval:0> ;
    cpi:requirement_text """Governance for the Eligible Collateral clause is overseen by the bank’s Credit Risk Committee (CRC), which is responsible for
approving and periodically reviewing the policy to ensure its continued relevance and effectiveness."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v49:clause246:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:49:246> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v49:clause248:r1> a cpi:PolicyRule ;
    rdfs:label "Eligible Collateral Minimum Standards" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:ebcd620636c948c2d6c5>,
        <urn:cpi:policyclass:ef181960a2e7ddb709f2> ;
    cpi:CONCERNS <urn:cpi:policyconcern:a0148a51d610b28abff8> ;
    cpi:DERIVED_FROM <urn:cpi:source:49:248> ;
    cpi:PART_OF_VERSION <urn:cpi:version:49> ;
    cpi:requirement_text """Collateral must meet the bank’s minimum standards for creditworthiness, which include legal
ownership, absence of encumbrances, and compliance with regulatory requirements."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v49:clause248:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:49:248> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v49:clause248:r2> a cpi:PolicyRule ;
    rdfs:label "Real Estate Collateral Verification Requirements" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:7400994ea0b297e87025>,
        <urn:cpi:policyclass:ebcd620636c948c2d6c5> ;
    cpi:DERIVED_FROM <urn:cpi:source:49:248> ;
    cpi:HAS_CONDITION <urn:cpi:rule:v49:clause248:r2:logic:06f7c062ea9accd4> ;
    cpi:PART_OF_VERSION <urn:cpi:version:49> ;
    cpi:requirement_text """For real estate, this involves verifying
clear title, zoning compliance, and insurance coverage."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v49:clause248:r2"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:49:248> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v49:clause248:r4> a cpi:PolicyRule ;
    rdfs:label "Quarterly Review of Approved Asset Classes and Issuers by CMU" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:9ec908f0bf2d80d3eebe>,
        <urn:cpi:policyclass:ad98f77b21b765d56232> ;
    cpi:DERIVED_FROM <urn:cpi:source:49:248> ;
    cpi:PART_OF_VERSION <urn:cpi:version:49> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v49:clause248:r4:approval:0> ;
    cpi:requirement_text """The bank maintains a list of approved asset classes and issuers, which is reviewed and updated
quarterly by the CMU."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v49:clause248:r4"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:49:248> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v49:clause248:r5> a cpi:PolicyRule ;
    rdfs:label "Inventory Collateral Safeguard Requirements" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:ad98f77b21b765d56232>,
        <urn:cpi:policyclass:ebcd620636c948c2d6c5> ;
    cpi:DERIVED_FROM <urn:cpi:source:49:248> ;
    cpi:HAS_CONDITION <urn:cpi:rule:v49:clause248:r5:logic:c30f61baf2994834> ;
    cpi:PART_OF_VERSION <urn:cpi:version:49> ;
    cpi:requirement_text """For inventory, the bank requires that it be insured, stored in secure facilities, and subject to periodic physical
inspections."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v49:clause248:r5"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:49:248> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v49:clause248:r6> a cpi:PolicyRule ;
    rdfs:label "Accounts Receivable Counterparty and Dispute Criteria" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:ebcd620636c948c2d6c5>,
        <urn:cpi:policyclass:ef181960a2e7ddb709f2> ;
    cpi:DERIVED_FROM <urn:cpi:source:49:248> ;
    cpi:HAS_CONDITION <urn:cpi:rule:v49:clause248:r6:logic:1901074dddb85dc5> ;
    cpi:PART_OF_VERSION <urn:cpi:version:49> ;
    cpi:requirement_text "Accounts receivable must be from creditworthy counterparties and not subject to disputes or set-offs."^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v49:clause248:r6"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:49:248> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v49:clause250:r1> a cpi:PolicyRule ;
    rdfs:label "Collateral Haircut Annual Review Requirement" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:6446ca752576e05d10fc>,
        <urn:cpi:policyclass:ad98f77b21b765d56232>,
        <urn:cpi:policyclass:ebcd620636c948c2d6c5> ;
    cpi:DERIVED_FROM <urn:cpi:source:49:250> ;
    cpi:PART_OF_VERSION <urn:cpi:version:49> ;
    cpi:requirement_text """The haircut percentages are determined based on the asset class, liquidity, and historical volatility, and are reviewed annually
by the CMU."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v49:clause250:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:49:250> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v49:clause250:r6> a cpi:PolicyRule ;
    rdfs:label "CRC Approval Requirement for Quantitative Limit Changes" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:51785e55a44e8ac3604c>,
        <urn:cpi:policyclass:9ec908f0bf2d80d3eebe> ;
    cpi:DERIVED_FROM <urn:cpi:source:49:250> ;
    cpi:PART_OF_VERSION <urn:cpi:version:49> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v49:clause250:r6:approval:0> ;
    cpi:requirement_text "Any proposed changes to the limits must be approved by the CRC and documented in the policy."^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v49:clause250:r6"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:49:250> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v49:clause252:r1> a cpi:PolicyRule ;
    rdfs:label "Credit Officer Collateral Suitability Assessment and Documentation Duty" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:a05a0a4f8c8c7ff19a51>,
        <urn:cpi:policyclass:ebcd620636c948c2d6c5> ;
    cpi:DERIVED_FROM <urn:cpi:source:49:252> ;
    cpi:PART_OF_VERSION <urn:cpi:version:49> ;
    cpi:REQUIRES_EVIDENCE <urn:cpi:rule:v49:clause252:r1:evidence:0> ;
    cpi:requirement_text """The process begins with the credit officer, who is responsible for initially
assessing the collateral’s suitability and documenting the findings in the credit application."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v49:clause252:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:49:252> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v49:clause254:r2> a cpi:PolicyRule ;
    rdfs:label "Continuous Collateral Monitoring for Liquid Assets" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:ad98f77b21b765d56232>,
        <urn:cpi:policyclass:ebcd620636c948c2d6c5> ;
    cpi:DERIVED_FROM <urn:cpi:source:49:254> ;
    cpi:HAS_CONDITION <urn:cpi:rule:v49:clause254:r2:logic:2a4a3e650527157c> ;
    cpi:PART_OF_VERSION <urn:cpi:version:49> ;
    cpi:requirement_text """At the transaction level, collateral is monitored on a continuous basis for liquid assets, such as cash or publicly traded
securities"""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v49:clause254:r2"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:49:254> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v49:clause254:r3> a cpi:PolicyRule ;
    rdfs:label "Quarterly Collateral Monitoring for Less Liquid Assets" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:ad98f77b21b765d56232>,
        <urn:cpi:policyclass:ebcd620636c948c2d6c5> ;
    cpi:DERIVED_FROM <urn:cpi:source:49:254> ;
    cpi:HAS_CONDITION <urn:cpi:rule:v49:clause254:r3:logic:8bffdd0401c9e13f> ;
    cpi:PART_OF_VERSION <urn:cpi:version:49> ;
    cpi:requirement_text "and at least quarterly for less liquid assets, such as real estate or machinery."^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v49:clause254:r3"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:49:254> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v49:clause254:r9> a cpi:PolicyRule ;
    rdfs:label "Timely Resolution and Escalation of Monitoring Issues" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:9ec908f0bf2d80d3eebe>,
        <urn:cpi:policyclass:ad98f77b21b765d56232> ;
    cpi:DERIVED_FROM <urn:cpi:source:49:254> ;
    cpi:PART_OF_VERSION <urn:cpi:version:49> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v49:clause254:r9:approval:0> ;
    cpi:requirement_text """The CMU is responsible for ensuring that all identified issues are resolved in a timely
manner, with escalation to senior management as necessary."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v49:clause254:r9"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:49:254> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v49:clause256:r3> a cpi:PolicyRule ;
    rdfs:label "Initial Exception Review by Credit Officer Direct Manager" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:9ec908f0bf2d80d3eebe>,
        <urn:cpi:policyclass:acb66a8f8a7f374455cb> ;
    cpi:DERIVED_FROM <urn:cpi:source:49:256> ;
    cpi:PART_OF_VERSION <urn:cpi:version:49> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v49:clause256:r3:approval:0> ;
    cpi:requirement_text """The exception request is initially reviewed by the credit officer’s direct manager, who assesses the validity of the justification
and the completeness of the documentation."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v49:clause256:r3"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:49:256> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v49:clause256:r4> a cpi:PolicyRule ;
    rdfs:label "CMU Independent Assessment and Escalation Review" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:9ec908f0bf2d80d3eebe>,
        <urn:cpi:policyclass:acb66a8f8a7f374455cb> ;
    cpi:DERIVED_FROM <urn:cpi:source:49:256> ;
    cpi:PART_OF_VERSION <urn:cpi:version:49> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v49:clause256:r4:approval:0> ;
    cpi:requirement_text """If the manager approves, the request is escalated to the CMU for further
evaluation. The CMU conducts an independent assessment of the collateral’s suitability and the incremental risk posed by the
exception. This assessment includes a review of the borrower’s creditworthiness, the collateral’s valuation, and the proposed
monitoring plan."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v49:clause256:r4"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:49:256> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v49:clause256:r5> a cpi:PolicyRule ;
    rdfs:label "CRC Final Approval for Exceptions" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:9ec908f0bf2d80d3eebe>,
        <urn:cpi:policyclass:acb66a8f8a7f374455cb> ;
    cpi:DERIVED_FROM <urn:cpi:source:49:256> ;
    cpi:PART_OF_VERSION <urn:cpi:version:49> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v49:clause256:r5:approval:0> ;
    cpi:requirement_text """Final approval for exceptions rests with the CRC, which evaluates the request based on the bank’s risk appetite and the
potential impact on the overall credit portfolio."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v49:clause256:r5"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:49:256> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v49:clause256:r6> a cpi:PolicyRule ;
    rdfs:label "Board Approval Requirement for High Risk or Large Exposure Exceptions" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:9ec908f0bf2d80d3eebe>,
        <urn:cpi:policyclass:acb66a8f8a7f374455cb> ;
    cpi:DERIVED_FROM <urn:cpi:source:49:256> ;
    cpi:PART_OF_VERSION <urn:cpi:version:49> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v49:clause256:r6:approval:0> ;
    cpi:requirement_text """Exceptions that involve higher risk or larger exposures may require additional
approval from the Board."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v49:clause256:r6"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:49:256> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v49:clause256:r9> a cpi:PolicyRule ;
    rdfs:label "Reconsideration and Facility Unwinding Upon Condition Change" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:acb66a8f8a7f374455cb>,
        <urn:cpi:policyclass:ad98f77b21b765d56232>,
        <urn:cpi:policyclass:d6caed6e091003a7e73f> ;
    cpi:DERIVED_FROM <urn:cpi:source:49:256> ;
    cpi:PART_OF_VERSION <urn:cpi:version:49> ;
    cpi:requirement_text """If the conditions that justified the exception change, such as a deterioration in the collateral’s value or the borrower’s
creditworthiness, the exception must be reconsidered, and additional actions may be required, up to and including the
unwinding of the credit facility."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v49:clause256:r9"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:49:256> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v49:clause258:r5> a cpi:PolicyRule ;
    rdfs:label "Audit Archiving and Review of Reports" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:a05a0a4f8c8c7ff19a51>,
        <urn:cpi:policyclass:ad98f77b21b765d56232> ;
    cpi:DERIVED_FROM <urn:cpi:source:49:258> ;
    cpi:PART_OF_VERSION <urn:cpi:version:49> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v49:clause258:r5:approval:0> ;
    cpi:requirement_text """All reports are archived for audit purposes and are
subject to review by Internal Audit to ensure their accuracy and completeness."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v49:clause258:r5"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:49:258> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v49:clause260:r2> a cpi:PolicyRule ;
    rdfs:label "Oversight and Approval of Policy Changes by CRC" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:9ec908f0bf2d80d3eebe>,
        <urn:cpi:policyclass:ad98f77b21b765d56232> ;
    cpi:DERIVED_FROM <urn:cpi:source:49:260> ;
    cpi:PART_OF_VERSION <urn:cpi:version:49> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v49:clause260:r2:approval:0> ;
    cpi:requirement_text """The review process is overseen by the CRC, which is responsible for
approving any changes to the policy."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v49:clause260:r2"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:49:260> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v49:clause260:r3> a cpi:PolicyRule ;
    rdfs:label "Policy Performance Assessment by CMU" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:9ec908f0bf2d80d3eebe>,
        <urn:cpi:policyclass:ad98f77b21b765d56232> ;
    cpi:DERIVED_FROM <urn:cpi:source:49:260> ;
    cpi:PART_OF_VERSION <urn:cpi:version:49> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v49:clause260:r3:approval:0> ;
    cpi:requirement_text "The review process begins with an assessment of the policy’s performance, conducted by the CMU."^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v49:clause260:r3"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:49:260> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v49:clause260:r4> a cpi:PolicyRule ;
    rdfs:label "Implementation of Approved Changes by CMU" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:0ece0168920195848ef3>,
        <urn:cpi:policyclass:9ec908f0bf2d80d3eebe> ;
    cpi:DERIVED_FROM <urn:cpi:source:49:260> ;
    cpi:PART_OF_VERSION <urn:cpi:version:49> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v49:clause260:r4:approval:0> ;
    cpi:requirement_text """Once approved, the
changes are implemented by the CMU, and the updated policy is communicated to all relevant stakeholders."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v49:clause260:r4"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:49:260> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v50:clause264:r2> a cpi:PolicyRule ;
    rdfs:label "Technology Platform Configuration Requirement" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:24a661299ba3ba4cd0b5>,
        <urn:cpi:policyclass:45b84dd2dfe7afa3a554> ;
    cpi:CONCERNS <urn:cpi:policyconcern:a0148a51d610b28abff8> ;
    cpi:DERIVED_FROM <urn:cpi:source:50:264> ;
    cpi:PART_OF_VERSION <urn:cpi:version:50> ;
    cpi:requirement_text """All technology platforms, including
collateral management systems and risk engines, must be configured to apply the haircuts as defined in this policy."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v50:clause264:r2"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:50:264> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v51:clause288:r1> a cpi:PolicyRule ;
    rdfs:label "RAROC Methodology and Calculation Formula" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:45ab6cdf3797ff377d88>,
        <urn:cpi:policyclass:7e60fa643430dc8c9ecc> ;
    cpi:CONCERNS <urn:cpi:policyconcern:bd3f2db41963c5ad0767> ;
    cpi:DERIVED_FROM <urn:cpi:source:51:288> ;
    cpi:PART_OF_VERSION <urn:cpi:version:51> ;
    cpi:requirement_text """4. 4. RAROC Methodology and Calculation
The RAROC for each credit exposure is calculated using the bank’s internal economic profit model, which adjusts nominal
returns for risk, cost of capital, and operational expenses. The formula for RAROC is defined as: RAROC = (Risk-Adjusted
Revenue - Expected Loss - Operating Costs) / Economic Capital. Risk-Adjusted Revenue reflects the net interest income and
fees associated with the exposure, adjusted for credit spreads and other risk premiums.
Economic Capital is determined using the bank’s internal capital allocation model, which assigns capital to each exposure
based on its risk characteristics, including probability of default (PD), loss given default (LGD), and exposure at default (EAD).
The model incorporates both systematic and idiosyncratic risk factors and is calibrated to a 99.9% confidence interval over a
one-year horizon, in line with Basel III standards.
Expected Loss is calculated as the product of PD, LGD, and EAD, representing the average annual loss expected from the
exposure. Operating Costs include all direct and indirect expenses associated with originating, servicing, and monitoring the
credit exposure, such as underwriting fees, legal costs, and administrative overhead. These costs are allocated to individual
exposures based on their complexity and resource requirements.
The bank employs a tiered RAROC floor structure, with minimum thresholds varying by asset class, risk rating, and tenure. For
example, investment-grade corporate exposures are subject to a minimum RAROC floor of 12%, while sub-investment-grade
exposures require a floor of 18%. Commercial real estate exposures are assigned a floor of 15%, reflecting their higher volatility
and illiquidity risk. These thresholds are reviewed annually by the CPC and adjusted based on changes in the bank’s cost of
capital, risk appetite, or market conditions.
All RAROC calculations must be performed using the bank’s approved modeling tools and validated by the CRM department.
Manual overrides or adjustments to the model inputs are prohibited unless explicitly approved by the CRO. The methodology
and assumptions underlying the RAROC calculations are documented in the bank’s Model Risk Management Policy, which is
referenced in this document."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v51:clause288:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:51:288> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v52:clause305:r5> a cpi:PolicyRule ;
    rdfs:label "Geographic Scope and Harmonization" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:24a661299ba3ba4cd0b5>,
        <urn:cpi:policyclass:9ec908f0bf2d80d3eebe> ;
    cpi:DERIVED_FROM <urn:cpi:source:52:305> ;
    cpi:PART_OF_VERSION <urn:cpi:version:52> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v52:clause305:r5:approval:0> ;
    cpi:requirement_text """Geographically, this policy is applicable to all jurisdictions in which the bank operates, unless local regulations or market
practices explicitly conflict with its provisions. In such cases, local credit policies must be harmonized with this Spread Grid to
the greatest extent possible, and any deviations must be documented and approved by the Group Risk Committee."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v52:clause305:r5"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:52:305> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v53:clause333:r1> a cpi:PolicyRule ;
    rdfs:label "Loan Approval Authority Up To 5 Million" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:9357aa360ca9e8840c5b>,
        <urn:cpi:policyclass:9ec908f0bf2d80d3eebe> ;
    cpi:DERIVED_FROM <urn:cpi:source:53:333> ;
    cpi:PART_OF_VERSION <urn:cpi:version:53> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v53:clause333:r1:approval:0> ;
    cpi:requirement_text """Loans with an outstanding balance of up to $5 million may be approved by a designated CRE Underwriting Manager, provided
they comply with all policy criteria, including sub-sector limits."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v53:clause333:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:53:333> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v53:clause333:r2> a cpi:PolicyRule ;
    rdfs:label "Loan Approval Authority Between 5 Million and 20 Million" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:9357aa360ca9e8840c5b>,
        <urn:cpi:policyclass:9ec908f0bf2d80d3eebe> ;
    cpi:DERIVED_FROM <urn:cpi:source:53:333> ;
    cpi:PART_OF_VERSION <urn:cpi:version:53> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v53:clause333:r2:approval:0> ;
    cpi:requirement_text """Loans between $5 million and $20 million require approval from
the Regional Credit Officer (RCO),"""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v53:clause333:r2"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:53:333> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v54:clause349:r13> a cpi:PolicyRule ;
    rdfs:label "Mandatory Feasibility Study Submission" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:a05a0a4f8c8c7ff19a51>,
        <urn:cpi:policyclass:e9df5184319d3db58971> ;
    cpi:DERIVED_FROM <urn:cpi:source:54:349> ;
    cpi:PART_OF_VERSION <urn:cpi:version:54> ;
    cpi:REQUIRES_EVIDENCE <urn:cpi:rule:v54:clause349:r13:evidence:0> ;
    cpi:requirement_text """A comprehensive feasibility study must be submitted as part of the loan application, prepared by an independent third-party
consultant approved by the bank."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v54:clause349:r13"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:54:349> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v54:clause355:r1> a cpi:PolicyRule ;
    rdfs:label "Mandatory Monthly Borrower Progress Reports" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:ad98f77b21b765d56232>,
        <urn:cpi:policyclass:e9df5184319d3db58971> ;
    cpi:DERIVED_FROM <urn:cpi:source:54:355> ;
    cpi:PART_OF_VERSION <urn:cpi:version:54> ;
    cpi:REQUIRES_EVIDENCE <urn:cpi:rule:v54:clause355:r1:evidence:0> ;
    cpi:requirement_text """The bank requires
monthly progress reports from the borrower, which must include updated construction budgets, disbursement requests, and
milestone achievements."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v54:clause355:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:54:355> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v56:clause385:r4> a cpi:PolicyRule ;
    rdfs:label "Qualitative Escalation Triggers for Complex Structures and Standard Covenant Breaches" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:9ec908f0bf2d80d3eebe>,
        <urn:cpi:policyclass:acb66a8f8a7f374455cb> ;
    cpi:DERIVED_FROM <urn:cpi:source:56:385> ;
    cpi:PART_OF_VERSION <urn:cpi:version:56> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v56:clause385:r4:approval:0> ;
    cpi:requirement_text """Qualitative triggers for escalation include transactions involving complex structures, such as multi-jurisdictional collateral
arrangements or non-standard covenants. Escalation is also required for transactions where the borrower’s financial metrics
(e.g., leverage ratios, interest coverage) fall outside the bank’s standard underwriting tolerances by more than 20%.
Furthermore, any request for a waiver of standard credit terms, such as maturity extensions or covenant relief, must be
escalated to the appropriate authority level."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v56:clause385:r4"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:56:385> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v56:clause385:r5> a cpi:PolicyRule ;
    rdfs:label "Escalation for Rapid Risk Rating Downgrades" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:ad98f77b21b765d56232>,
        <urn:cpi:policyclass:dbee7b1fa11fe46b26ed> ;
    cpi:DERIVED_FROM <urn:cpi:source:56:385> ;
    cpi:PART_OF_VERSION <urn:cpi:version:56> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v56:clause385:r5:approval:0> ;
    cpi:requirement_text """For example, if a borrower’s credit quality deteriorates
such that its risk rating drops by two or more notches within a 12-month period, the relationship manager must escalate the
case to the Portfolio Risk Manager for review."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v56:clause385:r5"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:56:385> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v57:clause422:r1> a cpi:PolicyRule ;
    rdfs:label "Comprehensive Annual Policy Review by Credit Risk Department" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:ad98f77b21b765d56232> ;
    cpi:DERIVED_FROM <urn:cpi:source:57:422> ;
    cpi:PART_OF_VERSION <urn:cpi:version:57> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v57:clause422:r1:approval:0>,
        <urn:cpi:rule:v57:clause422:r1:approval:1> ;
    cpi:requirement_text """The policy mandates that a comprehensive review be conducted at least annually,
with the involvement of the Credit Risk Department (CRD), the Risk Management Committee (RMC), and other relevant
stakeholders."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v57:clause422:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:57:422> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v57:clause422:r2> a cpi:PolicyRule ;
    rdfs:label "Submission of Review Report to Risk Management Committee and Board of Directors" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:9ec908f0bf2d80d3eebe> ;
    cpi:DERIVED_FROM <urn:cpi:source:57:422> ;
    cpi:PART_OF_VERSION <urn:cpi:version:57> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v57:clause422:r2:approval:0>,
        <urn:cpi:rule:v57:clause422:r2:approval:1> ;
    cpi:requirement_text """The review
report is submitted to the RMC for approval, and any proposed amendments are presented to the Board of Directors for final
approval."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v57:clause422:r2"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:57:422> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v59:clause488:r1> a cpi:PolicyRule ;
