<urn:cpi:version:51> a cpi:PolicyVersion ;
    rdfs:label "1.1 RAROC Floors v1.7" ;
    cpi:CONTAINS_SECTION <urn:cpi:section:4d33871fa7b165b3738b9101>,
        <urn:cpi:section:505611d8d6875e292e1bc9b4>,
