<urn:cpi:rule:v13:clause57:r3> a cpi:PolicyRule ;
    rdfs:label "Tenor Limit Officer Designation Duty" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:9ec908f0bf2d80d3eebe> ;
    cpi:DERIVED_FROM <urn:cpi:source:13:57> ;
    cpi:PART_OF_VERSION <urn:cpi:version:13> ;
    cpi:requirement_text """Business units are required to designate a Tenor Limit Officer (TLO) who will serve as the primary point of contact for all
matters related to this clause."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v13:clause57:r3"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:13:57> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v13:clause69:r1> a cpi:PolicyRule ;
    rdfs:label "CRM Monthly Tenor Limit Compliance Report Duty" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:08301552b025a4c29694> ;
    cpi:DERIVED_FROM <urn:cpi:source:13:69> ;
    cpi:PART_OF_VERSION <urn:cpi:version:13> ;
    cpi:requirement_text """CRM is responsible for preparing and distributing a monthly Tenor Limit Compliance Report, which provides a summary of all
new credit facilities approved during the month, including their tenors, borrower credit ratings, and any exceptions granted."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v13:clause69:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:13:69> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v13:clause69:r3> a cpi:PolicyRule ;
    rdfs:label "Business Unit Monthly Tenor Monitoring Report Duty" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:08301552b025a4c29694> ;
    cpi:DERIVED_FROM <urn:cpi:source:13:69> ;
    cpi:PART_OF_VERSION <urn:cpi:version:13> ;
    cpi:requirement_text """Business units are required to prepare and submit a monthly Tenor Monitoring Report to CRM, detailing the status of all credit
facilities within their portfolios"""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v13:clause69:r3"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:13:69> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v15:clause104:r3:approval:0> a cpi:ApprovalRequirement ;
    rdfs:label "APPROVAL by credit manager or higher authority" ;
    cpi:REQUIRES_APPROVAL_FROM <urn:cpi:approvalauthority:779087ee8a8e5f03fead> ;
    cpi:decision_type "APPROVAL"^^xsd:string ;
    cpi:notes "credit manager or higher authority"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:15:104> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v15:clause106:r1> a cpi:PolicyRule ;
    rdfs:label "Pre-Funding Review Monitoring Requirement" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:ad98f77b21b765d56232> ;
    cpi:DERIVED_FROM <urn:cpi:source:15:106> ;
    cpi:PART_OF_VERSION <urn:cpi:version:15> ;
    cpi:requirement_text """For new loans, the
Underwriting Standards Team conducts a pre-funding review to verify that the DSCR calculation and approval are in
accordance with this clause."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v15:clause106:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:15:106> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v15:clause106:r2> a cpi:PolicyRule ;
    rdfs:label "Quarterly Portfolio Review Monitoring Requirement" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:ad98f77b21b765d56232> ;
    cpi:DERIVED_FROM <urn:cpi:source:15:106> ;
    cpi:PART_OF_VERSION <urn:cpi:version:15> ;
    cpi:requirement_text """For existing portfolios, the bank's Credit Monitoring Team conducts quarterly reviews to assess ongoing compliance with DSCR
minimums."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v15:clause106:r2"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:15:106> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v15:clause110:r1> a cpi:PolicyRule ;
    rdfs:label "Underwriting Standards Team Monthly DSCR Report" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:08301552b025a4c29694> ;
    cpi:DERIVED_FROM <urn:cpi:source:15:110> ;
    cpi:PART_OF_VERSION <urn:cpi:version:15> ;
    cpi:requirement_text """The
Underwriting Standards Team is responsible for generating a monthly report that details the number and value of new loans
approved with a DSCR at or above the minimum threshold, as well as those approved with exceptions."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v15:clause110:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:15:110> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v15:clause112:r1> a cpi:PolicyRule ;
    rdfs:label "Annual Review of DSCR Minimums" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:ad98f77b21b765d56232> ;
    cpi:DERIVED_FROM <urn:cpi:source:15:112> ;
    cpi:PART_OF_VERSION <urn:cpi:version:15> ;
    cpi:requirement_text """This clause, '3.1 DSCR Minimums,' is subject to an annual review to ensure it remains aligned with the bank's risk appetite,
regulatory expectations, and industry best practices."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v15:clause112:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:15:112> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v15:clause96:r7> a cpi:PolicyRule ;
    rdfs:label "Legal and Regulatory Requirements Precedence" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:24a661299ba3ba4cd0b5> ;
    cpi:DERIVED_FROM <urn:cpi:source:15:96> ;
    cpi:PART_OF_VERSION <urn:cpi:version:15> ;
    cpi:requirement_text "This clause does not override any legal or regulatory requirements that may impose stricter DSCR thresholds."^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v15:clause96:r7"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:15:96> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v15:clause98:r5> a cpi:PolicyRule ;
    rdfs:label "Annual Employee Training Requirement" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:d9fec564d2da12d10ad5> ;
    cpi:DERIVED_FROM <urn:cpi:source:15:98> ;
    cpi:PART_OF_VERSION <urn:cpi:version:15> ;
    cpi:requirement_text """All employees involved in the retail credit process are required to complete annual training on this clause and the parent policy
CP-Retail-v3.1."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v15:clause98:r5"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:15:98> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v1:clause20:r3> a cpi:PolicyRule ;
    rdfs:label "Required Analysis Elements in Policy Review" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:ad98f77b21b765d56232> ;
    cpi:DERIVED_FROM <urn:cpi:source:1:20> ;
    cpi:PART_OF_VERSION <urn:cpi:version:1> ;
    cpi:requirement_text """The review must include an analysis of credit quality trends, the
frequency and nature of exceptions, and feedback from business lines and independent review functions."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v1:clause20:r3"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:1:20> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v1:clause20:r5> a cpi:PolicyRule ;
    rdfs:label "Ad Hoc Policy Updates Approval Process" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:9ec908f0bf2d80d3eebe> ;
    cpi:DERIVED_FROM <urn:cpi:source:1:20> ;
    cpi:PART_OF_VERSION <urn:cpi:version:1> ;
    cpi:requirement_text """All ad hoc updates must follow the same
approval and communication process as the annual review."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v1:clause20:r5"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:1:20> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v1:clause8:r1:logic:25cf3a4d27c5d490:c:1> a cpi:Condition ;
    rdfs:label "customer_segment IN ['Tier 1', 'Tier 2'] " ;
    cpi:COMPARES_SCOPE_VALUE <urn:cpi:customersegment:6286169df196940d9f62>,
        <urn:cpi:customersegment:79b116a28eaa8c613d87> ;
    cpi:TESTS_ATTRIBUTE <urn:cpi:dataattribute:b49776e21d9a3df3829a> ;
    cpi:field "customer_segment"^^xsd:string ;
    cpi:operator "IN"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:1:8> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true ;
    cpi:value ( "Tier 1"^^xsd:string "Tier 2"^^xsd:string ) .

<urn:cpi:rule:v21:clause121:r2> a cpi:PolicyRule ;
    rdfs:label "Jurisdictional Stricter LTV Precedence" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:24a661299ba3ba4cd0b5> ;
    cpi:DERIVED_FROM <urn:cpi:source:21:121> ;
    cpi:PART_OF_VERSION <urn:cpi:version:21> ;
    cpi:requirement_text """The
scope encompasses all jurisdictions where the bank operates, unless local regulations impose stricter LTV requirements, in
which case the more stringent rule prevails."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v21:clause121:r2"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:21:121> ;
