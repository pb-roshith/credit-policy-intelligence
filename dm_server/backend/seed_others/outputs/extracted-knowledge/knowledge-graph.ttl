<urn:cpi:rule:v13:clause53:r1> a cpi:PolicyRule ;
    rdfs:label "Wholesale Credit Exposure Tenor Limit Framework Applicability" ;
    cpi:APPLIES_TO_PRODUCT <urn:cpi:product:1a3715f42225acf17c1c>,
        <urn:cpi:product:58c3008dad1b9a5cec7f>,
        <urn:cpi:product:9b9474bbfc4a6c9026bf>,
        <urn:cpi:product:d8e9978cf021fc66526b> ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:24a661299ba3ba4cd0b5>,
        <urn:cpi:policyclass:710d37ea2613a714b46c> ;
    cpi:DERIVED_FROM <urn:cpi:source:13:53> ;
    cpi:PART_OF_VERSION <urn:cpi:version:13> ;
    cpi:requirement_text """The tenor limits defined in this clause are applicable to all wholesale credit exposures, including but not limited to term loans,
revolving credit facilities, letters of credit, and other forms of committed and uncommitted credit."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v13:clause53:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:13:53> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

