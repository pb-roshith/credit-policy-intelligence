    cpi:sourceRef <urn:cpi:source:56:392> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v58:clause432:r2> a cpi:PolicyRule ;
    rdfs:label "CET1 Capital Ratio First Trigger" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:12dd37f00537bc6583b3>,
