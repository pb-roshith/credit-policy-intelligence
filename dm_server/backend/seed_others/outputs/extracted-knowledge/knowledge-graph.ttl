    cpi:status "APPROVED" ;
    cpi:synthetic true ;
    cpi:text "Before production use, replace synthetic roles, formulas, criteria, thresholds, legal references and frequencies with approved values. Changes require impact assessment, approval, versioning, testing, communication and retrieval-index update. Superseded versions remain auditable but shall not be retrieved as current."^^xsd:string ;
