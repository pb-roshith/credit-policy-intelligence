<urn:cpi:rule:v37:clause181:r5> a cpi:PolicyRule ;
    rdfs:label "Dynamic Buffer Mechanism - Portfolio Growth Reduction" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:51785e55a44e8ac3604c>,
        <urn:cpi:policyclass:ae6a67c0bab119d96d75> ;
    cpi:DERIVED_FROM <urn:cpi:source:37:181> ;
    cpi:EVALUATES_RISK_ATTRIBUTE <urn:cpi:riskmetric:a3fb75e835165cd0fc58> ;
    cpi:HAS_THRESHOLD <urn:cpi:rule:v37:clause181:r5:threshold:0> ;
    cpi:PART_OF_VERSION <urn:cpi:version:37> ;
    cpi:USES_METRIC <urn:cpi:riskmetric:a3fb75e835165cd0fc58> ;
    cpi:requirement_text """The Policy also includes a Dynamic Buffer Mechanism, which automatically reduces the SEL, IEL, and SIEL by 20% if the
bank’s total credit portfolio grows by more than 10% in a single quarter."""^^xsd:string ;
    cpi:rule_kind "QUANTITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v37:clause181:r5"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:37:181> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v37:clause181:r6> a cpi:PolicyRule ;
    rdfs:label "Dynamic Buffer Mechanism - Portfolio Contraction Increase" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:51785e55a44e8ac3604c>,
        <urn:cpi:policyclass:ae6a67c0bab119d96d75> ;
    cpi:DERIVED_FROM <urn:cpi:source:37:181> ;
