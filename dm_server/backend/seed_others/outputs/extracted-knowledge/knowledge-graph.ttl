    cpi:PART_OF_VERSION <urn:cpi:version:69> ;
    cpi:requirement_text """The applicability of RAT-1.0 extends to all credit exposures, including but not limited to loans, bonds, derivatives, and trade
finance instruments. It covers both new credit applications and the periodic review of existing exposures."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v69:clause1547:r5"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:69:1547> ;
