    cpi:DERIVED_FROM <urn:cpi:source:13:61> ;
    cpi:EVALUATES_RISK_ATTRIBUTE <urn:cpi:riskmetric:061447e63c40306cf34e> ;
    cpi:HAS_THRESHOLD <urn:cpi:rule:v13:clause61:r3:threshold:0> ;
    cpi:PART_OF_VERSION <urn:cpi:version:13> ;
    cpi:USES_METRIC <urn:cpi:riskmetric:061447e63c40306cf34e> ;
    cpi:requirement_text "Revolving credit facilities are subject to a maximum tenor of 5 years, regardless of the borrower’s credit rating."^^xsd:string ;
    cpi:rule_kind "QUANTITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v13:clause61:r3"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:13:61> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v13:clause61:r5> a cpi:PolicyRule ;
    rdfs:label "Long-Term Trade Finance Transactions Maximum Tenor Limit" ;
    cpi:APPLIES_TO_PRODUCT <urn:cpi:product:ad7b54d1ada4fbf8a948> ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:51785e55a44e8ac3604c>,
        <urn:cpi:policyclass:710d37ea2613a714b46c> ;
    cpi:DERIVED_FROM <urn:cpi:source:13:61> ;
    cpi:EVALUATES_RISK_ATTRIBUTE <urn:cpi:riskmetric:061447e63c40306cf34e> ;
    cpi:HAS_THRESHOLD <urn:cpi:rule:v13:clause61:r5:threshold:0> ;
    cpi:PART_OF_VERSION <urn:cpi:version:13> ;
    cpi:USES_METRIC <urn:cpi:riskmetric:061447e63c40306cf34e> ;
    cpi:requirement_text """However, for long-term trade finance transactions, such as those supporting infrastructure projects, the tenor may be extended
up to 5 years, provided that the underlying transaction is supported by robust cash flows and adequate collateral."""^^xsd:string ;
    cpi:rule_kind "QUANTITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v13:clause61:r5"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:13:61> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

