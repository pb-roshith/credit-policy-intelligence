    cpi:PART_OF_VERSION <urn:cpi:version:54> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v54:clause353:r2:approval:0>,
        <urn:cpi:rule:v54:clause353:r2:approval:1> ;
    cpi:USES_METRIC <urn:cpi:riskmetric:277f3f2f32aadd44247c> ;
    cpi:requirement_text """Loans between $5 million and $10 million require approval from the
Regional Credit Officer (RCO) in addition to the Relationship Manager."""^^xsd:string ;
    cpi:rule_kind "QUANTITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v54:clause353:r2"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:54:353> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v55:clause369:r2> a cpi:PolicyRule ;
    rdfs:label "Maximum LTV for Secured Transactions" ;
    cpi:APPLIES_TO_PRODUCT <urn:cpi:product:ad5aded57951613863b5> ;
    cpi:APPLIES_TO_SEGMENT <urn:cpi:customersegment:c07e778f63017a1d3244> ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:51785e55a44e8ac3604c>,
        <urn:cpi:policyclass:fc966078f763f57e4193> ;
    cpi:CONCERNS <urn:cpi:policyconcern:a0148a51d610b28abff8> ;
    cpi:DERIVED_FROM <urn:cpi:source:55:369> ;
    cpi:EVALUATES_RISK_ATTRIBUTE <urn:cpi:riskmetric:8a97dfb03e0af1b3eb73> ;
    cpi:HAS_THRESHOLD <urn:cpi:rule:v55:clause369:r2:threshold:0> ;
    cpi:PART_OF_VERSION <urn:cpi:version:55> ;
    cpi:USES_METRIC <urn:cpi:riskmetric:8a97dfb03e0af1b3eb73> ;
    cpi:requirement_text "and a loan-to-value (LTV) ratio not exceeding 70% for secured transactions."^^xsd:string ;
    cpi:rule_kind "QUANTITATIVE"^^xsd:string ;
