    cpi:sourceRef <urn:cpi:source:59:526> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v59:clause529:r1> a cpi:PolicyRule ;
    rdfs:label "Recordkeeping and Audit Trail Retention Requirements" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:a05a0a4f8c8c7ff19a51> ;
    cpi:DERIVED_FROM <urn:cpi:source:59:529> ;
