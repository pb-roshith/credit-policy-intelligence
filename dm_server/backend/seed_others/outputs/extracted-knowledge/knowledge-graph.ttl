<urn:cpi:rule:v13:clause55:r2> a cpi:PolicyRule ;
    rdfs:label "Wholesale Tenor Limits Business Unit Compliance Binding" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:24a661299ba3ba4cd0b5>,
        <urn:cpi:policyclass:710d37ea2613a714b46c> ;
    cpi:DERIVED_FROM <urn:cpi:source:13:55> ;
    cpi:PART_OF_VERSION <urn:cpi:version:13> ;
    cpi:requirement_text """The policy is binding on all business units, including Corporate Banking, Investment Banking, Trade Finance, and Treasury, as
well as support functions such as Risk Management, Compliance, and Internal Audit. Each unit is responsible for ensuring that
its activities comply with the tenor limits and procedures outlined in this clause."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v13:clause55:r2"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:13:55> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v13:clause57:r2> a cpi:PolicyRule ;
    rdfs:label "Business Unit Tenor Limit Officer Designation Requirement" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:710d37ea2613a714b46c>,
        <urn:cpi:policyclass:9ec908f0bf2d80d3eebe> ;
    cpi:DERIVED_FROM <urn:cpi:source:13:57> ;
    cpi:PART_OF_VERSION <urn:cpi:version:13> ;
    cpi:requirement_text """Business units are required to designate a Tenor Limit Officer (TLO) who will serve as the primary point of contact for all
matters related to this clause."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v13:clause57:r2"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:13:57> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v13:clause59:r5> a cpi:PolicyRule ;
    rdfs:label "Underwriter Financial Servicing Analysis Duty" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:710d37ea2613a714b46c>,
        <urn:cpi:policyclass:ef181960a2e7ddb709f2> ;
    cpi:DERIVED_FROM <urn:cpi:source:13:59> ;
    cpi:PART_OF_VERSION <urn:cpi:version:13> ;
    cpi:requirement_text "Underwriters are required to conduct a thorough analysis of the borrower’s ability to service debt over the proposed tenor."^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v13:clause59:r5"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:13:59> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v13:clause65:r1> a cpi:PolicyRule ;
    rdfs:label "CRM Monthly New Facility Monitoring Duty" ;
    cpi:APPLIES_TO_PRODUCT <urn:cpi:product:bf16e19bd210661a711d> ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:ad98f77b21b765d56232> ;
    cpi:DERIVED_FROM <urn:cpi:source:13:65> ;
    cpi:PART_OF_VERSION <urn:cpi:version:13> ;
    cpi:requirement_text """CRM conducts monthly reviews of new credit facilities to verify that they adhere to the approved
tenor limits and that any exceptions have been properly documented and approved."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v13:clause65:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:13:65> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v13:clause65:r2> a cpi:PolicyRule ;
    rdfs:label "CRM Quarterly Aggregate Tenor Exposure Reviews" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:710d37ea2613a714b46c>,
        <urn:cpi:policyclass:ad98f77b21b765d56232> ;
    cpi:DERIVED_FROM <urn:cpi:source:13:65> ;
    cpi:PART_OF_VERSION <urn:cpi:version:13> ;
    cpi:requirement_text """In addition to compliance monitoring, CRM conducts quarterly reviews of the bank’s aggregate tenor exposure to assess
whether the portfolio remains within the established limits."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v13:clause65:r2"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:13:65> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v13:clause65:r4> a cpi:PolicyRule ;
    rdfs:label "Mature Facility Advance Review Requirement" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:710d37ea2613a714b46c>,
        <urn:cpi:policyclass:ad98f77b21b765d56232> ;
    cpi:DERIVED_FROM <urn:cpi:source:13:65> ;
    cpi:PART_OF_VERSION <urn:cpi:version:13> ;
    cpi:requirement_text """Any facilities approaching their maturity date must be reviewed at least 12
months in advance to determine whether they should be renewed, restructured, or allowed to mature."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v13:clause65:r4"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:13:65> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v13:clause67:r1> a cpi:PolicyRule ;
    rdfs:label "Tenor Limit Exception Documentation and Monitoring Mandate" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:acb66a8f8a7f374455cb>,
        <urn:cpi:policyclass:ad98f77b21b765d56232> ;
    cpi:DERIVED_FROM <urn:cpi:source:13:67> ;
    cpi:PART_OF_VERSION <urn:cpi:version:13> ;
    cpi:requirement_text """All exceptions must be
documented, approved by the appropriate authority, and subject to enhanced monitoring and reporting."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v13:clause67:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:13:67> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v13:clause69:r2> a cpi:PolicyRule ;
    rdfs:label "Quarterly Tenor Risk Exposure Report Preparation Responsibility" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:08301552b025a4c29694>,
        <urn:cpi:policyclass:710d37ea2613a714b46c> ;
    cpi:DERIVED_FROM <urn:cpi:source:13:69> ;
    cpi:PART_OF_VERSION <urn:cpi:version:13> ;
    cpi:requirement_text """In addition to the monthly compliance report, CRM prepares a quarterly Tenor Risk Exposure Report, which provides a
comprehensive analysis of the bank’s aggregate tenor exposure."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v13:clause69:r2"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:13:69> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v13:clause71:r1> a cpi:PolicyRule ;
    rdfs:label "CRM Annual Policy Review Responsibility" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:710d37ea2613a714b46c>,
        <urn:cpi:policyclass:ad98f77b21b765d56232> ;
    cpi:DERIVED_FROM <urn:cpi:source:13:71> ;
    cpi:PART_OF_VERSION <urn:cpi:version:13> ;
    cpi:requirement_text "The policy is reviewed annually by CRM, in consultation with the business units, Compliance, and Internal Audit."^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v13:clause71:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:13:71> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v15:clause100:r4> a cpi:PolicyRule ;
    rdfs:label "Mandatory Approved Financial Analysis Tools Requirement" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:45b84dd2dfe7afa3a554>,
        <urn:cpi:policyclass:a05a0a4f8c8c7ff19a51> ;
    cpi:DERIVED_FROM <urn:cpi:source:15:100> ;
    cpi:PART_OF_VERSION <urn:cpi:version:15> ;
    cpi:requirement_text """Underwriters are required to use the bank's approved financial analysis tools to calculate DSCR. These tools automatically pull
income and debt data from the borrower's application, credit report, and other verified sources."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v15:clause100:r4"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:15:100> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v15:clause100:r6> a cpi:PolicyRule ;
    rdfs:label "Underwriting Qualitative Factors Evaluation" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:ef181960a2e7ddb709f2>,
        <urn:cpi:policyclass:f47f1f14ecf0186aeb10> ;
    cpi:DERIVED_FROM <urn:cpi:source:15:100> ;
    cpi:PART_OF_VERSION <urn:cpi:version:15> ;
    cpi:requirement_text """In addition to the DSCR calculation, underwriters must consider the borrower's debt-to-income (DTI) ratio, employment stability,
and other qualitative factors."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v15:clause100:r6"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:15:100> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v15:clause104:r5> a cpi:PolicyRule ;
    rdfs:label "Prohibition of Approval for Loans Below Hard Floor" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:51785e55a44e8ac3604c>,
        <urn:cpi:policyclass:9ec908f0bf2d80d3eebe> ;
    cpi:DERIVED_FROM <urn:cpi:source:15:104> ;
    cpi:PART_OF_VERSION <urn:cpi:version:15> ;
    cpi:requirement_text "Loans with a DSCR below the hard floor of 1.00x are not eligible for approval under any circumstances."^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v15:clause104:r5"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:15:104> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v15:clause108:r5> a cpi:PolicyRule ;
    rdfs:label "Enhanced Monitoring for Exception Borrowers" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:acb66a8f8a7f374455cb>,
        <urn:cpi:policyclass:ad98f77b21b765d56232> ;
    cpi:DERIVED_FROM <urn:cpi:source:15:108> ;
    cpi:PART_OF_VERSION <urn:cpi:version:15> ;
    cpi:requirement_text """Borrowers who are granted an exception to the DSCR minimums are subject to enhanced monitoring. This includes more
frequent financial reporting, such as quarterly income and expense statements, and regular contact with the relationship
manager to discuss their financial position."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v15:clause108:r5"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:15:108> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v15:clause110:r2> a cpi:PolicyRule ;
    rdfs:label "Credit Monitoring Team Quarterly Portfolio Report" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:08301552b025a4c29694>,
        <urn:cpi:policyclass:ad98f77b21b765d56232> ;
    cpi:DERIVED_FROM <urn:cpi:source:15:110> ;
    cpi:PART_OF_VERSION <urn:cpi:version:15> ;
    cpi:requirement_text """In addition to the monthly report, the Credit Monitoring Team generates a quarterly portfolio report that assesses ongoing
compliance with DSCR minimums for existing loans."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v15:clause110:r2"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:15:110> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v15:clause96:r3> a cpi:PolicyRule ;
    rdfs:label "New Applications Verification and Existing Portfolios Monitoring" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:ad98f77b21b765d56232>,
        <urn:cpi:policyclass:ef181960a2e7ddb709f2> ;
    cpi:DERIVED_FROM <urn:cpi:source:15:96> ;
    cpi:PART_OF_VERSION <urn:cpi:version:15> ;
    cpi:requirement_text """For new applications, DSCR minimums must be
verified during the underwriting process. For existing portfolios, DSCR compliance must be monitored as part of the bank's
ongoing credit review process."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v15:clause96:r3"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:15:96> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v15:clause96:r4> a cpi:PolicyRule ;
    rdfs:label "Deviation Documentation and Exception Approval" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:9ec908f0bf2d80d3eebe>,
        <urn:cpi:policyclass:acb66a8f8a7f374455cb> ;
    cpi:DERIVED_FROM <urn:cpi:source:15:96> ;
    cpi:PART_OF_VERSION <urn:cpi:version:15> ;
    cpi:requirement_text """Any deviations from the established minimums must be documented, justified, and approved
through the exception process outlined in Section 9."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v15:clause96:r4"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:15:96> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v15:clause98:r1> a cpi:PolicyRule ;
    rdfs:label "Retail Credit Risk Committee Oversight Governance" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:9ec908f0bf2d80d3eebe> ;
    cpi:DERIVED_FROM <urn:cpi:source:15:98> ;
    cpi:PART_OF_VERSION <urn:cpi:version:15> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v15:clause98:r1:approval:0> ;
    cpi:requirement_text """The governance of DSCR minimums under this clause is overseen by the Retail Credit Risk Committee (RCRC), which reports
directly to the Chief Risk Officer (CRO). The RCRC is responsible for approving any changes to the DSCR thresholds, ensuring
alignment with the bank's risk appetite, and monitoring compliance with this clause."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v15:clause98:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:15:98> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v15:clause98:r3> a cpi:PolicyRule ;
    rdfs:label "Credit Policy Owner Integrity Governance" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:9ec908f0bf2d80d3eebe> ;
    cpi:DERIVED_FROM <urn:cpi:source:15:98> ;
    cpi:PART_OF_VERSION <urn:cpi:version:15> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v15:clause98:r3:approval:0> ;
    cpi:requirement_text """The Credit Policy Owner, a senior role within the Risk Management Division, is accountable for the overall integrity and
currency of this clause."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v15:clause98:r3"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:15:98> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v15:clause98:r4> a cpi:PolicyRule ;
    rdfs:label "Internal Audit Independent Review Governance" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:ad98f77b21b765d56232> ;
    cpi:DERIVED_FROM <urn:cpi:source:15:98> ;
    cpi:PART_OF_VERSION <urn:cpi:version:15> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v15:clause98:r4:approval:0> ;
    cpi:requirement_text """Compliance with this clause is monitored by the Internal Audit Department, which conducts independent reviews of the
underwriting and monitoring processes."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v15:clause98:r4"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:15:98> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v1:clause20:r1> a cpi:PolicyRule ;
    rdfs:label "Periodic Review Frequency and Responsibility" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:ad98f77b21b765d56232> ;
    cpi:DERIVED_FROM <urn:cpi:source:1:20> ;
    cpi:PART_OF_VERSION <urn:cpi:version:1> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v1:clause20:r1:approval:0> ;
    cpi:requirement_text """The GCPC is responsible for overseeing the review process, which is
conducted at least annually or more frequently if there are significant changes in the bank’s strategy, risk profile, or the external
environment."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v1:clause20:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:1:20> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v1:clause20:r2> a cpi:PolicyRule ;
    rdfs:label "Review Conduct and Findings Presentation Responsibility" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:ad98f77b21b765d56232> ;
    cpi:DERIVED_FROM <urn:cpi:source:1:20> ;
    cpi:PART_OF_VERSION <urn:cpi:version:1> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v1:clause20:r2:approval:0> ;
    cpi:requirement_text """The Wholesale Credit Risk Division is responsible for
conducting the review and presenting its findings to the GCPC."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v1:clause20:r2"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:1:20> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v1:clause20:r4> a cpi:PolicyRule ;
    rdfs:label "Policy Update Approval and Communication" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:9ec908f0bf2d80d3eebe> ;
    cpi:DERIVED_FROM <urn:cpi:source:1:20> ;
    cpi:PART_OF_VERSION <urn:cpi:version:1> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v1:clause20:r4:approval:0> ;
    cpi:requirement_text """Updates to the policy must be approved by the GCPC and communicated to all relevant stakeholders, including relationship
managers, credit analysts, and approval authorities."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v1:clause20:r4"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:1:20> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v21:clause123:r1> a cpi:PolicyRule ;
    rdfs:label "Governance Oversight by RCRC" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:9ec908f0bf2d80d3eebe> ;
    cpi:DERIVED_FROM <urn:cpi:source:21:123> ;
    cpi:PART_OF_VERSION <urn:cpi:version:21> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v21:clause123:r1:approval:0> ;
    cpi:requirement_text """Governance of the LTV Ceilings clause is overseen by the Retail Credit Risk Committee (RCRC), which is responsible for
approving, monitoring, and updating the policy in alignment with the bank’s risk appetite and regulatory expectations."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v21:clause123:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:21:123> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v21:clause129:r1> a cpi:PolicyRule ;
    rdfs:label "Standard Underwriter LTV Approval Authority" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:9ec908f0bf2d80d3eebe> ;
    cpi:DERIVED_FROM <urn:cpi:source:21:129> ;
    cpi:PART_OF_VERSION <urn:cpi:version:21> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v21:clause129:r1:approval:0> ;
    cpi:requirement_text """For loans that comply with the standard LTV ceilings, the underwriter has the authority to approve the application, provided all
other underwriting criteria (e.g., credit score, DTI ratio) are met."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v21:clause129:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:21:129> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v29:clause164:r1> a cpi:PolicyRule ;
    rdfs:label "Annual Policy Review by CPC" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:ad98f77b21b765d56232> ;
    cpi:DERIVED_FROM <urn:cpi:source:29:164> ;
    cpi:PART_OF_VERSION <urn:cpi:version:29> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v29:clause164:r1:approval:0> ;
    cpi:requirement_text """The policy is reviewed at least annually by the CPC, with the first review scheduled for
September 2027."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v29:clause164:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:29:164> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v37:clause175:r1> a cpi:PolicyRule ;
    rdfs:label "Allocation for Multi-Sector Entities" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:ae6a67c0bab119d96d75>,
        <urn:cpi:policyclass:ef181960a2e7ddb709f2> ;
    cpi:DERIVED_FROM <urn:cpi:source:37:175> ;
    cpi:PART_OF_VERSION <urn:cpi:version:37> ;
    cpi:requirement_text """Exposures to
entities that operate across multiple sectors are allocated proportionally based on revenue or asset distribution."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v37:clause175:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:37:175> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v37:clause175:r2> a cpi:PolicyRule ;
    rdfs:label "Retrospective Review and Corrective Actions for Existing Exposures" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:51785e55a44e8ac3604c>,
        <urn:cpi:policyclass:ae6a67c0bab119d96d75> ;
    cpi:DERIVED_FROM <urn:cpi:source:37:175> ;
    cpi:PART_OF_VERSION <urn:cpi:version:37> ;
    cpi:requirement_text """For existing exposures, the
bank conducts a retrospective review to ensure compliance with the sector concentration limits outlined herein. Any breaches
identified during this review must be addressed through corrective actions, such as portfolio rebalancing or risk mitigation
measures, within a defined timeframe."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v37:clause175:r2"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:37:175> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v47:clause218:r3> a cpi:PolicyRule ;
    rdfs:label "Reporting Deficiency Corrective Action Plan Requirement" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:08301552b025a4c29694>,
        <urn:cpi:policyclass:ad98f77b21b765d56232> ;
    cpi:DERIVED_FROM <urn:cpi:source:47:218> ;
    cpi:PART_OF_VERSION <urn:cpi:version:47> ;
    cpi:requirement_text """Any deficiencies identified in the reporting process must
be addressed through a corrective action plan, with the CRM unit responsible for implementing the necessary improvements."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v47:clause218:r3"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:47:218> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v48:clause236:r1> a cpi:PolicyRule ;
    rdfs:label "Annual Review Requirement for Exceptions and Waivers" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:ad98f77b21b765d56232>,
        <urn:cpi:policyclass:dbee7b1fa11fe46b26ed> ;
    cpi:DERIVED_FROM <urn:cpi:source:48:236> ;
    cpi:PART_OF_VERSION <urn:cpi:version:48> ;
    cpi:requirement_text "The policy requires that all exceptions and waivers be reviewed at least annually"^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v48:clause236:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:48:236> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v48:clause238:r1> a cpi:PolicyRule ;
    rdfs:label "Monthly Reporting Requirement for Coverage Ratios" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:08301552b025a4c29694>,
        <urn:cpi:policyclass:e9df5184319d3db58971> ;
    cpi:DERIVED_FROM <urn:cpi:source:48:238> ;
    cpi:PART_OF_VERSION <urn:cpi:version:48> ;
    cpi:requirement_text "The Credit Monitoring team is responsible for generating monthly reports on coverage ratio performance across the portfolio."^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v48:clause238:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:48:238> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v48:clause238:r3> a cpi:PolicyRule ;
    rdfs:label "Annual Review Requirement for Reporting Processes" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:ad98f77b21b765d56232>,
        <urn:cpi:policyclass:dbee7b1fa11fe46b26ed> ;
    cpi:DERIVED_FROM <urn:cpi:source:48:238> ;
    cpi:PART_OF_VERSION <urn:cpi:version:48> ;
    cpi:requirement_text """The policy also requires that the bank conduct an annual review of its coverage ratio reporting processes to ensure their
continued effectiveness."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v48:clause238:r3"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:48:238> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v48:clause240:r1> a cpi:PolicyRule ;
    rdfs:label "Annual Comprehensive Review of Coverage Ratio Policy by CRC" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:ad98f77b21b765d56232> ;
    cpi:DERIVED_FROM <urn:cpi:source:48:240> ;
    cpi:PART_OF_VERSION <urn:cpi:version:48> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v48:clause240:r1:approval:0> ;
    cpi:requirement_text """The CRC is responsible for conducting a comprehensive review of the policy at least annually, or more frequently if
significant changes occur in the bank’s risk appetite, regulatory environment, or market conditions."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v48:clause240:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:48:240> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v48:clause240:r3> a cpi:PolicyRule ;
    rdfs:label "Board Approval for Significant Policy Amendments" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:9ec908f0bf2d80d3eebe> ;
    cpi:DERIVED_FROM <urn:cpi:source:48:240> ;
    cpi:PART_OF_VERSION <urn:cpi:version:48> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v48:clause240:r3:approval:0> ;
    cpi:requirement_text """Significant amendments, such as changes to minimum ratio thresholds or approval
authorities, may also require approval from the bank’s Board of Directors."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v48:clause240:r3"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:48:240> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v49:clause244:r4> a cpi:PolicyRule ;
    rdfs:label "Intangible Assets Eligibility Criteria" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:ebcd620636c948c2d6c5>,
        <urn:cpi:policyclass:ef181960a2e7ddb709f2> ;
    cpi:DERIVED_FROM <urn:cpi:source:49:244> ;
    cpi:PART_OF_VERSION <urn:cpi:version:49> ;
    cpi:requirement_text """Intangible assets, such as intellectual property or accounts receivable, may also be
considered, provided they meet the bank’s eligibility criteria and can be reliably valued and liquidated."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v49:clause244:r4"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:49:244> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v49:clause244:r5> a cpi:PolicyRule ;
    rdfs:label "Exclusion of Illiquid or Restricted Assets" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:24a661299ba3ba4cd0b5>,
        <urn:cpi:policyclass:ebcd620636c948c2d6c5> ;
    cpi:DERIVED_FROM <urn:cpi:source:49:244> ;
    cpi:PART_OF_VERSION <urn:cpi:version:49> ;
    cpi:requirement_text """The policy explicitly
excludes assets that are illiquid, difficult to value, or subject to significant legal or regulatory restrictions."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v49:clause244:r5"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:49:244> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v49:clause244:r7> a cpi:PolicyRule ;
    rdfs:label "Mandatory Compliance and Exception Management" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:9ec908f0bf2d80d3eebe>,
        <urn:cpi:policyclass:acb66a8f8a7f374455cb> ;
    cpi:DERIVED_FROM <urn:cpi:source:49:244> ;
    cpi:PART_OF_VERSION <urn:cpi:version:49> ;
    cpi:requirement_text """Compliance with this clause is mandatory, and any deviations must be
documented, justified, and approved through the bank’s exception management process."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v49:clause244:r7"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:49:244> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v49:clause246:r2> a cpi:PolicyRule ;
    rdfs:label "Operational Oversight and Compliance Reporting by Collateral Management Unit" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:08301552b025a4c29694>,
        <urn:cpi:policyclass:ad98f77b21b765d56232> ;
    cpi:DERIVED_FROM <urn:cpi:source:49:246> ;
    cpi:PART_OF_VERSION <urn:cpi:version:49> ;
    cpi:requirement_text """The CMU is tasked with implementing the policy, developing procedural guidelines, and providing training to relevant staff. It
also monitors compliance with the policy and reports any breaches or exceptions to the CRC."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v49:clause246:r2"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:49:246> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v49:clause246:r3> a cpi:PolicyRule ;
    rdfs:label "Board Responsibility and Regular Updates on Collateral Portfolio" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:08301552b025a4c29694>,
        <urn:cpi:policyclass:9ec908f0bf2d80d3eebe> ;
    cpi:DERIVED_FROM <urn:cpi:source:49:246> ;
    cpi:PART_OF_VERSION <urn:cpi:version:49> ;
    cpi:requirement_text """The bank’s Board of Directors retains ultimate responsibility for the policy’s adherence to the bank’s risk appetite and strategic
objectives. The Board receives regular updates from the CRC on the performance of the collateral portfolio, including trends in
collateral types, valuation adjustments, and any emerging risks."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v49:clause246:r3"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:49:246> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v49:clause246:r6> a cpi:PolicyRule ;
    rdfs:label "Annual Audit of Collateral Management Process" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:a05a0a4f8c8c7ff19a51>,
        <urn:cpi:policyclass:ad98f77b21b765d56232> ;
    cpi:DERIVED_FROM <urn:cpi:source:49:246> ;
    cpi:PART_OF_VERSION <urn:cpi:version:49> ;
    cpi:requirement_text """The governance framework includes regular audits of the collateral management process, conducted by Internal Audit at least
annually."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v49:clause246:r6"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:49:246> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v49:clause248:r7> a cpi:PolicyRule ;
    rdfs:label "Collateral Haircuts for Liquidation Costs and Market Volatility" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:6446ca752576e05d10fc>,
        <urn:cpi:policyclass:ebcd620636c948c2d6c5> ;
    cpi:DERIVED_FROM <urn:cpi:source:49:248> ;
    cpi:PART_OF_VERSION <urn:cpi:version:49> ;
    cpi:requirement_text """The bank
applies haircuts to the value of such collateral to account for potential liquidation costs and market volatility."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v49:clause248:r7"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:49:248> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v49:clause248:r8> a cpi:PolicyRule ;
    rdfs:label "Collateral Eligibility Timing and Reaffirmation" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:ad98f77b21b765d56232>,
        <urn:cpi:policyclass:ebcd620636c948c2d6c5> ;
    cpi:DERIVED_FROM <urn:cpi:source:49:248> ;
    cpi:PART_OF_VERSION <urn:cpi:version:49> ;
    cpi:requirement_text "Collateral eligibility is determined at the time of credit approval and must be reaffirmed at each subsequent review or renewal."^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v49:clause248:r8"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:49:248> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v49:clause250:r4> a cpi:PolicyRule ;
    rdfs:label "CMU Continuous Monitoring of Dynamic Limits" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:7400994ea0b297e87025>,
        <urn:cpi:policyclass:ad98f77b21b765d56232> ;
    cpi:DERIVED_FROM <urn:cpi:source:49:250> ;
    cpi:PART_OF_VERSION <urn:cpi:version:49> ;
    cpi:requirement_text "These limits are adjusted in real-time based on market conditions and are monitored continuously by the CMU."^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v49:clause250:r4"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:49:250> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v49:clause252:r7:exception> a cpi:Exception ;
    rdfs:label "Board Approval for Higher-Risk Exceptions" ;
    cpi:EXCEPTION_TO <urn:cpi:rule:v49:clause252:r6> ;
    cpi:HAS_CONDITION <urn:cpi:rule:v49:clause252:r7:logic:f037c8676f0df429> ;
    cpi:IMPLEMENTED_BY_RULE <urn:cpi:rule:v49:clause252:r7> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v49:clause252:r7:approval:0> ;
    cpi:exception_reference "urn:cpi:rule:v49:clause252:r7:exception"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:49:252> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v49:clause254:r1> a cpi:PolicyRule ;
    rdfs:label "CMU Monitoring Program Establishment" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:ad98f77b21b765d56232>,
        <urn:cpi:policyclass:ebcd620636c948c2d6c5> ;
    cpi:DERIVED_FROM <urn:cpi:source:49:254> ;
    cpi:PART_OF_VERSION <urn:cpi:version:49> ;
    cpi:requirement_text """The CMU is
responsible for establishing and maintaining a robust monitoring program that ensures collateral remains eligible, properly
valued, and sufficient to cover the credit exposure throughout the life of the facility."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v49:clause254:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:49:254> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v49:clause254:r4> a cpi:PolicyRule ;
    rdfs:label "Automated Collateral Value Tracking and Alerts" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:ad98f77b21b765d56232>,
        <urn:cpi:policyclass:ebcd620636c948c2d6c5> ;
    cpi:DERIVED_FROM <urn:cpi:source:49:254> ;
    cpi:PART_OF_VERSION <urn:cpi:version:49> ;
    cpi:requirement_text """The CMU uses
automated systems to track collateral values, with alerts generated when values fall below predefined thresholds or when
market conditions change significantly."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v49:clause254:r4"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:49:254> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v49:clause254:r5> a cpi:PolicyRule ;
    rdfs:label "Monthly Portfolio-Level Concentration Reviews" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:ad98f77b21b765d56232>,
        <urn:cpi:policyclass:ae6a67c0bab119d96d75> ;
    cpi:DERIVED_FROM <urn:cpi:source:49:254> ;
    cpi:PART_OF_VERSION <urn:cpi:version:49> ;
    cpi:requirement_text """The CMU
conducts monthly reviews to identify any emerging risks, such as over-concentration in a particular asset class or geographic
region."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v49:clause254:r5"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:49:254> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v49:clause254:r7> a cpi:PolicyRule ;
    rdfs:label "Third-Party Valuation Provider Performance Monitoring" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:7400994ea0b297e87025>,
        <urn:cpi:policyclass:ad98f77b21b765d56232> ;
    cpi:DERIVED_FROM <urn:cpi:source:49:254> ;
    cpi:PART_OF_VERSION <urn:cpi:version:49> ;
    cpi:requirement_text "The CMU also monitors the performance of third-party valuation providers to ensure their continued reliability."^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v49:clause254:r7"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:49:254> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v49:clause256:r8> a cpi:PolicyRule ;
    rdfs:label "Enhanced Monitoring and CMU Tracking Duty for Exceptions" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:acb66a8f8a7f374455cb>,
        <urn:cpi:policyclass:ad98f77b21b765d56232> ;
    cpi:DERIVED_FROM <urn:cpi:source:49:256> ;
    cpi:PART_OF_VERSION <urn:cpi:version:49> ;
    cpi:requirement_text """Exceptions are subject to enhanced monitoring, with the frequency and scope of reviews determined by the level of risk. The
CMU is responsible for tracking the status of all exceptions and ensuring that the approved mitigating actions are implemented."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v49:clause256:r8"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:49:256> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v49:clause258:r1> a cpi:PolicyRule ;
    rdfs:label "Daily Reporting of Liquid Collateral" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:08301552b025a4c29694> ;
    cpi:DERIVED_FROM <urn:cpi:source:49:258> ;
    cpi:HAS_CONDITION <urn:cpi:rule:v49:clause258:r1:logic:6ecd85b947f21850> ;
    cpi:PART_OF_VERSION <urn:cpi:version:49> ;
    cpi:requirement_text """Daily reports are generated for liquid collateral, such as cash and
securities, to track market values and margin requirements."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v49:clause258:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:49:258> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v49:clause258:r2> a cpi:PolicyRule ;
    rdfs:label "Weekly Reporting of Less Liquid Assets" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:08301552b025a4c29694> ;
    cpi:DERIVED_FROM <urn:cpi:source:49:258> ;
    cpi:HAS_CONDITION <urn:cpi:rule:v49:clause258:r2:logic:e9c7b5e2428fe4f6> ;
    cpi:PART_OF_VERSION <urn:cpi:version:49> ;
    cpi:requirement_text """Weekly reports are produced for less liquid assets, such as real
estate and inventory, to monitor valuation adjustments and compliance with LTV limits."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v49:clause258:r2"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:49:258> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v49:clause258:r4> a cpi:PolicyRule ;
    rdfs:label "Quarterly Collateral Portfolio Performance Reporting to Board of Directors" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:08301552b025a4c29694> ;
    cpi:DERIVED_FROM <urn:cpi:source:49:258> ;
    cpi:PART_OF_VERSION <urn:cpi:version:49> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v49:clause258:r4:approval:0> ;
    cpi:requirement_text """Quarterly reports are prepared for the Board of Directors, providing a high-level overview of the collateral portfolio’s
performance and its alignment with the bank’s risk appetite."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v49:clause258:r4"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:49:258> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v50:clause264:r1> a cpi:PolicyRule ;
    rdfs:label "Binding Scope of Haircuts Policy" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:0ece0168920195848ef3>,
        <urn:cpi:policyclass:24a661299ba3ba4cd0b5> ;
    cpi:DERIVED_FROM <urn:cpi:source:50:264> ;
    cpi:PART_OF_VERSION <urn:cpi:version:50> ;
    cpi:requirement_text """The policy is binding on all employees, contractors, and third-party service providers involved in the valuation, acceptance, or
management of collateral. Compliance with this clause is mandatory for credit officers, risk managers, and operations staff who
play a role in the collateralization process."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v50:clause264:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:50:264> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v50:clause266:r1> a cpi:PolicyRule ;
    rdfs:label "Credit Risk Committee Governance Oversight" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:9357aa360ca9e8840c5b>,
        <urn:cpi:policyclass:9ec908f0bf2d80d3eebe> ;
    cpi:DERIVED_FROM <urn:cpi:source:50:266> ;
    cpi:PART_OF_VERSION <urn:cpi:version:50> ;
    cpi:requirement_text """The governance of this Haircuts Clause is overseen by the bank’s Credit Risk Committee (CRC), which is responsible for
approving, monitoring, and updating the haircut parameters."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v50:clause266:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:50:266> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v50:clause268:r1> a cpi:PolicyRule ;
    rdfs:label "Prohibition of Ineligible Collateral Acceptance" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:ebcd620636c948c2d6c5>,
        <urn:cpi:policyclass:ef181960a2e7ddb709f2> ;
    cpi:DERIVED_FROM <urn:cpi:source:50:268> ;
    cpi:PART_OF_VERSION <urn:cpi:version:50> ;
    cpi:requirement_text """Ineligible assets
must not be accepted as collateral under any circumstances, regardless of the proposed haircut."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v50:clause268:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:50:268> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v50:clause274:r1> a cpi:PolicyRule ;
    rdfs:label "Non-Marketable Asset Revaluation Frequency" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:7400994ea0b297e87025>,
        <urn:cpi:policyclass:ad98f77b21b765d56232> ;
    cpi:DERIVED_FROM <urn:cpi:source:50:274> ;
    cpi:PART_OF_VERSION <urn:cpi:version:50> ;
    cpi:requirement_text """Non-marketable assets, such as real estate or inventory, are revalued at least annually or more frequently if there are
indications of material changes in value."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v50:clause274:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:50:274> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v50:clause280:r1> a cpi:PolicyRule ;
    rdfs:label "Minimum Annual Policy Review Frequency" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:24a661299ba3ba4cd0b5>,
        <urn:cpi:policyclass:ad98f77b21b765d56232> ;
    cpi:DERIVED_FROM <urn:cpi:source:50:280> ;
    cpi:PART_OF_VERSION <urn:cpi:version:50> ;
    cpi:requirement_text """The policy is reviewed at least annually, or more frequently if there are significant changes in market conditions, regulatory
requirements, or the bank’s risk appetite."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v50:clause280:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:50:280> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v52:clause303:r2> a cpi:PolicyRule ;
    rdfs:label "Mandatory Adherence to Spread Grid" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:24a661299ba3ba4cd0b5>,
        <urn:cpi:policyclass:acb66a8f8a7f374455cb> ;
    cpi:DERIVED_FROM <urn:cpi:source:52:303> ;
    cpi:PART_OF_VERSION <urn:cpi:version:52> ;
    cpi:requirement_text """Adherence to the Spread Grid is
mandatory unless an exception is formally approved through the governance processes outlined in Section 9."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v52:clause303:r2"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:52:303> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v52:clause305:r1> a cpi:PolicyRule ;
    rdfs:label "Spread Grid Applicability to Corporate Loans" ;
    cpi:APPLIES_TO_PRODUCT <urn:cpi:product:efb969e06392cb4f5114> ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:24a661299ba3ba4cd0b5> ;
    cpi:DERIVED_FROM <urn:cpi:source:52:305> ;
    cpi:PART_OF_VERSION <urn:cpi:version:52> ;
    cpi:requirement_text """The Spread Grid under Clause 1.2 of Parent Policy PRC-v1.7 applies to all credit exposures originated, renewed, or amended
by the bank, including but not limited to corporate loans, commercial real estate financing, project finance, and fixed-income
securities."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v52:clause305:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:52:305> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

