    cpi:synthetic true .

<urn:cpi:rule:v58:clause432:r4> a cpi:PolicyRule ;
    rdfs:label "Maximum Leverage Ratio Limit" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:51785e55a44e8ac3604c>,
