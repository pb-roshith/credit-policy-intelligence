<urn:cpi:source:61:704> a cpi:SourcePassage ;
    rdfs:label "Source clause 704" ;
    cpi:SOURCE_IN_VERSION <urn:cpi:version:61> ;
    cpi:clause_reference "6"^^xsd:string ;
    cpi:document_reference "23"^^xsd:string ;
