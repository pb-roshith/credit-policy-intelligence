    cpi:APPLIES_TO_PRODUCT <urn:cpi:product:8152cf48c30d48872a24> ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:51785e55a44e8ac3604c>,
        <urn:cpi:policyclass:fc966078f763f57e4193> ;
    cpi:CONCERNS <urn:cpi:policyconcern:a0148a51d610b28abff8> ;
    cpi:DERIVED_FROM <urn:cpi:source:21:125> ;
    cpi:EVALUATES_RISK_ATTRIBUTE <urn:cpi:riskmetric:8a97dfb03e0af1b3eb73> ;
    cpi:HAS_THRESHOLD <urn:cpi:rule:v21:clause125:r5:threshold:0> ;
    cpi:PART_OF_VERSION <urn:cpi:version:21> ;
    cpi:USES_METRIC <urn:cpi:riskmetric:8a97dfb03e0af1b3eb73> ;
    cpi:requirement_text """Auto loans have a maximum LTV ceiling of 120%, reflecting the rapid depreciation of
vehicles, while secured personal loans are capped at 70% LTV."""^^xsd:string ;
    cpi:rule_kind "QUANTITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v21:clause125:r5"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:21:125> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

