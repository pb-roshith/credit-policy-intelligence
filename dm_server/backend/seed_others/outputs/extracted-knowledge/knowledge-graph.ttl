<urn:cpi:rule:v69:clause1556:r2> a cpi:PolicyRule ;
    rdfs:label "Corporate Qualitative Evidence and High-Risk Industry Assessments" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:a05a0a4f8c8c7ff19a51>,
        <urn:cpi:policyclass:e9df5184319d3db58971> ;
    cpi:DERIVED_FROM <urn:cpi:source:69:1556> ;
    cpi:PART_OF_VERSION <urn:cpi:version:69> ;
    cpi:REQUIRES_EVIDENCE <urn:cpi:rule:v69:clause1556:r2:evidence:0>,
        <urn:cpi:rule:v69:clause1556:r2:evidence:1>,
        <urn:cpi:rule:v69:clause1556:r2:evidence:2>,
        <urn:cpi:rule:v69:clause1556:r2:evidence:3>,
        <urn:cpi:rule:v69:clause1556:r2:evidence:4> ;
    cpi:requirement_text """In addition to financial data, underwriters must gather qualitative evidence to support their assessment. This includes
conducting site visits, interviewing key management personnel, and reviewing industry reports from reputable sources. For
counterparties operating in high-risk industries or jurisdictions, underwriters must also obtain independent third-party
assessments, such as due diligence reports or environmental, social, and governance (ESG) evaluations."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v69:clause1556:r2"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:69:1556> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

