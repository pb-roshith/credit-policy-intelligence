<urn:cpi:rule:v52:clause307:r1> a cpi:PolicyRule ;
    rdfs:label "Governance Oversight by Credit Policy Committee" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:9ec908f0bf2d80d3eebe> ;
    cpi:DERIVED_FROM <urn:cpi:source:52:307> ;
    cpi:PART_OF_VERSION <urn:cpi:version:52> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v52:clause307:r1:approval:0> ;
    cpi:requirement_text """The governance of the Spread Grid is overseen by the Credit Policy Committee (CPC), which is responsible for its
development, approval, and periodic review."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v52:clause307:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:52:307> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v52:clause321:r1> a cpi:PolicyRule ;
    rdfs:label "Annual Comprehensive Review of the Spread Grid by CRM Department" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:ad98f77b21b765d56232> ;
    cpi:DERIVED_FROM <urn:cpi:source:52:321> ;
    cpi:PART_OF_VERSION <urn:cpi:version:52> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v52:clause321:r1:approval:0> ;
    cpi:requirement_text """The CRM department conducts a comprehensive review of the grid at least annually, with
input from business units, risk analytics, compliance, and Internal Audit."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v52:clause321:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:52:321> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v52:clause321:r2> a cpi:PolicyRule ;
    rdfs:label "Adjustment of Thresholds or Inputs When Grid Is Miscalibrated" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:acb66a8f8a7f374455cb>,
        <urn:cpi:policyclass:ad98f77b21b765d56232> ;
    cpi:DERIVED_FROM <urn:cpi:source:52:321> ;
    cpi:PART_OF_VERSION <urn:cpi:version:52> ;
    cpi:requirement_text """If the grid is
found to be miscalibrated (e.g., actual losses exceed expected losses for a given risk bucket), the thresholds or inputs are
adjusted accordingly."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v52:clause321:r2"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:52:321> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v52:clause321:r4> a cpi:PolicyRule ;
    rdfs:label "Approval Authority and Mandating Power for Ad Hoc Reviews by CPC" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:9ec908f0bf2d80d3eebe> ;
    cpi:DERIVED_FROM <urn:cpi:source:52:321> ;
    cpi:PART_OF_VERSION <urn:cpi:version:52> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v52:clause321:r4:approval:0> ;
    cpi:requirement_text "The CPC has the authority to mandate such reviews and to fast-track updates to the grid if warranted."^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v52:clause321:r4"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:52:321> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v52:clause321:r5> a cpi:PolicyRule ;
    rdfs:label "Approval of Updates to the Spread Grid by CPC" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:9ec908f0bf2d80d3eebe> ;
    cpi:DERIVED_FROM <urn:cpi:source:52:321> ;
    cpi:PART_OF_VERSION <urn:cpi:version:52> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v52:clause321:r5:approval:0> ;
    cpi:requirement_text """Updates to the Spread Grid are approved by the CPC and communicated to all stakeholders through formal policy memos,
training sessions, and updates to the bank’s policy management system."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v52:clause321:r5"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:52:321> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v54:clause349:r14> a cpi:PolicyRule ;
    rdfs:label "Mandatory First-Priority Lien and Personal or Corporate Guarantees" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:ebcd620636c948c2d6c5> ;
    cpi:DERIVED_FROM <urn:cpi:source:54:349> ;
    cpi:DOCUMENTS_PRODUCT_SCOPE <urn:cpi:product:1f8ac4a77aa56173103e> ;
    cpi:PART_OF_VERSION <urn:cpi:version:54> ;
    cpi:requirement_text """All construction loans must be supported by a first-priority lien on the property being developed, as well as personal or
corporate guarantees from the borrower."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v54:clause349:r14"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:54:349> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v54:clause351:r6> a cpi:PolicyRule ;
    rdfs:label "Definition of Speculative Construction Projects" ;
    cpi:APPLIES_TO_PRODUCT <urn:cpi:product:ceaebf506d474b7fd25f> ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:45ab6cdf3797ff377d88> ;
    cpi:DERIVED_FROM <urn:cpi:source:54:351> ;
    cpi:PART_OF_VERSION <urn:cpi:version:54> ;
    cpi:requirement_text """Speculative projects are defined as those where less than 50% of the units or space are pre-sold or pre-leased at the time of
loan closing."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v54:clause351:r6"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:54:351> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v54:clause351:r8> a cpi:PolicyRule ;
    rdfs:label "Maximum Allowable Interest Rate for Construction Loans" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:7e60fa643430dc8c9ecc>,
        <urn:cpi:policyclass:c60494e8688cdde53c52> ;
    cpi:DERIVED_FROM <urn:cpi:source:54:351> ;
    cpi:PART_OF_VERSION <urn:cpi:version:54> ;
    cpi:requirement_text """The
maximum allowable interest rate for construction loans is the bank’s prime rate plus 200 basis points."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v54:clause351:r8"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:54:351> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v54:clause355:r2> a cpi:PolicyRule ;
    rdfs:label "Mandatory Quarterly Independent Site Inspections" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:ad98f77b21b765d56232> ;
    cpi:DERIVED_FROM <urn:cpi:source:54:355> ;
    cpi:PART_OF_VERSION <urn:cpi:version:54> ;
    cpi:REQUIRES_EVIDENCE <urn:cpi:rule:v54:clause355:r2:evidence:0> ;
    cpi:requirement_text """In addition to borrower-provided reports, the bank conducts independent site inspections at least quarterly for all active
construction loans."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v54:clause355:r2"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:54:355> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v56:clause402:r2> a cpi:PolicyRule ;
    rdfs:label "Board Ratification Requirement for Revised Policy Versions" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:9ec908f0bf2d80d3eebe> ;
    cpi:DERIVED_FROM <urn:cpi:source:56:402> ;
    cpi:PART_OF_VERSION <urn:cpi:version:56> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v56:clause402:r2:approval:0> ;
    cpi:requirement_text """If the CCO approves the recommendations, they are
formalized into a revised version of the policy and submitted to the Board’s Risk Committee for ratification."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v56:clause402:r2"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:56:402> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v59:clause482:r1> a cpi:PolicyRule ;
    rdfs:label "Consistent Aging Calculation Rule" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:3f0beaa5d17bcb61b813>,
        <urn:cpi:policyclass:777177f6908383f9e4df> ;
    cpi:DERIVED_FROM <urn:cpi:source:59:482> ;
    cpi:PART_OF_VERSION <urn:cpi:version:59> ;
    cpi:requirement_text "Days past due, missed installments and delinquent amount shall be calculated consistently."^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v59:clause482:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:59:482> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v59:clause484:r1> a cpi:PolicyRule ;
    rdfs:label "Payment Reconciliation Resolution Rule" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:3f0beaa5d17bcb61b813>,
        <urn:cpi:policyclass:45b84dd2dfe7afa3a554> ;
    cpi:DERIVED_FROM <urn:cpi:source:59:484> ;
    cpi:PART_OF_VERSION <urn:cpi:version:59> ;
    cpi:requirement_text "Payment, suspense, reversal and allocation issues shall be resolved before customer treatment."^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v59:clause484:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:59:484> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v59:clause486:r1> a cpi:PolicyRule ;
    rdfs:label "Delinquency Account Segmentation Rule" ;
    cpi:APPLIES_TO_PRODUCT <urn:cpi:product:504416934ff784318dd2> ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:0ece0168920195848ef3> ;
    cpi:DERIVED_FROM <urn:cpi:source:59:486> ;
    cpi:PART_OF_VERSION <urn:cpi:version:59> ;
    cpi:requirement_text "Accounts shall be segmented by severity, exposure, product, risk, vulnerability and prior behavior."^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v59:clause486:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:59:486> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v59:clause490:r1> a cpi:PolicyRule ;
    rdfs:label "Customer Circumstances Distinction Rule" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:0ece0168920195848ef3>,
        <urn:cpi:policyclass:9bbd79985ee97fa7d1f5> ;
    cpi:DERIVED_FROM <urn:cpi:source:59:490> ;
    cpi:PART_OF_VERSION <urn:cpi:version:59> ;
    cpi:requirement_text "Temporary hardship, dispute, fraud and operational errors shall be distinguished from unwillingness to pay."^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v59:clause490:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:59:490> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v59:clause492:r1> a cpi:PolicyRule ;
    rdfs:label "Promise Tracking Records Rule" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:1f22797d1c6049042795>,
        <urn:cpi:policyclass:3f0beaa5d17bcb61b813> ;
    cpi:DERIVED_FROM <urn:cpi:source:59:492> ;
    cpi:PART_OF_VERSION <urn:cpi:version:59> ;
    cpi:requirement_text "Promises shall record amount, date, channel, owner and outcome."^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v59:clause492:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:59:492> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v59:clause496:r1> a cpi:PolicyRule ;
    rdfs:label "Delinquency Escalation Trigger Rule" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:9357aa360ca9e8840c5b>,
        <urn:cpi:policyclass:9ec908f0bf2d80d3eebe> ;
    cpi:DERIVED_FROM <urn:cpi:source:59:496> ;
    cpi:PART_OF_VERSION <urn:cpi:version:59> ;
    cpi:requirement_text "Worsening delinquency, broken promises, high exposure or risk signals shall trigger enhanced action."^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v59:clause496:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:59:496> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v59:clause514:r1> a cpi:PolicyRule ;
    rdfs:label "Policy Citation Requirement for Exceptions" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:a05a0a4f8c8c7ff19a51>,
        <urn:cpi:policyclass:acb66a8f8a7f374455cb> ;
    cpi:DERIVED_FROM <urn:cpi:source:59:514> ;
    cpi:PART_OF_VERSION <urn:cpi:version:59> ;
    cpi:requirement_text "Cite the exact policy, version, section and clause."^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v59:clause514:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:59:514> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v59:clause515:r1> a cpi:PolicyRule ;
