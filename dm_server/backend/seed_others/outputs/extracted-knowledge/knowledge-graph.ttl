    cpi:sourceRef <urn:cpi:source:55:369> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v56:clause387:r1> a cpi:PolicyRule ;
    rdfs:label "Relationship Manager Delegated Approval Authority Limit" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:51785e55a44e8ac3604c>,
        <urn:cpi:policyclass:9ec908f0bf2d80d3eebe> ;
    cpi:DERIVED_FROM <urn:cpi:source:56:387> ;
    cpi:EVALUATES_RISK_ATTRIBUTE <urn:cpi:riskmetric:c6e32a68cdddf8f4ab43> ;
    cpi:HAS_CONDITION <urn:cpi:rule:v56:clause387:r1:logic:980dec19fd922d33> ;
    cpi:HAS_THRESHOLD <urn:cpi:rule:v56:clause387:r1:threshold:0> ;
    cpi:PART_OF_VERSION <urn:cpi:version:56> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v56:clause387:r1:approval:0> ;
    cpi:REQUIRES_EVIDENCE <urn:cpi:rule:v56:clause387:r1:evidence:0> ;
    cpi:USES_METRIC <urn:cpi:riskmetric:c6e32a68cdddf8f4ab43> ;
    cpi:requirement_text """At the base of the hierarchy, Relationship Managers (RMs) are empowered to
approve transactions up to USD 1 million, provided they comply with all standard underwriting criteria and do not involve
high-risk counterparties or jurisdictions."""^^xsd:string ;
    cpi:rule_kind "QUANTITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v56:clause387:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:56:387> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v69:clause1556:r3> a cpi:PolicyRule ;
    rdfs:label "Retail Verification and Bureau Check Requirements" ;
    cpi:APPLIES_TO_PRODUCT <urn:cpi:product:0167096d416f3d2abb2e> ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:a05a0a4f8c8c7ff19a51>,
        <urn:cpi:policyclass:e9df5184319d3db58971>,
        <urn:cpi:policyclass:f675c4161d15d5396022> ;
    cpi:DERIVED_FROM <urn:cpi:source:69:1556> ;
    cpi:PART_OF_VERSION <urn:cpi:version:69> ;
    cpi:REQUIRES_EVIDENCE <urn:cpi:rule:v69:clause1556:r3:evidence:0>,
        <urn:cpi:rule:v69:clause1556:r3:evidence:1>,
        <urn:cpi:rule:v69:clause1556:r3:evidence:2>,
        <urn:cpi:rule:v69:clause1556:r3:evidence:3> ;
    cpi:requirement_text """For retail lending, underwriters must verify the applicant’s identity, income, and employment status using primary sources, such
as government-issued identification, pay stubs, and employer verification letters. Credit reports from at least one major credit
bureau must be obtained and reviewed for all retail applicants. In cases where the applicant’s credit history is limited or
unavailable, underwriters may use alternative data sources, such as utility payment records or rental history, provided these are
documented and justified."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v69:clause1556:r3"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:69:1556> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v72:clause1617:r5> a cpi:PolicyRule ;
    rdfs:label "Single Borrower Exposure with Long Duration Limit" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:12dd37f00537bc6583b3>,
