    cpi:status "APPROVED" ;
    cpi:synthetic true ;
    cpi:text "Days past due, missed installments and delinquent amount shall be calculated consistently."^^xsd:string ;
    cpi:version "1.0"^^xsd:string .

<urn:cpi:source:59:484> a cpi:SourcePassage ;
    rdfs:label "Source clause 484" ;
    cpi:SOURCE_IN_VERSION <urn:cpi:version:59> ;
    cpi:clause_reference "6"^^xsd:string ;
    cpi:document_reference "21"^^xsd:string ;
    cpi:origin "POLICY_SOURCE"^^xsd:string ;
    cpi:source_checksum "b7cfbf2608eaebc80334527a1bdeefb24cbf5aafe3ca8e8aae7aac49ba86057d"^^xsd:string ;
    cpi:status "APPROVED" ;
    cpi:synthetic true ;
    cpi:text "Payment, suspense, reversal and allocation issues shall be resolved before customer treatment."^^xsd:string ;
    cpi:version "1.0"^^xsd:string .

<urn:cpi:source:59:486> a cpi:SourcePassage ;
    rdfs:label "Source clause 486" ;
    cpi:SOURCE_IN_VERSION <urn:cpi:version:59> ;
    cpi:clause_reference "6"^^xsd:string ;
    cpi:document_reference "21"^^xsd:string ;
    cpi:origin "POLICY_SOURCE"^^xsd:string ;
    cpi:source_checksum "b7cfbf2608eaebc80334527a1bdeefb24cbf5aafe3ca8e8aae7aac49ba86057d"^^xsd:string ;
    cpi:status "APPROVED" ;
    cpi:synthetic true ;
    cpi:text "Accounts shall be segmented by severity, exposure, product, risk, vulnerability and prior behavior."^^xsd:string ;
    cpi:version "1.0"^^xsd:string .

<urn:cpi:source:59:490> a cpi:SourcePassage ;
    rdfs:label "Source clause 490" ;
    cpi:SOURCE_IN_VERSION <urn:cpi:version:59> ;
    cpi:clause_reference "6"^^xsd:string ;
    cpi:document_reference "21"^^xsd:string ;
    cpi:origin "POLICY_SOURCE"^^xsd:string ;
    cpi:source_checksum "b7cfbf2608eaebc80334527a1bdeefb24cbf5aafe3ca8e8aae7aac49ba86057d"^^xsd:string ;
    cpi:status "APPROVED" ;
    cpi:synthetic true ;
    cpi:text "Temporary hardship, dispute, fraud and operational errors shall be distinguished from unwillingness to pay."^^xsd:string ;
    cpi:version "1.0"^^xsd:string .

<urn:cpi:source:59:492> a cpi:SourcePassage ;
    rdfs:label "Source clause 492" ;
    cpi:SOURCE_IN_VERSION <urn:cpi:version:59> ;
    cpi:clause_reference "6"^^xsd:string ;
    cpi:document_reference "21"^^xsd:string ;
    cpi:origin "POLICY_SOURCE"^^xsd:string ;
    cpi:source_checksum "b7cfbf2608eaebc80334527a1bdeefb24cbf5aafe3ca8e8aae7aac49ba86057d"^^xsd:string ;
    cpi:status "APPROVED" ;
