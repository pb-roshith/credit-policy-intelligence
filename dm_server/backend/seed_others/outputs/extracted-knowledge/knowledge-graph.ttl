    cpi:PART_OF_VERSION <urn:cpi:version:69> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v69:clause1567:r2:approval:0> ;
    cpi:requirement_text """Weekly reports are provided to the business units, highlighting
new approvals, monitoring alerts, and exception requests."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v69:clause1567:r2"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:69:1567> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v69:clause1567:r7> a cpi:PolicyRule ;
    rdfs:label "Policy Change Communication and Training" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:ad98f77b21b765d56232>,
        <urn:cpi:policyclass:d9fec564d2da12d10ad5> ;
    cpi:DERIVED_FROM <urn:cpi:source:69:1567> ;
    cpi:PART_OF_VERSION <urn:cpi:version:69> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v69:clause1567:r7:approval:0> ;
    cpi:requirement_text """The CRM department is responsible for communicating any
changes to the relevant stakeholders and ensuring that all personnel are trained on the updated provisions."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v69:clause1567:r7"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:69:1567> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v69:clause1567:r8> a cpi:PolicyRule ;
    rdfs:label "Policy Review Log Documentation Requirement" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:a05a0a4f8c8c7ff19a51>,
        <urn:cpi:policyclass:ad98f77b21b765d56232> ;
    cpi:DERIVED_FROM <urn:cpi:source:69:1567> ;
    cpi:PART_OF_VERSION <urn:cpi:version:69> ;
    cpi:REQUIRES_EVIDENCE <urn:cpi:rule:v69:clause1567:r8:evidence:0> ;
    cpi:requirement_text """The policy review
process is documented in the bank’s Policy Review Log, which includes details such as the date of the review, the key findings,
and the actions taken."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v69:clause1567:r8"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:69:1567> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v71:clause1605:r2> a cpi:PolicyRule ;
    rdfs:label "Annual Assessment Board Approval Requirement" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:08301552b025a4c29694>,
        <urn:cpi:policyclass:9ec908f0bf2d80d3eebe> ;
    cpi:DERIVED_FROM <urn:cpi:source:71:1605> ;
    cpi:PART_OF_VERSION <urn:cpi:version:71> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v71:clause1605:r2:approval:0> ;
    cpi:requirement_text "It is submitted to the Board of Directors for approval."^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v71:clause1605:r2"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:71:1605> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v72:clause1613:r1> a cpi:PolicyRule ;
    rdfs:label "Governance Framework Responsibility" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:9ec908f0bf2d80d3eebe> ;
    cpi:DERIVED_FROM <urn:cpi:source:72:1613> ;
    cpi:PART_OF_VERSION <urn:cpi:version:72> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v72:clause1613:r1:approval:0>,
        <urn:cpi:rule:v72:clause1613:r1:approval:1> ;
    cpi:requirement_text """3. 3. Governance
The governance framework for this Policy is designed to ensure clear accountability, effective oversight, and consistent
implementation across the Bank. Ultimate responsibility for duration risk management rests with the Board of Directors (the
Board), which delegates operational oversight to the Risk Management Committee (RMC)."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v72:clause1613:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:72:1613> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v73:clause1635:r1> a cpi:PolicyRule ;
    rdfs:label "Mandatory Liquidity Risk Assessment for Credit Applications" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:a05a0a4f8c8c7ff19a51>,
        <urn:cpi:policyclass:ef181960a2e7ddb709f2> ;
    cpi:DERIVED_FROM <urn:cpi:source:73:1635> ;
    cpi:PART_OF_VERSION <urn:cpi:version:73> ;
    cpi:REQUIRES_EVIDENCE <urn:cpi:rule:v73:clause1635:r1:evidence:0> ;
    cpi:requirement_text """All credit applications must include a liquidity risk assessment, which evaluates the
potential impact of the exposure on the Bank’s liquidity profile under normal and stressed conditions."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v73:clause1635:r1"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:73:1635> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v73:clause1647:r2> a cpi:PolicyRule ;
    rdfs:label "Policy Amendment Approval by ALCO and Risk Committee" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:9ec908f0bf2d80d3eebe> ;
    cpi:DERIVED_FROM <urn:cpi:source:73:1647> ;
    cpi:PART_OF_VERSION <urn:cpi:version:73> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v73:clause1647:r2:approval:0>,
        <urn:cpi:rule:v73:clause1647:r2:approval:1> ;
    cpi:requirement_text "Amendments to this Policy must be approved by ALCO and, if material, by the Board’s Risk Committee."^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v73:clause1647:r2"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:73:1647> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v73:clause1647:r3> a cpi:PolicyRule ;
    rdfs:label "Non-material Amendment Approval by CRO and CCO" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:9ec908f0bf2d80d3eebe> ;
    cpi:DERIVED_FROM <urn:cpi:source:73:1647> ;
    cpi:PART_OF_VERSION <urn:cpi:version:73> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v73:clause1647:r3:approval:0>,
        <urn:cpi:rule:v73:clause1647:r3:approval:1> ;
    cpi:requirement_text """Non-material amendments, such as clarifications or minor updates to reporting requirements, may be approved by the
CRO in consultation with the CCO."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v73:clause1647:r3"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:73:1647> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v73:clause1647:r5> a cpi:PolicyRule ;
    rdfs:label "Internal Audit Independent Review" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:9ec908f0bf2d80d3eebe>,
        <urn:cpi:policyclass:ad98f77b21b765d56232> ;
    cpi:DERIVED_FROM <urn:cpi:source:73:1647> ;
    cpi:PART_OF_VERSION <urn:cpi:version:73> ;
    cpi:REQUIRES_APPROVAL <urn:cpi:rule:v73:clause1647:r5:approval:0> ;
    cpi:requirement_text """Internal Audit conducts an independent review of
the Policy at least every two years, with the findings reported to the Audit Committee of the Board."""^^xsd:string ;
    cpi:rule_kind "QUALITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v73:clause1647:r5"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:73:1647> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

