    rdfs:label "Investment-Grade ICR Warning Level Definition" ;
    cpi:APPLIES_TO_SEGMENT <urn:cpi:customersegment:8832910689cb547bd1b3> ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:7913e31ed423c0a8ac83>,
