    cpi:USES_METRIC <urn:cpi:riskmetric:52fed51ef401d0513394> ;
    cpi:requirement_text """For standard retail loans, the minimum DSCR threshold is 1.25x. This threshold is applied to all
borrowers unless they qualify for a tiered adjustment based on their credit score or other risk factors, as outlined in Section 4."""^^xsd:string ;
    cpi:rule_kind "QUANTITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v15:clause102:r1"^^xsd:string ;
