    cpi:EVALUATES_RISK_ATTRIBUTE <urn:cpi:riskmetric:2e1abe5e06ae879682e1> ;
    cpi:HAS_THRESHOLD <urn:cpi:rule:v69:clause1558:r7:threshold:0> ;
    cpi:PART_OF_VERSION <urn:cpi:version:69> ;
    cpi:USES_METRIC <urn:cpi:riskmetric:2e1abe5e06ae879682e1> ;
    cpi:requirement_text """Additionally, the bank sets thresholds for watchlist and non-performing
exposures, with the latter not exceeding 3% of total exposures at any time."""^^xsd:string ;
    cpi:rule_kind "QUANTITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v69:clause1558:r7"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:69:1558> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

