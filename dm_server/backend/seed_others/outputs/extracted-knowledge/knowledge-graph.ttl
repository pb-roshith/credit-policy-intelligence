<urn:cpi:rule:v15:clause100:r2> a cpi:PolicyRule ;
    rdfs:label "Low Credit Score Minimum DSCR Threshold" ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:51785e55a44e8ac3604c>,
        <urn:cpi:policyclass:8c4767711b32877b5b4e>,
        <urn:cpi:policyclass:f675c4161d15d5396022> ;
    cpi:DERIVED_FROM <urn:cpi:source:15:100> ;
    cpi:EVALUATES_RISK_ATTRIBUTE <urn:cpi:riskmetric:52fed51ef401d0513394> ;
    cpi:HAS_CONDITION <urn:cpi:rule:v15:clause100:r2:logic:9ed2c02580eed87a> ;
    cpi:HAS_THRESHOLD <urn:cpi:rule:v15:clause100:r2:threshold:0> ;
    cpi:PART_OF_VERSION <urn:cpi:version:15> ;
    cpi:USES_METRIC <urn:cpi:riskmetric:52fed51ef401d0513394> ;
    cpi:requirement_text """For borrowers with a credit score below 650, the minimum DSCR threshold is increased to 1.50x to account for the higher risk
profile."""^^xsd:string ;
    cpi:rule_kind "QUANTITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v15:clause100:r2"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:15:100> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v1:clause10:r11> a cpi:PolicyRule ;
    rdfs:label "Unsecured Credit Facilities Product Limit" ;
    cpi:APPLIES_TO_PRODUCT <urn:cpi:product:040766022fd265a39dc6> ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:51785e55a44e8ac3604c>,
        <urn:cpi:policyclass:ae6a67c0bab119d96d75> ;
    cpi:CONCERNS <urn:cpi:policyconcern:4e1267273eec80a32991> ;
    cpi:DERIVED_FROM <urn:cpi:source:1:10> ;
    cpi:EVALUATES_RISK_ATTRIBUTE <urn:cpi:riskmetric:606f835f1b446625d3c4> ;
    cpi:HAS_THRESHOLD <urn:cpi:rule:v1:clause10:r11:threshold:0> ;
    cpi:PART_OF_VERSION <urn:cpi:version:1> ;
    cpi:USES_METRIC <urn:cpi:riskmetric:606f835f1b446625d3c4> ;
    cpi:requirement_text """Similarly, the exposure to unsecured credit
facilities is capped at 30% of the portfolio."""^^xsd:string ;
    cpi:rule_kind "QUANTITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v1:clause10:r11"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:1:10> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

<urn:cpi:rule:v1:clause10:r5> a cpi:PolicyRule ;
    rdfs:label "Single Industry Sector Aggregate Exposure Limit" ;
    cpi:APPLIES_TO_PRODUCT <urn:cpi:product:c9ed53ade4356ae7883a> ;
    cpi:CLASSIFIED_AS <urn:cpi:policyclass:51785e55a44e8ac3604c>,
        <urn:cpi:policyclass:ae6a67c0bab119d96d75> ;
    cpi:CONCERNS <urn:cpi:policyconcern:4e1267273eec80a32991> ;
    cpi:DERIVED_FROM <urn:cpi:source:1:10> ;
    cpi:EVALUATES_RISK_ATTRIBUTE <urn:cpi:riskmetric:d5b06272f74410bbed73> ;
    cpi:HAS_THRESHOLD <urn:cpi:rule:v1:clause10:r5:threshold:0> ;
    cpi:PART_OF_VERSION <urn:cpi:version:1> ;
    cpi:USES_METRIC <urn:cpi:riskmetric:d5b06272f74410bbed73> ;
    cpi:requirement_text """The bank’s aggregate exposure to a single
industry sector must not exceed 25% of the total wholesale portfolio."""^^xsd:string ;
    cpi:rule_kind "QUANTITATIVE"^^xsd:string ;
    cpi:rule_reference "urn:cpi:rule:v1:clause10:r5"^^xsd:string ;
    cpi:sourceRef <urn:cpi:source:1:10> ;
    cpi:status "APPROVED" ;
    cpi:synthetic true .

