            sh:nodeKind sh:IRI ;
            sh:path cpi:REQUIRES_APPROVAL_ABOVE_THRESHOLD ] ;
    sh:targetSubjectsOf cpi:REQUIRES_APPROVAL_ABOVE_THRESHOLD .

cpi:REQUIRES_APPROVAL_FROMEdgeShape a sh:NodeShape ;
    sh:or ( [ sh:class cpi:ApprovalRequirement ] ) ;
    sh:property [ sh:class cpi:ApprovalAuthority ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:REQUIRES_APPROVAL_FROM ] ;
    sh:targetSubjectsOf cpi:REQUIRES_APPROVAL_FROM .

cpi:REQUIRES_APPROVAL_ON_BREACHEdgeShape a sh:NodeShape ;
    sh:or ( [ sh:class cpi:PolicyRule ] ) ;
    sh:property [ sh:class cpi:ApprovalRequirement ;
