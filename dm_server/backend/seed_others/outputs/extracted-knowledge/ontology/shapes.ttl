        [ sh:class cpi:Sponsor ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:HAS_SPONSOR ] ;
    sh:sparql [ sh:message "EXAMPLE_ISOLATION" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
            ?instance a cpi:SemanticInstance; cpi:mode "EXAMPLE" . $this cpi:synthetic false . }""" ],
        [ sh:message "PROPERTY_CLASS: loan_reference" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
                $this cpi:loan_reference ?v . FILTER NOT EXISTS {
                    $this a ?type . FILTER (?type IN (cpi:Loan))
                } }""" ],
        [ sh:message "PROPERTY_CLASS: currency" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
                $this cpi:currency ?v . FILTER NOT EXISTS {
                    $this a ?type . FILTER (?type IN (cpi:Loan))
                } }""" ],
        [ sh:message "SYNTHETIC_PROVENANCE" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
            $this cpi:synthetic false; cpi:sourceRef ?p . ?p cpi:synthetic true . }""" ] ;
    sh:targetClass cpi:Facility .

cpi:GOVERNED_BYEdgeShape a sh:NodeShape ;
    sh:or ( [ sh:class cpi:Loan ] ) ;
    sh:property [ sh:class cpi:PolicyVersion ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:GOVERNED_BY ] ;
    sh:targetSubjectsOf cpi:GOVERNED_BY .

cpi:GeographyShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
