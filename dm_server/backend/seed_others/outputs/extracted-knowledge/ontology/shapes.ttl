    sh:targetSubjectsOf cpi:REQUIRES_APPROVAL_ON_BREACH .

cpi:REQUIRES_EVIDENCEEdgeShape a sh:NodeShape ;
    sh:or ( [ sh:class cpi:PolicyRule ] [ sh:class cpi:ApprovalRequirement ] ) ;
    sh:property [ sh:class cpi:EvidenceRequirement ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:REQUIRES_EVIDENCE ] ;
    sh:targetSubjectsOf cpi:REQUIRES_EVIDENCE .

cpi:RESULTS_INEdgeShape a sh:NodeShape ;
    sh:or ( [ sh:class cpi:LoanApplication ] ) ;
    sh:property [ sh:class cpi:Loan ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:RESULTS_IN ] ;
    sh:targetSubjectsOf cpi:RESULTS_IN .

cpi:RegionShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path cpi:code_scheme ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cpi:synthetic ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path cpi:geography_code ],
        [ sh:class cpi:Region ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:IN_REGION ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path rdfs:label ],
        [ sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class cpi:SourcePassage ] [ sh:class cpi:OperationalEvidence ] ) ;
            sh:path cpi:sourceRef ],
        [ sh:datatype xsd:string ;
            sh:in ( "PROPOSED" "APPROVED" "REJECTED" "SUPERSEDED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cpi:status ],
        [ sh:class cpi:TaxonomyConcept ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:CLASSIFIED_AS ] ;
    sh:sparql [ sh:message "SYNTHETIC_PROVENANCE" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
            $this cpi:synthetic false; cpi:sourceRef ?p . ?p cpi:synthetic true . }""" ],
        [ sh:message "EXAMPLE_ISOLATION" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
            ?instance a cpi:SemanticInstance; cpi:mode "EXAMPLE" . $this cpi:synthetic false . }""" ] ;
    sh:targetClass cpi:Region .

cpi:RiskAttributeShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:datatype xsd:string ;
            sh:in ( "PROPOSED" "APPROVED" "REJECTED" "SUPERSEDED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cpi:status ],
        [ sh:minCount 0 ;
            sh:path cpi:rating_code ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cpi:synthetic ],
        [ sh:minCount 0 ;
            sh:path cpi:allowed_units ],
        [ sh:class cpi:DataAttribute ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:BINDS_TO_ATTRIBUTE ],
        [ sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class cpi:SourcePassage ] [ sh:class cpi:OperationalEvidence ] ) ;
            sh:path cpi:sourceRef ],
        [ sh:minCount 0 ;
            sh:path cpi:metric_key ],
        [ sh:minCount 0 ;
            sh:path cpi:rating_type ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path rdfs:label ],
        [ sh:class cpi:TaxonomyConcept ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:CLASSIFIED_AS ],
        [ sh:minCount 0 ;
            sh:path cpi:formula ] ;
    sh:sparql [ sh:message "SYNTHETIC_PROVENANCE" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
            $this cpi:synthetic false; cpi:sourceRef ?p . ?p cpi:synthetic true . }""" ],
        [ sh:message "PROPERTY_CLASS: metric_key" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
                $this cpi:metric_key ?v . FILTER NOT EXISTS {
                    $this a ?type . FILTER (?type IN (cpi:RiskMetric))
                } }""" ],
        [ sh:message "PROPERTY_CLASS: rating_type" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
                $this cpi:rating_type ?v . FILTER NOT EXISTS {
                    $this a ?type . FILTER (?type IN (cpi:CreditRating))
                } }""" ],
        [ sh:message "PROPERTY_CLASS: formula" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
                $this cpi:formula ?v . FILTER NOT EXISTS {
                    $this a ?type . FILTER (?type IN (cpi:RiskMetric))
                } }""" ],
        [ sh:message "PROPERTY_CLASS: rating_code" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
                $this cpi:rating_code ?v . FILTER NOT EXISTS {
                    $this a ?type . FILTER (?type IN (cpi:CreditRating))
                } }""" ],
        [ sh:message "PROPERTY_CLASS: allowed_units" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
                $this cpi:allowed_units ?v . FILTER NOT EXISTS {
                    $this a ?type . FILTER (?type IN (cpi:RiskMetric))
                } }""" ],
        [ sh:message "EXAMPLE_ISOLATION" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
            ?instance a cpi:SemanticInstance; cpi:mode "EXAMPLE" . $this cpi:synthetic false . }""" ] ;
    sh:targetClass cpi:RiskAttribute .

