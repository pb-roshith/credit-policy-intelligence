            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class cpi:SourcePassage ] [ sh:class cpi:OperationalEvidence ] ) ;
            sh:path cpi:sourceRef ],
        [ sh:class cpi:RiskGrade ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:HAS_RISK_GRADE ],
        [ sh:class cpi:Industry ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:OPERATES_IN_INDUSTRY ],
        [ sh:class cpi:LegalEntity ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:HAS_PARENT_LEGAL_ENTITY ],
        [ sh:datatype xsd:string ;
            sh:in ( "PROPOSED" "APPROVED" "REJECTED" "SUPERSEDED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cpi:status ],
        [ sh:class cpi:RiskAttribute ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:HAS_RISK_ATTRIBUTE ],
        [ sh:class cpi:Sector ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:IN_SECTOR ],
        [ sh:class cpi:BusinessActivity ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:HAS_BUSINESS_ACTIVITY ],
        [ sh:class cpi:Exposure ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:HAS_EXPOSURE ],
        [ sh:class cpi:Subsector ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:IN_SUBSECTOR ],
        [ sh:class cpi:Country ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:DOMICILED_IN ],
        [ sh:class cpi:CreditRating ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:HAS_CREDIT_RATING ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path rdfs:label ],
        [ sh:class cpi:Country ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:HAS_COUNTRY_OF_RISK ],
        [ sh:class cpi:Country ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:INCORPORATED_IN ],
        [ sh:class cpi:Geography ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:HAS_REPORTED_GEOGRAPHY ] ;
    sh:sparql [ sh:message "EXAMPLE_ISOLATION" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
            ?instance a cpi:SemanticInstance; cpi:mode "EXAMPLE" . $this cpi:synthetic false . }""" ],
        [ sh:message "SYNTHETIC_PROVENANCE" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
            $this cpi:synthetic false; cpi:sourceRef ?p . ?p cpi:synthetic true . }""" ] ;
    sh:targetClass cpi:Tenant .

cpi:TenorShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:datatype xsd:string ;
            sh:in ( "PROPOSED" "APPROVED" "REJECTED" "SUPERSEDED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cpi:status ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path rdfs:label ],
        [ sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class cpi:SourcePassage ] [ sh:class cpi:OperationalEvidence ] ) ;
            sh:path cpi:sourceRef ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minInclusive 0 ;
            sh:path cpi:months ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cpi:synthetic ] ;
    sh:sparql [ sh:message "SYNTHETIC_PROVENANCE" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
            $this cpi:synthetic false; cpi:sourceRef ?p . ?p cpi:synthetic true . }""" ],
        [ sh:message "EXAMPLE_ISOLATION" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
            ?instance a cpi:SemanticInstance; cpi:mode "EXAMPLE" . $this cpi:synthetic false . }""" ] ;
    sh:targetClass cpi:Tenor .

cpi:ThresholdShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:datatype xsd:string ;
            sh:in ( "PROPOSED" "APPROVED" "REJECTED" "SUPERSEDED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cpi:status ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype xsd:decimal ] [ sh:datatype xsd:boolean ] [ sh:node cpi:ConditionValueListShape ] ) ;
            sh:path cpi:value ],
        [ sh:class cpi:RiskMetric ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:MEASURED_BY ],
        [ sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class cpi:SourcePassage ] [ sh:class cpi:OperationalEvidence ] ) ;
            sh:path cpi:sourceRef ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cpi:synthetic ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path rdfs:label ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path cpi:unit ],
        [ sh:datatype xsd:string ;
            sh:in ( "GT"^^xsd:string "GTE"^^xsd:string "LT"^^xsd:string "LTE"^^xsd:string "EQ"^^xsd:string "NE"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cpi:operator ] ;
    sh:sparql [ sh:message "THRESHOLD_METRIC: incompatible unit" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cpi:MEASURED_BY ?m; cpi:unit ?u .
            FILTER NOT EXISTS { ?m cpi:allowed_units ?u } }""" ],
        [ sh:message "SYNTHETIC_PROVENANCE" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
            $this cpi:synthetic false; cpi:sourceRef ?p . ?p cpi:synthetic true . }""" ],
        [ sh:message "EXAMPLE_ISOLATION" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
            ?instance a cpi:SemanticInstance; cpi:mode "EXAMPLE" . $this cpi:synthetic false . }""" ] ;
    sh:targetClass cpi:Threshold .

cpi:USES_METRICEdgeShape a sh:NodeShape ;
    sh:or ( [ sh:class cpi:PolicyRule ] ) ;
    sh:property [ sh:class cpi:RiskMetric ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:USES_METRIC ] ;
    sh:targetSubjectsOf cpi:USES_METRIC .

cpi:VERSION_OFEdgeShape a sh:NodeShape ;
    sh:or ( [ sh:class cpi:PolicyVersion ] ) ;
    sh:property [ sh:class cpi:CreditPolicy ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:VERSION_OF ] ;
    sh:targetSubjectsOf cpi:VERSION_OF .

cpi:ConditionValueListShape a sh:NodeShape ;
    sh:nodeKind sh:BlankNode ;
    sh:property [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path ( [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ] ;
    sh:sparql [ sh:message "CONDITIONS: finite RDF value list" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
        FILTER NOT EXISTS { $this rdf:rest* rdf:nil } }""" ] .

