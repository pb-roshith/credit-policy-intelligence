cpi:REQUIRES_APPROVALEdgeShape a sh:NodeShape ;
    sh:or ( [ sh:class cpi:PolicyRule ] [ sh:class cpi:Exception ] ) ;
    sh:property [ sh:class cpi:ApprovalRequirement ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:REQUIRES_APPROVAL ] ;
    sh:targetSubjectsOf cpi:REQUIRES_APPROVAL .

cpi:REQUIRES_APPROVAL_ABOVE_THRESHOLDEdgeShape a sh:NodeShape ;
