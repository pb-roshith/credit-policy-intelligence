            sh:minCount 0 ;
            sh:minLength 1 ;
            sh:path cpi:formula ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path rdfs:label ],
        [ sh:class cpi:DataAttribute ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:BINDS_TO_ATTRIBUTE ] ;
    sh:sparql [ sh:message "EXAMPLE_ISOLATION" ;
