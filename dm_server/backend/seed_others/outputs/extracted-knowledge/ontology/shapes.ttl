            sh:nodeKind sh:IRI ;
            sh:path cpi:HAS_RISK_ATTRIBUTE ],
        [ sh:class cpi:LoanApplication ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:APPLIES_FOR ],
        [ sh:class cpi:Subsector ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:IN_SUBSECTOR ],
        [ sh:class cpi:BorrowerType ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:HAS_BORROWER_TYPE ],
        [ sh:class cpi:Country ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:INCORPORATED_IN ],
        [ sh:class cpi:CorporateGroup ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:BELONGS_TO_GROUP ],
        [ sh:class cpi:CustomerSegment ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:MEMBER_OF_SEGMENT ],
        [ sh:class cpi:Sector ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:IN_SECTOR ],
        [ sh:class cpi:Geography ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:HAS_REPORTED_GEOGRAPHY ],
        [ sh:class cpi:Loan ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:BORROWS ],
        [ sh:class cpi:Industry ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:OPERATES_IN_INDUSTRY ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cpi:synthetic ],
        [ sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class cpi:SourcePassage ] [ sh:class cpi:OperationalEvidence ] ) ;
            sh:path cpi:sourceRef ],
        [ sh:class cpi:Geography ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:OPERATES_IN_GEOGRAPHY ],
        [ sh:datatype xsd:string ;
            sh:in ( "PROPOSED" "APPROVED" "REJECTED" "SUPERSEDED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cpi:status ],
        [ sh:class cpi:LegalEntity ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:HAS_PARENT_LEGAL_ENTITY ],
        [ sh:class cpi:Country ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:DOMICILED_IN ] ;
    sh:sparql [ sh:message "EXAMPLE_ISOLATION" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
            ?instance a cpi:SemanticInstance; cpi:mode "EXAMPLE" . $this cpi:synthetic false . }""" ],
        [ sh:message "SYNTHETIC_PROVENANCE" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
            $this cpi:synthetic false; cpi:sourceRef ?p . ?p cpi:synthetic true . }""" ] ;
    sh:targetClass cpi:Customer .

cpi:DENOMINATED_INEdgeShape a sh:NodeShape ;
    sh:or ( [ sh:class cpi:CreditRequest ] [ sh:class cpi:Facility ] [ sh:class cpi:Exposure ] [ sh:class cpi:Limit ] ) ;
    sh:property [ sh:class cpi:Currency ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:DENOMINATED_IN ] ;
    sh:targetSubjectsOf cpi:DENOMINATED_IN .

cpi:DERIVED_FROMEdgeShape a sh:NodeShape ;
    sh:or ( [ sh:class cpi:PolicyRule ] ) ;
    sh:property [ sh:class cpi:SourcePassage ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:DERIVED_FROM ] ;
    sh:targetSubjectsOf cpi:DERIVED_FROM .

cpi:DERIVED_FROM_POLICY_CLASSEdgeShape a sh:NodeShape ;
    sh:or ( [ sh:class cpi:PolicyRule ] ) ;
    sh:property [ sh:class cpi:PolicyClass ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:DERIVED_FROM_POLICY_CLASS ] ;
    sh:targetSubjectsOf cpi:DERIVED_FROM_POLICY_CLASS .

cpi:DOCUMENTS_PRODUCT_SCOPEEdgeShape a sh:NodeShape ;
    sh:or ( [ sh:class cpi:PolicyRule ] ) ;
    sh:property [ sh:class cpi:Product ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:DOCUMENTS_PRODUCT_SCOPE ] ;
    sh:targetSubjectsOf cpi:DOCUMENTS_PRODUCT_SCOPE .

cpi:DOMICILED_INEdgeShape a sh:NodeShape ;
    sh:or ( [ sh:class cpi:Party ] ) ;
    sh:property [ sh:class cpi:Country ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:DOMICILED_IN ] ;
    sh:targetSubjectsOf cpi:DOMICILED_IN .

cpi:DataAttributeShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cpi:synthetic ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path rdfs:label ],
        [ sh:datatype xsd:string ;
            sh:in ( "PROPOSED" "APPROVED" "REJECTED" "SUPERSEDED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cpi:status ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path cpi:attribute_name ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path cpi:entity_name ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path cpi:registry_reference ],
        [ sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class cpi:SourcePassage ] [ sh:class cpi:OperationalEvidence ] ) ;
            sh:path cpi:sourceRef ] ;
    sh:sparql [ sh:message "EXAMPLE_ISOLATION" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
            ?instance a cpi:SemanticInstance; cpi:mode "EXAMPLE" . $this cpi:synthetic false . }""" ],
        [ sh:message "SYNTHETIC_PROVENANCE" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
            $this cpi:synthetic false; cpi:sourceRef ?p . ?p cpi:synthetic true . }""" ] ;
    sh:targetClass cpi:DataAttribute .

cpi:DecisionOutcomeShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cpi:synthetic ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path rdfs:label ],
        [ sh:datatype xsd:string ;
            sh:in ( "PROPOSED" "APPROVED" "REJECTED" "SUPERSEDED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cpi:status ],
        [ sh:datatype xsd:string ;
            sh:in ( "PASS"^^xsd:string "BREACH"^^xsd:string "EXCEPTION"^^xsd:string "REFERRAL"^^xsd:string "WARNING"^^xsd:string "UNABLE_TO_ASSESS"^^xsd:string "NOT_APPLICABLE"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cpi:outcome_code ],
        [ sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class cpi:SourcePassage ] [ sh:class cpi:OperationalEvidence ] ) ;
            sh:path cpi:sourceRef ] ;
    sh:sparql [ sh:message "EXAMPLE_ISOLATION" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
            ?instance a cpi:SemanticInstance; cpi:mode "EXAMPLE" . $this cpi:synthetic false . }""" ],
        [ sh:message "SYNTHETIC_PROVENANCE" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
            $this cpi:synthetic false; cpi:sourceRef ?p . ?p cpi:synthetic true . }""" ] ;
    sh:targetClass cpi:DecisionOutcome .

cpi:EVALUATES_RISK_ATTRIBUTEEdgeShape a sh:NodeShape ;
    sh:or ( [ sh:class cpi:PolicyRule ] ) ;
    sh:property [ sh:class cpi:RiskAttribute ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:EVALUATES_RISK_ATTRIBUTE ] ;
    sh:targetSubjectsOf cpi:EVALUATES_RISK_ATTRIBUTE .

cpi:EVIDENCE_FOREdgeShape a sh:NodeShape ;
    sh:or ( [ sh:class cpi:ControlEvidence ] ) ;
    sh:property [ sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class cpi:LoanApplication ] [ sh:class cpi:PolicyRule ] [ sh:class cpi:Exception ] ) ;
            sh:path cpi:EVIDENCE_FOR ] ;
    sh:targetSubjectsOf cpi:EVIDENCE_FOR .

cpi:EXCEPTION_TOEdgeShape a sh:NodeShape ;
    sh:or ( [ sh:class cpi:Exception ] ) ;
    sh:property [ sh:class cpi:PolicyRule ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:EXCEPTION_TO ] ;
    sh:targetSubjectsOf cpi:EXCEPTION_TO .

cpi:EffectivePeriodShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:datatype xsd:string ;
            sh:in ( "PROPOSED" "APPROVED" "REJECTED" "SUPERSEDED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cpi:status ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cpi:synthetic ],
        [ sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class cpi:SourcePassage ] [ sh:class cpi:OperationalEvidence ] ) ;
            sh:path cpi:sourceRef ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path rdfs:label ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cpi:start_date ;
            sh:pattern "^\\d{4}-\\d{2}-\\d{2}$" ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path cpi:end_date ;
            sh:pattern "^\\d{4}-\\d{2}-\\d{2}$" ] ;
    sh:sparql [ sh:message "SYNTHETIC_PROVENANCE" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
            $this cpi:synthetic false; cpi:sourceRef ?p . ?p cpi:synthetic true . }""" ],
        [ sh:message "EFFECTIVE_DATES" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cpi:start_date ?s; cpi:end_date ?e . FILTER (?e < ?s) }""" ],
        [ sh:message "EXAMPLE_ISOLATION" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
            ?instance a cpi:SemanticInstance; cpi:mode "EXAMPLE" . $this cpi:synthetic false . }""" ] ;
    sh:targetClass cpi:EffectivePeriod .

cpi:EvidenceRequirementShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cpi:synthetic ],
        [ sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class cpi:SourcePassage ] [ sh:class cpi:OperationalEvidence ] ) ;
            sh:path cpi:sourceRef ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path rdfs:label ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:minInclusive 0 ;
            sh:path cpi:maximum_age_days ],
        [ sh:datatype xsd:string ;
            sh:in ( "PROPOSED" "APPROVED" "REJECTED" "SUPERSEDED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cpi:status ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path cpi:evidence_type ] ;
    sh:sparql [ sh:message "SYNTHETIC_PROVENANCE" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
            $this cpi:synthetic false; cpi:sourceRef ?p . ?p cpi:synthetic true . }""" ],
        [ sh:message "EXAMPLE_ISOLATION" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
            ?instance a cpi:SemanticInstance; cpi:mode "EXAMPLE" . $this cpi:synthetic false . }""" ] ;
    sh:targetClass cpi:EvidenceRequirement .

cpi:ExceptionShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path rdfs:label ],
        [ sh:class cpi:ApprovalRequirement ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:REQUIRES_APPROVAL ],
        [ sh:datatype xsd:string ;
            sh:in ( "PROPOSED" "APPROVED" "REJECTED" "SUPERSEDED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cpi:status ],
        [ sh:class cpi:PolicyRule ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:IMPLEMENTED_BY_RULE ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path cpi:exception_reference ],
        [ sh:class cpi:PolicyRule ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:EXCEPTION_TO ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:minLength 1 ;
            sh:path cpi:rationale ],
        [ sh:class cpi:ConditionGroup ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:HAS_CONDITION ],
        [ sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class cpi:SourcePassage ] [ sh:class cpi:OperationalEvidence ] ) ;
            sh:path cpi:sourceRef ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cpi:synthetic ],
        [ sh:class cpi:EffectivePeriod ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:HAS_EFFECTIVE_PERIOD ] ;
    sh:sparql [ sh:message "EXCEPTION_LINKS: alternative version" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cpi:EXCEPTION_TO ?base; cpi:IMPLEMENTED_BY_RULE ?r .
                ?base cpi:PART_OF_VERSION ?v1 . ?r cpi:PART_OF_VERSION ?v2 . FILTER (?v1 != ?v2) }""" ],
        [ sh:message "EXCEPTION_LINKS" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cpi:EXCEPTION_TO ?base . FILTER NOT EXISTS { ?base cpi:HAS_EXCEPTION $this } }""" ],
        [ sh:message "EXAMPLE_ISOLATION" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
            ?instance a cpi:SemanticInstance; cpi:mode "EXAMPLE" . $this cpi:synthetic false . }""" ],
        [ sh:message "SYNTHETIC_PROVENANCE" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
            $this cpi:synthetic false; cpi:sourceRef ?p . ?p cpi:synthetic true . }""" ],
        [ sh:message "EXCEPTION_LINKS: alternative kind" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cpi:IMPLEMENTED_BY_RULE ?r .
                FILTER NOT EXISTS { ?r cpi:rule_kind "EXCEPTION_RULE"^^xsd:string } }""" ] ;
    sh:targetClass cpi:Exception .

cpi:ExposureShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path cpi:as_of ;
            sh:pattern "^\\d{4}-\\d{2}-\\d{2}$" ],
        [ sh:class cpi:Currency ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:DENOMINATED_IN ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path rdfs:label ],
        [ sh:class cpi:Limit ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:SUBJECT_TO_LIMIT ],
        [ sh:class cpi:RiskObservation ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:HAS_RISK_OBSERVATION ],
        [ sh:class cpi:RiskAttribute ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:HAS_RISK_ATTRIBUTE ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cpi:synthetic ],
        [ sh:datatype xsd:string ;
            sh:in ( "PROPOSED" "APPROVED" "REJECTED" "SUPERSEDED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cpi:status ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:minInclusive 0 ;
            sh:path cpi:amount ],
        [ sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class cpi:SourcePassage ] [ sh:class cpi:OperationalEvidence ] ) ;
            sh:path cpi:sourceRef ],
        [ sh:class cpi:Country ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:HAS_COUNTRY_OF_RISK ] ;
    sh:sparql [ sh:message "EXAMPLE_ISOLATION" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
            ?instance a cpi:SemanticInstance; cpi:mode "EXAMPLE" . $this cpi:synthetic false . }""" ],
        [ sh:message "SYNTHETIC_PROVENANCE" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
            $this cpi:synthetic false; cpi:sourceRef ?p . ?p cpi:synthetic true . }""" ] ;
    sh:targetClass cpi:Exposure .

cpi:FacilityShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:minCount 0 ;
            sh:path cpi:currency ],
        [ sh:class cpi:Guarantee ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:HAS_GUARANTEE ],
        [ sh:class cpi:Jurisdiction ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:BOOKED_IN_JURISDICTION ],
        [ sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class cpi:SourcePassage ] [ sh:class cpi:OperationalEvidence ] ) ;
            sh:path cpi:sourceRef ],
        [ sh:minCount 0 ;
            sh:path cpi:loan_reference ],
        [ sh:class cpi:BusinessActivity ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:HAS_BUSINESS_ACTIVITY ],
        [ sh:class cpi:BookingLocation ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:BOOKED_AT ],
        [ sh:class cpi:RiskGrade ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:HAS_RISK_GRADE ],
        [ sh:class cpi:Product ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:HAS_PRODUCT ],
        [ sh:class cpi:RiskObservation ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:HAS_RISK_OBSERVATION ],
        [ sh:class cpi:Limit ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:SUBJECT_TO_LIMIT ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cpi:synthetic ],
        [ sh:class cpi:Collateral ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:HAS_COLLATERAL ],
        [ sh:class cpi:Tenant ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:HAS_TENANT ],
        [ sh:class cpi:Exposure ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:HAS_EXPOSURE ],
        [ sh:class cpi:PolicyVersion ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:GOVERNED_BY ],
        [ sh:datatype xsd:string ;
            sh:in ( "PROPOSED" "APPROVED" "REJECTED" "SUPERSEDED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cpi:status ],
        [ sh:class cpi:Currency ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:DENOMINATED_IN ],
        [ sh:class cpi:RiskAttribute ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:HAS_RISK_ATTRIBUTE ],
        [ sh:class cpi:Counterparty ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:HAS_COUNTERPARTY ],
        [ sh:class cpi:Lender ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:HAS_LENDER ],
        [ sh:class cpi:Purpose ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:HAS_PURPOSE ],
        [ sh:class cpi:Tenor ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:HAS_TENOR ],
        [ sh:datatype xsd:string ;
