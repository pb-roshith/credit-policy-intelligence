@prefix cpi: <urn:cpi:ontology:credit-policy:> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cpi:APPLIES_FOREdgeShape a sh:NodeShape ;
    sh:or ( [ sh:class cpi:Borrower ] ) ;
    sh:property [ sh:class cpi:LoanApplication ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:APPLIES_FOR ] ;
    sh:targetSubjectsOf cpi:APPLIES_FOR .

cpi:APPLIES_INEdgeShape a sh:NodeShape ;
    sh:or ( [ sh:class cpi:PolicyVersion ] [ sh:class cpi:PolicyRule ] ) ;
    sh:property [ sh:class cpi:Geography ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:APPLIES_IN ] ;
    sh:targetSubjectsOf cpi:APPLIES_IN .

cpi:APPLIES_TO_BORROWER_TYPEEdgeShape a sh:NodeShape ;
    sh:or ( [ sh:class cpi:PolicyVersion ] [ sh:class cpi:PolicyRule ] ) ;
    sh:property [ sh:class cpi:BorrowerType ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:APPLIES_TO_BORROWER_TYPE ] ;
    sh:targetSubjectsOf cpi:APPLIES_TO_BORROWER_TYPE .

cpi:APPLIES_TO_INDUSTRYEdgeShape a sh:NodeShape ;
    sh:or ( [ sh:class cpi:PolicyVersion ] [ sh:class cpi:PolicyRule ] ) ;
    sh:property [ sh:class cpi:Industry ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:APPLIES_TO_INDUSTRY ] ;
    sh:targetSubjectsOf cpi:APPLIES_TO_INDUSTRY .

cpi:APPLIES_TO_INDUSTRY_TIEREdgeShape a sh:NodeShape ;
    sh:or ( [ sh:class cpi:PolicyVersion ] [ sh:class cpi:PolicyRule ] ) ;
    sh:property [ sh:class cpi:IndustryTier ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:APPLIES_TO_INDUSTRY_TIER ] ;
    sh:targetSubjectsOf cpi:APPLIES_TO_INDUSTRY_TIER .

cpi:APPLIES_TO_PRODUCTEdgeShape a sh:NodeShape ;
    sh:or ( [ sh:class cpi:PolicyVersion ] [ sh:class cpi:PolicyRule ] ) ;
    sh:property [ sh:class cpi:Product ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:APPLIES_TO_PRODUCT ] ;
    sh:targetSubjectsOf cpi:APPLIES_TO_PRODUCT .

cpi:APPLIES_TO_SEGMENTEdgeShape a sh:NodeShape ;
    sh:or ( [ sh:class cpi:PolicyVersion ] [ sh:class cpi:PolicyRule ] ) ;
    sh:property [ sh:class cpi:CustomerSegment ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:APPLIES_TO_SEGMENT ] ;
    sh:targetSubjectsOf cpi:APPLIES_TO_SEGMENT .

cpi:APPLIES_TO_SUBSECTOREdgeShape a sh:NodeShape ;
    sh:or ( [ sh:class cpi:PolicyVersion ] [ sh:class cpi:PolicyRule ] ) ;
    sh:property [ sh:class cpi:Subsector ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:APPLIES_TO_SUBSECTOR ] ;
    sh:targetSubjectsOf cpi:APPLIES_TO_SUBSECTOR .

cpi:ASSESSES_RULEEdgeShape a sh:NodeShape ;
    sh:or ( [ sh:class cpi:RuleAssessment ] ) ;
    sh:property [ sh:class cpi:PolicyRule ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:ASSESSES_RULE ] ;
    sh:targetSubjectsOf cpi:ASSESSES_RULE .

cpi:ApprovalAuthorityShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:datatype xsd:string ;
            sh:in ( "PROPOSED" "APPROVED" "REJECTED" "SUPERSEDED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cpi:status ],
        [ sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class cpi:SourcePassage ] [ sh:class cpi:OperationalEvidence ] ) ;
            sh:path cpi:sourceRef ],
        [ sh:datatype xsd:string ;
            sh:in ( "ROLE"^^xsd:string "COMMITTEE"^^xsd:string "UNSPECIFIED"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cpi:authority_kind ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path cpi:authority_code ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path rdfs:label ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cpi:synthetic ] ;
    sh:sparql [ sh:message "EXAMPLE_ISOLATION" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
            ?instance a cpi:SemanticInstance; cpi:mode "EXAMPLE" . $this cpi:synthetic false . }""" ],
        [ sh:message "SYNTHETIC_PROVENANCE" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
            $this cpi:synthetic false; cpi:sourceRef ?p . ?p cpi:synthetic true . }""" ] ;
    sh:targetClass cpi:ApprovalAuthority .

cpi:ApprovalRequirementShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path rdfs:label ],
        [ sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class cpi:SourcePassage ] [ sh:class cpi:OperationalEvidence ] ) ;
            sh:path cpi:sourceRef ],
        [ sh:datatype xsd:string ;
            sh:in ( "PROPOSED" "APPROVED" "REJECTED" "SUPERSEDED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cpi:status ],
        [ sh:datatype xsd:string ;
            sh:in ( "APPROVAL"^^xsd:string "ESCALATION"^^xsd:string "CONCURRENCE"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cpi:decision_type ],
        [ sh:class cpi:EvidenceRequirement ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:REQUIRES_EVIDENCE ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:minLength 1 ;
            sh:path cpi:notes ],
        [ sh:class cpi:ConditionGroup ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:HAS_CONDITION ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cpi:synthetic ],
        [ sh:class cpi:ApprovalAuthority ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:REQUIRES_APPROVAL_FROM ] ;
    sh:sparql [ sh:message "SYNTHETIC_PROVENANCE" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
            $this cpi:synthetic false; cpi:sourceRef ?p . ?p cpi:synthetic true . }""" ],
        [ sh:message "EXAMPLE_ISOLATION" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
            ?instance a cpi:SemanticInstance; cpi:mode "EXAMPLE" . $this cpi:synthetic false . }""" ] ;
    sh:targetClass cpi:ApprovalRequirement .

cpi:AssertionCoverageShape a sh:NodeShape ;
    sh:sparql [ sh:message "SOURCE_REFERENCES: direct edge requires assertion evidence" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
        $this ?p ?o . FILTER (?p IN (cpi:HAS_APPLICABILITY, cpi:HAS_EXCLUSION, cpi:APPLIES_FOR, cpi:REQUESTS_PRODUCT, cpi:RESULTS_IN, cpi:BORROWS, cpi:OF_PRODUCT, cpi:GOVERNED_BY, cpi:VERSION_OF, cpi:CONTAINS_SECTION, cpi:PART_OF_VERSION, cpi:PARENT_SECTION, cpi:CONTAINS_RULE, cpi:APPLIES_TO_PRODUCT, cpi:APPLIES_TO_SEGMENT, cpi:APPLIES_IN, cpi:MEMBER_OF_SEGMENT, cpi:USES_METRIC, cpi:HAS_THRESHOLD, cpi:MEASURED_BY, cpi:HAS_CONDITION, cpi:HAS_MEMBER, cpi:HAS_EXCEPTION, cpi:EXCEPTION_TO, cpi:IMPLEMENTED_BY_RULE, cpi:REQUIRES_APPROVAL, cpi:REQUIRES_APPROVAL_FROM, cpi:REQUIRES_EVIDENCE, cpi:SATISFIES_REQUIREMENT, cpi:EVIDENCE_FOR, cpi:HAS_EFFECTIVE_PERIOD, cpi:DERIVED_FROM, cpi:SOURCE_IN_VERSION, cpi:CLASSIFIED_AS, cpi:BINDS_TO_ATTRIBUTE, cpi:OPERATES_IN_INDUSTRY, cpi:OPERATES_IN_GEOGRAPHY, cpi:HAS_REPORTED_GEOGRAPHY, cpi:INCORPORATED_IN, cpi:DOMICILED_IN, cpi:HAS_COUNTRY_OF_RISK, cpi:IN_REGION, cpi:BELONGS_TO_GROUP, cpi:HAS_PARENT_LEGAL_ENTITY, cpi:IN_SECTOR, cpi:IN_SUBSECTOR, cpi:HAS_BUSINESS_ACTIVITY, cpi:HAS_BORROWER_TYPE, cpi:HAS_CREDIT_RATING, cpi:HAS_RISK_GRADE, cpi:HAS_RISK_ATTRIBUTE, cpi:HAS_RISK_OBSERVATION, cpi:HAS_EXPOSURE, cpi:SUBJECT_TO_LIMIT, cpi:REQUESTED_BY, cpi:REQUESTS_FACILITY, cpi:HAS_PRODUCT, cpi:HAS_COUNTERPARTY, cpi:HAS_SPONSOR, cpi:HAS_LENDER, cpi:HAS_TENOR, cpi:HAS_RECOMMENDED_TENOR, cpi:HAS_TENANT, cpi:HAS_COLLATERAL, cpi:HAS_GUARANTEE, cpi:PROVIDED_BY_GUARANTOR, cpi:BOOKED_IN_JURISDICTION, cpi:BOOKED_AT, cpi:LOCATED_IN_JURISDICTION, cpi:DENOMINATED_IN, cpi:HAS_PURPOSE, cpi:HAS_VERSION, cpi:DERIVED_FROM_POLICY_CLASS, cpi:CONCERNS, cpi:REQUIRES_APPROVAL_ON_BREACH, cpi:REQUIRES_APPROVAL_ABOVE_THRESHOLD, cpi:APPLIES_TO_INDUSTRY, cpi:APPLIES_TO_BORROWER_TYPE, cpi:APPLIES_TO_SUBSECTOR, cpi:APPLIES_TO_INDUSTRY_TIER, cpi:DOCUMENTS_PRODUCT_SCOPE, cpi:COMPARES_SCOPE_VALUE, cpi:EVALUATES_RISK_ATTRIBUTE, cpi:TESTS_ATTRIBUTE, cpi:OBSERVES_DATA_ATTRIBUTE, cpi:HAS_RULE_ASSESSMENT, cpi:ASSESSES_RULE, cpi:HAS_OUTCOME))
        FILTER NOT EXISTS { ?a a cpi:Assertion; rdf:subject $this; rdf:predicate ?p; rdf:object ?o; cpi:sourceRef ?source } }""" ] ;
    sh:targetSubjectsOf cpi:APPLIES_FOR,
        cpi:APPLIES_IN,
        cpi:APPLIES_TO_BORROWER_TYPE,
        cpi:APPLIES_TO_INDUSTRY,
        cpi:APPLIES_TO_INDUSTRY_TIER,
        cpi:APPLIES_TO_PRODUCT,
        cpi:APPLIES_TO_SEGMENT,
        cpi:APPLIES_TO_SUBSECTOR,
        cpi:ASSESSES_RULE,
        cpi:BELONGS_TO_GROUP,
        cpi:BINDS_TO_ATTRIBUTE,
        cpi:BOOKED_AT,
        cpi:BOOKED_IN_JURISDICTION,
        cpi:BORROWS,
        cpi:CLASSIFIED_AS,
        cpi:COMPARES_SCOPE_VALUE,
        cpi:CONCERNS,
        cpi:CONTAINS_RULE,
        cpi:CONTAINS_SECTION,
        cpi:DENOMINATED_IN,
        cpi:DERIVED_FROM,
        cpi:DERIVED_FROM_POLICY_CLASS,
        cpi:DOCUMENTS_PRODUCT_SCOPE,
        cpi:DOMICILED_IN,
        cpi:EVALUATES_RISK_ATTRIBUTE,
        cpi:EVIDENCE_FOR,
        cpi:EXCEPTION_TO,
        cpi:GOVERNED_BY,
        cpi:HAS_APPLICABILITY,
        cpi:HAS_BORROWER_TYPE,
        cpi:HAS_BUSINESS_ACTIVITY,
        cpi:HAS_COLLATERAL,
        cpi:HAS_CONDITION,
        cpi:HAS_COUNTERPARTY,
        cpi:HAS_COUNTRY_OF_RISK,
        cpi:HAS_CREDIT_RATING,
        cpi:HAS_EFFECTIVE_PERIOD,
        cpi:HAS_EXCEPTION,
        cpi:HAS_EXCLUSION,
        cpi:HAS_EXPOSURE,
        cpi:HAS_GUARANTEE,
        cpi:HAS_LENDER,
        cpi:HAS_MEMBER,
        cpi:HAS_OUTCOME,
        cpi:HAS_PARENT_LEGAL_ENTITY,
        cpi:HAS_PRODUCT,
        cpi:HAS_PURPOSE,
        cpi:HAS_RECOMMENDED_TENOR,
        cpi:HAS_REPORTED_GEOGRAPHY,
        cpi:HAS_RISK_ATTRIBUTE,
        cpi:HAS_RISK_GRADE,
        cpi:HAS_RISK_OBSERVATION,
        cpi:HAS_RULE_ASSESSMENT,
        cpi:HAS_SPONSOR,
        cpi:HAS_TENANT,
        cpi:HAS_TENOR,
        cpi:HAS_THRESHOLD,
        cpi:HAS_VERSION,
        cpi:IMPLEMENTED_BY_RULE,
        cpi:INCORPORATED_IN,
        cpi:IN_REGION,
        cpi:IN_SECTOR,
        cpi:IN_SUBSECTOR,
        cpi:LOCATED_IN_JURISDICTION,
        cpi:MEASURED_BY,
        cpi:MEMBER_OF_SEGMENT,
        cpi:OBSERVES_DATA_ATTRIBUTE,
        cpi:OF_PRODUCT,
        cpi:OPERATES_IN_GEOGRAPHY,
        cpi:OPERATES_IN_INDUSTRY,
        cpi:PARENT_SECTION,
        cpi:PART_OF_VERSION,
        cpi:PROVIDED_BY_GUARANTOR,
        cpi:REQUESTED_BY,
        cpi:REQUESTS_FACILITY,
        cpi:REQUESTS_PRODUCT,
        cpi:REQUIRES_APPROVAL,
        cpi:REQUIRES_APPROVAL_ABOVE_THRESHOLD,
        cpi:REQUIRES_APPROVAL_FROM,
        cpi:REQUIRES_APPROVAL_ON_BREACH,
        cpi:REQUIRES_EVIDENCE,
        cpi:RESULTS_IN,
        cpi:SATISFIES_REQUIREMENT,
        cpi:SOURCE_IN_VERSION,
        cpi:SUBJECT_TO_LIMIT,
        cpi:TESTS_ATTRIBUTE,
        cpi:USES_METRIC,
        cpi:VERSION_OF .

cpi:AssertionShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:in ( cpi:HAS_APPLICABILITY cpi:HAS_EXCLUSION cpi:APPLIES_FOR cpi:REQUESTS_PRODUCT cpi:RESULTS_IN cpi:BORROWS cpi:OF_PRODUCT cpi:GOVERNED_BY cpi:VERSION_OF cpi:CONTAINS_SECTION cpi:PART_OF_VERSION cpi:PARENT_SECTION cpi:CONTAINS_RULE cpi:APPLIES_TO_PRODUCT cpi:APPLIES_TO_SEGMENT cpi:APPLIES_IN cpi:MEMBER_OF_SEGMENT cpi:USES_METRIC cpi:HAS_THRESHOLD cpi:MEASURED_BY cpi:HAS_CONDITION cpi:HAS_MEMBER cpi:HAS_EXCEPTION cpi:EXCEPTION_TO cpi:IMPLEMENTED_BY_RULE cpi:REQUIRES_APPROVAL cpi:REQUIRES_APPROVAL_FROM cpi:REQUIRES_EVIDENCE cpi:SATISFIES_REQUIREMENT cpi:EVIDENCE_FOR cpi:HAS_EFFECTIVE_PERIOD cpi:DERIVED_FROM cpi:SOURCE_IN_VERSION cpi:CLASSIFIED_AS cpi:BINDS_TO_ATTRIBUTE cpi:OPERATES_IN_INDUSTRY cpi:OPERATES_IN_GEOGRAPHY cpi:HAS_REPORTED_GEOGRAPHY cpi:INCORPORATED_IN cpi:DOMICILED_IN cpi:HAS_COUNTRY_OF_RISK cpi:IN_REGION cpi:BELONGS_TO_GROUP cpi:HAS_PARENT_LEGAL_ENTITY cpi:IN_SECTOR cpi:IN_SUBSECTOR cpi:HAS_BUSINESS_ACTIVITY cpi:HAS_BORROWER_TYPE cpi:HAS_CREDIT_RATING cpi:HAS_RISK_GRADE cpi:HAS_RISK_ATTRIBUTE cpi:HAS_RISK_OBSERVATION cpi:HAS_EXPOSURE cpi:SUBJECT_TO_LIMIT cpi:REQUESTED_BY cpi:REQUESTS_FACILITY cpi:HAS_PRODUCT cpi:HAS_COUNTERPARTY cpi:HAS_SPONSOR cpi:HAS_LENDER cpi:HAS_TENOR cpi:HAS_RECOMMENDED_TENOR cpi:HAS_TENANT cpi:HAS_COLLATERAL cpi:HAS_GUARANTEE cpi:PROVIDED_BY_GUARANTOR cpi:BOOKED_IN_JURISDICTION cpi:BOOKED_AT cpi:LOCATED_IN_JURISDICTION cpi:DENOMINATED_IN cpi:HAS_PURPOSE cpi:HAS_VERSION cpi:DERIVED_FROM_POLICY_CLASS cpi:CONCERNS cpi:REQUIRES_APPROVAL_ON_BREACH cpi:REQUIRES_APPROVAL_ABOVE_THRESHOLD cpi:APPLIES_TO_INDUSTRY cpi:APPLIES_TO_BORROWER_TYPE cpi:APPLIES_TO_SUBSECTOR cpi:APPLIES_TO_INDUSTRY_TIER cpi:DOCUMENTS_PRODUCT_SCOPE cpi:COMPARES_SCOPE_VALUE cpi:EVALUATES_RISK_ATTRIBUTE cpi:TESTS_ATTRIBUTE cpi:OBSERVES_DATA_ATTRIBUTE cpi:HAS_RULE_ASSESSMENT cpi:ASSESSES_RULE cpi:HAS_OUTCOME ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path rdf:predicate ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path rdf:object ],
        [ sh:datatype xsd:string ;
            sh:in ( "PROPOSED" "APPROVED" "REJECTED" "SUPERSEDED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cpi:status ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path rdf:subject ],
        [ sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class cpi:SourcePassage ] [ sh:class cpi:OperationalEvidence ] ) ;
            sh:path cpi:sourceRef ] ;
    sh:sparql [ sh:message "DUPLICATE_RELATIONSHIP" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
        $this rdf:subject ?s; rdf:predicate ?p; rdf:object ?o .
        ?other a cpi:Assertion; rdf:subject ?s; rdf:predicate ?p; rdf:object ?o . FILTER (?other != $this) }""" ],
        [ sh:message "ASSERTION_TRIPLE: reification must identify an asserted triple" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
        $this rdf:subject ?s; rdf:predicate ?p; rdf:object ?o . FILTER NOT EXISTS { ?s ?p ?o } }""" ] ;
    sh:targetClass cpi:Assertion .

cpi:BELONGS_TO_GROUPEdgeShape a sh:NodeShape ;
    sh:or ( [ sh:class cpi:Party ] ) ;
    sh:property [ sh:class cpi:CorporateGroup ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:BELONGS_TO_GROUP ] ;
    sh:targetSubjectsOf cpi:BELONGS_TO_GROUP .

cpi:BINDS_TO_ATTRIBUTEEdgeShape a sh:NodeShape ;
    sh:or ( [ sh:class cpi:RiskMetric ] ) ;
    sh:property [ sh:class cpi:DataAttribute ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:BINDS_TO_ATTRIBUTE ] ;
    sh:targetSubjectsOf cpi:BINDS_TO_ATTRIBUTE .

cpi:BOOKED_ATEdgeShape a sh:NodeShape ;
    sh:or ( [ sh:class cpi:Facility ] ) ;
    sh:property [ sh:class cpi:BookingLocation ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:BOOKED_AT ] ;
    sh:targetSubjectsOf cpi:BOOKED_AT .

cpi:BOOKED_IN_JURISDICTIONEdgeShape a sh:NodeShape ;
    sh:or ( [ sh:class cpi:Facility ] ) ;
    sh:property [ sh:class cpi:Jurisdiction ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:BOOKED_IN_JURISDICTION ] ;
    sh:targetSubjectsOf cpi:BOOKED_IN_JURISDICTION .

cpi:BORROWSEdgeShape a sh:NodeShape ;
    sh:or ( [ sh:class cpi:Borrower ] ) ;
    sh:property [ sh:class cpi:Loan ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:BORROWS ] ;
    sh:targetSubjectsOf cpi:BORROWS .

cpi:BookingLocationShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class cpi:SourcePassage ] [ sh:class cpi:OperationalEvidence ] ) ;
            sh:path cpi:sourceRef ],
        [ sh:datatype xsd:string ;
            sh:in ( "PROPOSED" "APPROVED" "REJECTED" "SUPERSEDED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cpi:status ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cpi:synthetic ],
        [ sh:class cpi:Jurisdiction ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:LOCATED_IN_JURISDICTION ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path rdfs:label ] ;
    sh:sparql [ sh:message "SYNTHETIC_PROVENANCE" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
            $this cpi:synthetic false; cpi:sourceRef ?p . ?p cpi:synthetic true . }""" ],
        [ sh:message "EXAMPLE_ISOLATION" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
            ?instance a cpi:SemanticInstance; cpi:mode "EXAMPLE" . $this cpi:synthetic false . }""" ] ;
    sh:targetClass cpi:BookingLocation .

cpi:BorrowerShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:class cpi:Geography ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:OPERATES_IN_GEOGRAPHY ],
        [ sh:class cpi:CorporateGroup ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:BELONGS_TO_GROUP ],
        [ sh:class cpi:BorrowerType ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:HAS_BORROWER_TYPE ],
        [ sh:class cpi:LoanApplication ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:APPLIES_FOR ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:minLength 1 ;
            sh:path cpi:customer_reference ],
        [ sh:class cpi:CustomerSegment ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:MEMBER_OF_SEGMENT ],
        [ sh:class cpi:Subsector ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:IN_SUBSECTOR ],
        [ sh:class cpi:RiskObservation ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:HAS_RISK_OBSERVATION ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path rdfs:label ],
        [ sh:class cpi:Geography ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:HAS_REPORTED_GEOGRAPHY ],
        [ sh:class cpi:CreditRating ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:HAS_CREDIT_RATING ],
        [ sh:class cpi:Industry ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:OPERATES_IN_INDUSTRY ],
        [ sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class cpi:SourcePassage ] [ sh:class cpi:OperationalEvidence ] ) ;
            sh:path cpi:sourceRef ],
        [ sh:datatype xsd:string ;
            sh:in ( "PROPOSED" "APPROVED" "REJECTED" "SUPERSEDED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cpi:status ],
        [ sh:class cpi:Sector ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:IN_SECTOR ],
        [ sh:class cpi:Country ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:HAS_COUNTRY_OF_RISK ],
        [ sh:class cpi:BusinessActivity ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:HAS_BUSINESS_ACTIVITY ],
        [ sh:datatype xsd:string ;
            sh:in ( "PERSON"^^xsd:string "ORGANIZATION"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path cpi:customer_kind ],
        [ sh:class cpi:Country ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:INCORPORATED_IN ],
        [ sh:class cpi:RiskGrade ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:HAS_RISK_GRADE ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cpi:synthetic ],
        [ sh:class cpi:RiskAttribute ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:HAS_RISK_ATTRIBUTE ],
        [ sh:class cpi:Loan ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:BORROWS ],
        [ sh:class cpi:Country ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:DOMICILED_IN ],
        [ sh:class cpi:Exposure ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:HAS_EXPOSURE ],
        [ sh:class cpi:LegalEntity ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:HAS_PARENT_LEGAL_ENTITY ] ;
    sh:sparql [ sh:message "EXAMPLE_ISOLATION" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
            ?instance a cpi:SemanticInstance; cpi:mode "EXAMPLE" . $this cpi:synthetic false . }""" ],
        [ sh:message "SYNTHETIC_PROVENANCE" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
            $this cpi:synthetic false; cpi:sourceRef ?p . ?p cpi:synthetic true . }""" ] ;
    sh:targetClass cpi:Borrower .

cpi:BorrowerTypeShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cpi:synthetic ],
        [ sh:datatype xsd:string ;
            sh:in ( "PROPOSED" "APPROVED" "REJECTED" "SUPERSEDED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cpi:status ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path rdfs:label ],
        [ sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class cpi:SourcePassage ] [ sh:class cpi:OperationalEvidence ] ) ;
            sh:path cpi:sourceRef ] ;
    sh:sparql [ sh:message "SYNTHETIC_PROVENANCE" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
            $this cpi:synthetic false; cpi:sourceRef ?p . ?p cpi:synthetic true . }""" ],
        [ sh:message "EXAMPLE_ISOLATION" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
            ?instance a cpi:SemanticInstance; cpi:mode "EXAMPLE" . $this cpi:synthetic false . }""" ] ;
    sh:targetClass cpi:BorrowerType .

cpi:BusinessActivityShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:datatype xsd:string ;
            sh:in ( "PROPOSED" "APPROVED" "REJECTED" "SUPERSEDED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cpi:status ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cpi:synthetic ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path rdfs:label ],
        [ sh:class cpi:Subsector ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:IN_SUBSECTOR ],
        [ sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class cpi:SourcePassage ] [ sh:class cpi:OperationalEvidence ] ) ;
            sh:path cpi:sourceRef ] ;
    sh:sparql [ sh:message "SYNTHETIC_PROVENANCE" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
            $this cpi:synthetic false; cpi:sourceRef ?p . ?p cpi:synthetic true . }""" ],
        [ sh:message "EXAMPLE_ISOLATION" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
            ?instance a cpi:SemanticInstance; cpi:mode "EXAMPLE" . $this cpi:synthetic false . }""" ] ;
    sh:targetClass cpi:BusinessActivity .

cpi:CLASSIFIED_ASEdgeShape a sh:NodeShape ;
    sh:or ( [ sh:class cpi:PolicyRule ] [ sh:class cpi:Product ] [ sh:class cpi:CustomerSegment ] [ sh:class cpi:RiskMetric ] [ sh:class cpi:Geography ] ) ;
    sh:property [ sh:class cpi:TaxonomyConcept ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:CLASSIFIED_AS ] ;
    sh:targetSubjectsOf cpi:CLASSIFIED_AS .

cpi:COMPARES_SCOPE_VALUEEdgeShape a sh:NodeShape ;
    sh:or ( [ sh:class cpi:Condition ] ) ;
    sh:property [ sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class cpi:Industry ] [ sh:class cpi:Sector ] [ sh:class cpi:Subsector ] [ sh:class cpi:IndustryTier ] [ sh:class cpi:BorrowerType ] [ sh:class cpi:Product ] [ sh:class cpi:CustomerSegment ] [ sh:class cpi:Geography ] ) ;
            sh:path cpi:COMPARES_SCOPE_VALUE ] ;
    sh:targetSubjectsOf cpi:COMPARES_SCOPE_VALUE .

cpi:CONCERNSEdgeShape a sh:NodeShape ;
    sh:or ( [ sh:class cpi:PolicyRule ] ) ;
    sh:property [ sh:class cpi:PolicyConcern ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:CONCERNS ] ;
    sh:targetSubjectsOf cpi:CONCERNS .

cpi:CONTAINS_RULEEdgeShape a sh:NodeShape ;
    sh:or ( [ sh:class cpi:PolicyVersion ] [ sh:class cpi:PolicySection ] ) ;
    sh:property [ sh:class cpi:PolicyRule ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:CONTAINS_RULE ] ;
    sh:targetSubjectsOf cpi:CONTAINS_RULE .

cpi:CONTAINS_SECTIONEdgeShape a sh:NodeShape ;
    sh:or ( [ sh:class cpi:PolicyVersion ] ) ;
    sh:property [ sh:class cpi:PolicySection ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:CONTAINS_SECTION ] ;
    sh:targetSubjectsOf cpi:CONTAINS_SECTION .

cpi:CollateralShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class cpi:SourcePassage ] [ sh:class cpi:OperationalEvidence ] ) ;
            sh:path cpi:sourceRef ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path rdfs:label ],
        [ sh:class cpi:Tenant ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:HAS_TENANT ],
        [ sh:datatype xsd:string ;
            sh:in ( "PROPOSED" "APPROVED" "REJECTED" "SUPERSEDED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cpi:status ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cpi:synthetic ] ;
    sh:sparql [ sh:message "EXAMPLE_ISOLATION" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
            ?instance a cpi:SemanticInstance; cpi:mode "EXAMPLE" . $this cpi:synthetic false . }""" ],
        [ sh:message "SYNTHETIC_PROVENANCE" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
            $this cpi:synthetic false; cpi:sourceRef ?p . ?p cpi:synthetic true . }""" ] ;
    sh:targetClass cpi:Collateral .

cpi:ConditionGroupShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path rdfs:label ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cpi:synthetic ],
        [ sh:datatype xsd:string ;
            sh:in ( "PROPOSED" "APPROVED" "REJECTED" "SUPERSEDED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cpi:status ],
        [ sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class cpi:SourcePassage ] [ sh:class cpi:OperationalEvidence ] ) ;
            sh:path cpi:sourceRef ],
        [ sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class cpi:Condition ] [ sh:class cpi:ConditionGroup ] ) ;
            sh:path cpi:HAS_MEMBER ],
        [ sh:datatype xsd:string ;
            sh:in ( "AND"^^xsd:string "OR"^^xsd:string "NOT"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cpi:logic ] ;
    sh:sparql [ sh:message "CONDITION_LOGIC: NOT cardinality" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cpi:logic "NOT"^^xsd:string; cpi:HAS_MEMBER ?a, ?b . FILTER (?a != ?b) }""" ],
        [ sh:message "CONDITION_LOGIC: cycle" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cpi:HAS_MEMBER+ $this }""" ],
        [ sh:message "SYNTHETIC_PROVENANCE" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
            $this cpi:synthetic false; cpi:sourceRef ?p . ?p cpi:synthetic true . }""" ],
        [ sh:message "EXAMPLE_ISOLATION" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
            ?instance a cpi:SemanticInstance; cpi:mode "EXAMPLE" . $this cpi:synthetic false . }""" ] ;
    sh:targetClass cpi:ConditionGroup .

cpi:ConditionShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cpi:synthetic ],
        [ sh:datatype xsd:string ;
            sh:in ( "EQ"^^xsd:string "NE"^^xsd:string "GT"^^xsd:string "GTE"^^xsd:string "LT"^^xsd:string "LTE"^^xsd:string "IN"^^xsd:string "NOT_IN"^^xsd:string "EXISTS"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cpi:operator ],
        [ sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class cpi:SourcePassage ] [ sh:class cpi:OperationalEvidence ] ) ;
            sh:path cpi:sourceRef ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path rdfs:label ],
        [ sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype xsd:decimal ] [ sh:datatype xsd:boolean ] [ sh:node cpi:ConditionValueListShape ] ) ;
            sh:path cpi:value ],
        [ sh:datatype xsd:string ;
            sh:in ( "PROPOSED" "APPROVED" "REJECTED" "SUPERSEDED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cpi:status ],
        [ sh:class cpi:DataAttribute ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:TESTS_ATTRIBUTE ],
        [ sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class cpi:Industry ] [ sh:class cpi:Sector ] [ sh:class cpi:Subsector ] [ sh:class cpi:IndustryTier ] [ sh:class cpi:BorrowerType ] [ sh:class cpi:Product ] [ sh:class cpi:CustomerSegment ] [ sh:class cpi:Geography ] ) ;
            sh:path cpi:COMPARES_SCOPE_VALUE ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path cpi:field ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:minLength 1 ;
            sh:path cpi:unit ] ;
    sh:sparql [ sh:message "CONDITIONS: membership uses a list" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cpi:operator ?op; cpi:value ?v .
                FILTER (STR(?op) IN ("IN", "NOT_IN")) FILTER NOT EXISTS { ?v rdf:first ?item } }""" ],
        [ sh:message "EXAMPLE_ISOLATION" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
            ?instance a cpi:SemanticInstance; cpi:mode "EXAMPLE" . $this cpi:synthetic false . }""" ],
        [ sh:message "CONDITIONS: ordered comparison value" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
                $this cpi:operator ?op; cpi:value ?v; cpi:field ?field .
                FILTER (STR(?op) IN ("GT", "GTE", "LT", "LTE") && datatype(?v) != xsd:decimal)
                FILTER (!(STR(?field) IN ('rating', 'credit_rating', 'borrower_credit_rating', 'internal_rating')
                    && STR(?v) IN ('D', 'C', 'CC', 'CCC-', 'CCC', 'CCC+', 'B-', 'B', 'B+', 'BB-', 'BB', 'BB+', 'BBB-', 'BBB', 'BBB+', 'A-', 'A', 'A+', 'AA-', 'AA', 'AA+', 'AAA')
                    && NOT EXISTS { $this cpi:unit ?unit })) }""" ],
        [ sh:message "CONDITIONS: scalar comparison" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cpi:operator ?op; cpi:value ?v .
                FILTER (STR(?op) NOT IN ("IN", "NOT_IN", "EXISTS")) FILTER (!isLiteral(?v)) }""" ],
        [ sh:message "CONDITIONS: EXISTS omits value" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cpi:operator "EXISTS"^^xsd:string; cpi:value ?v }""" ],
        [ sh:message "CONDITIONS: missing value" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cpi:operator ?op . FILTER (STR(?op) != "EXISTS") FILTER NOT EXISTS { $this cpi:value ?v } }""" ],
        [ sh:message "SYNTHETIC_PROVENANCE" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
            $this cpi:synthetic false; cpi:sourceRef ?p . ?p cpi:synthetic true . }""" ] ;
    sh:targetClass cpi:Condition .

cpi:ControlEvidenceShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path cpi:evidence_reference ],
        [ sh:datatype xsd:string ;
            sh:in ( "UNVERIFIED"^^xsd:string "VERIFIED"^^xsd:string "STALE"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cpi:verification_state ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cpi:synthetic ],
        [ sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class cpi:SourcePassage ] [ sh:class cpi:OperationalEvidence ] ) ;
            sh:path cpi:sourceRef ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path cpi:collected_on ;
            sh:pattern "^\\d{4}-\\d{2}-\\d{2}$" ],
        [ sh:datatype xsd:string ;
            sh:in ( "PROPOSED" "APPROVED" "REJECTED" "SUPERSEDED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cpi:status ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path rdfs:label ],
        [ sh:class cpi:EvidenceRequirement ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:SATISFIES_REQUIREMENT ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path cpi:evidence_type ],
        [ sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class cpi:LoanApplication ] [ sh:class cpi:PolicyRule ] [ sh:class cpi:Exception ] ) ;
            sh:path cpi:EVIDENCE_FOR ] ;
    sh:sparql [ sh:message "SYNTHETIC_PROVENANCE" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
            $this cpi:synthetic false; cpi:sourceRef ?p . ?p cpi:synthetic true . }""" ],
        [ sh:message "EXAMPLE_ISOLATION" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
            ?instance a cpi:SemanticInstance; cpi:mode "EXAMPLE" . $this cpi:synthetic false . }""" ] ;
    sh:targetClass cpi:ControlEvidence .

cpi:CorporateGroupShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:class cpi:LegalEntity ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:HAS_PARENT_LEGAL_ENTITY ],
        [ sh:class cpi:Country ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:HAS_COUNTRY_OF_RISK ],
        [ sh:class cpi:Geography ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:HAS_REPORTED_GEOGRAPHY ],
        [ sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
