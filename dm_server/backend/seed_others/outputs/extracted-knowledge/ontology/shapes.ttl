cpi:SemanticInstanceShape a sh:NodeShape ;
    sh:class cpi:SemanticInstance ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:datatype xsd:string ;
            sh:in ( "EXAMPLE" "SOURCE_BACKED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cpi:mode ],
        [ sh:datatype xsd:string ;
            sh:in ( "1.4.0" "1.3.0" "1.2.0" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cpi:ontologyVersion ] ;
    sh:targetClass cpi:SemanticInstance ;
    sh:targetNode <urn:cpi:semantic-instance:envelope> .

cpi:SourcePassageShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path cpi:version ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cpi:synthetic ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cpi:source_checksum ;
            sh:pattern "^[a-f0-9]{64}$" ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:minInclusive 1 ;
            sh:path cpi:page ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path cpi:document_reference ],
        [ sh:class cpi:PolicyVersion ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:SOURCE_IN_VERSION ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path rdfs:label ],
        [ sh:datatype xsd:string ;
            sh:in ( "PROPOSED" "APPROVED" "REJECTED" "SUPERSEDED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cpi:status ],
        [ sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class cpi:SourcePassage ] [ sh:class cpi:OperationalEvidence ] ) ;
            sh:path cpi:sourceRef ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path cpi:text ],
        [ sh:datatype xsd:string ;
            sh:in ( "POLICY_SOURCE"^^xsd:string "ILLUSTRATIVE_EXAMPLE"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cpi:origin ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:minLength 1 ;
            sh:path cpi:clause_reference ] ;
    sh:sparql [ sh:message "SYNTHETIC_PROVENANCE" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
            $this cpi:synthetic false; cpi:sourceRef ?p . ?p cpi:synthetic true . }""" ],
        [ sh:message "SOURCE_VERSION" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cpi:SOURCE_IN_VERSION ?v; cpi:version ?sv; cpi:source_checksum ?sc .
                ?v cpi:version ?vv; cpi:source_checksum ?vc . FILTER (?sv != ?vv || ?sc != ?vc) }""" ],
        [ sh:message "EXAMPLE_ISOLATION" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { ?i a cpi:SemanticInstance; cpi:mode ?mode . $this cpi:origin ?origin .
                FILTER ((STR(?mode) = "EXAMPLE" && STR(?origin) != "ILLUSTRATIVE_EXAMPLE") || (STR(?mode) = "SOURCE_BACKED" && STR(?origin) != "POLICY_SOURCE")) }""" ],
        [ sh:message "EXAMPLE_ISOLATION" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
            ?instance a cpi:SemanticInstance; cpi:mode "EXAMPLE" . $this cpi:synthetic false . }""" ] ;
    sh:targetClass cpi:SourcePassage .

