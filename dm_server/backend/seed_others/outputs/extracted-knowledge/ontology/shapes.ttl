            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
            ?instance a cpi:SemanticInstance; cpi:mode "EXAMPLE" . $this cpi:synthetic false . }""" ],
        [ sh:message "SYNTHETIC_PROVENANCE" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
            $this cpi:synthetic false; cpi:sourceRef ?p . ?p cpi:synthetic true . }""" ] ;
    sh:targetClass cpi:Purpose .

cpi:REQUESTED_BYEdgeShape a sh:NodeShape ;
    sh:or ( [ sh:class cpi:CreditRequest ] ) ;
    sh:property [ sh:class cpi:Borrower ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:REQUESTED_BY ] ;
    sh:targetSubjectsOf cpi:REQUESTED_BY .

cpi:REQUESTS_FACILITYEdgeShape a sh:NodeShape ;
    sh:or ( [ sh:class cpi:CreditRequest ] ) ;
    sh:property [ sh:class cpi:Facility ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:REQUESTS_FACILITY ] ;
    sh:targetSubjectsOf cpi:REQUESTS_FACILITY .

cpi:REQUESTS_PRODUCTEdgeShape a sh:NodeShape ;
    sh:or ( [ sh:class cpi:LoanApplication ] ) ;
    sh:property [ sh:class cpi:Product ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:REQUESTS_PRODUCT ] ;
