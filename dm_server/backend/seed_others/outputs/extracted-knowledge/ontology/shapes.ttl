            sh:minCount 1 ;
            sh:path cpi:synthetic ],
        [ sh:class cpi:Counterparty ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:HAS_COUNTERPARTY ],
        [ sh:class cpi:RiskObservation ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:HAS_RISK_OBSERVATION ],
        [ sh:class cpi:Collateral ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:HAS_COLLATERAL ],
        [ sh:class cpi:Product ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:HAS_PRODUCT ],
        [ sh:class cpi:BookingLocation ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:BOOKED_AT ],
        [ sh:class cpi:Exposure ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:HAS_EXPOSURE ],
        [ sh:class cpi:Tenant ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:HAS_TENANT ],
        [ sh:class cpi:Sponsor ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:HAS_SPONSOR ],
        [ sh:class cpi:Guarantee ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:HAS_GUARANTEE ] ;
    sh:sparql [ sh:message "EXAMPLE_ISOLATION" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
            ?instance a cpi:SemanticInstance; cpi:mode "EXAMPLE" . $this cpi:synthetic false . }""" ],
        [ sh:message "SYNTHETIC_PROVENANCE" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
            $this cpi:synthetic false; cpi:sourceRef ?p . ?p cpi:synthetic true . }""" ] ;
    sh:targetClass cpi:Loan .

cpi:MEASURED_BYEdgeShape a sh:NodeShape ;
    sh:or ( [ sh:class cpi:Threshold ] ) ;
    sh:property [ sh:class cpi:RiskMetric ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:MEASURED_BY ] ;
    sh:targetSubjectsOf cpi:MEASURED_BY .

cpi:MEMBER_OF_SEGMENTEdgeShape a sh:NodeShape ;
    sh:or ( [ sh:class cpi:Customer ] ) ;
    sh:property [ sh:class cpi:CustomerSegment ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:MEMBER_OF_SEGMENT ] ;
    sh:targetSubjectsOf cpi:MEMBER_OF_SEGMENT .

cpi:OBSERVES_DATA_ATTRIBUTEEdgeShape a sh:NodeShape ;
    sh:or ( [ sh:class cpi:RiskObservation ] ) ;
    sh:property [ sh:class cpi:DataAttribute ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:OBSERVES_DATA_ATTRIBUTE ] ;
    sh:targetSubjectsOf cpi:OBSERVES_DATA_ATTRIBUTE .

cpi:OF_PRODUCTEdgeShape a sh:NodeShape ;
    sh:or ( [ sh:class cpi:Loan ] ) ;
    sh:property [ sh:class cpi:Product ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:OF_PRODUCT ] ;
    sh:targetSubjectsOf cpi:OF_PRODUCT .

cpi:OPERATES_IN_GEOGRAPHYEdgeShape a sh:NodeShape ;
    sh:or ( [ sh:class cpi:Party ] ) ;
    sh:property [ sh:class cpi:Geography ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:OPERATES_IN_GEOGRAPHY ] ;
    sh:targetSubjectsOf cpi:OPERATES_IN_GEOGRAPHY .

cpi:OPERATES_IN_INDUSTRYEdgeShape a sh:NodeShape ;
    sh:or ( [ sh:class cpi:Party ] ) ;
    sh:property [ sh:class cpi:Industry ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:OPERATES_IN_INDUSTRY ] ;
    sh:targetSubjectsOf cpi:OPERATES_IN_INDUSTRY .

cpi:OperationalEvidenceShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path rdfs:label ],
        [ sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class cpi:SourcePassage ] [ sh:class cpi:OperationalEvidence ] ) ;
            sh:path cpi:sourceRef ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path cpi:source_type ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:minLength 1 ;
            sh:path cpi:field_name ],
        [ sh:datatype xsd:string ;
            sh:in ( "PROPOSED" "APPROVED" "REJECTED" "SUPERSEDED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cpi:status ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path cpi:source_reference ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cpi:synthetic ] ;
    sh:sparql [ sh:message "EXAMPLE_ISOLATION" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
            ?instance a cpi:SemanticInstance; cpi:mode "EXAMPLE" . $this cpi:synthetic false . }""" ],
        [ sh:message "SYNTHETIC_PROVENANCE" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
            $this cpi:synthetic false; cpi:sourceRef ?p . ?p cpi:synthetic true . }""" ] ;
    sh:targetClass cpi:OperationalEvidence .

cpi:PARENT_SECTIONEdgeShape a sh:NodeShape ;
    sh:or ( [ sh:class cpi:PolicySection ] ) ;
    sh:property [ sh:class cpi:PolicySection ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:PARENT_SECTION ] ;
    sh:targetSubjectsOf cpi:PARENT_SECTION .

cpi:PART_OF_VERSIONEdgeShape a sh:NodeShape ;
    sh:or ( [ sh:class cpi:PolicySection ] [ sh:class cpi:PolicyRule ] ) ;
    sh:property [ sh:class cpi:PolicyVersion ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:PART_OF_VERSION ] ;
    sh:targetSubjectsOf cpi:PART_OF_VERSION .

cpi:PROVIDED_BY_GUARANTOREdgeShape a sh:NodeShape ;
    sh:or ( [ sh:class cpi:Guarantee ] ) ;
    sh:property [ sh:class cpi:Guarantor ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:PROVIDED_BY_GUARANTOR ] ;
    sh:targetSubjectsOf cpi:PROVIDED_BY_GUARANTOR .

cpi:PartyShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:class cpi:BorrowerType ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:HAS_BORROWER_TYPE ],
        [ sh:class cpi:Country ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:DOMICILED_IN ],
        [ sh:class cpi:LoanApplication ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:APPLIES_FOR ],
        [ sh:class cpi:Geography ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:OPERATES_IN_GEOGRAPHY ],
        [ sh:minCount 0 ;
            sh:path cpi:customer_reference ],
        [ sh:class cpi:RiskGrade ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:HAS_RISK_GRADE ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cpi:synthetic ],
        [ sh:class cpi:Country ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:HAS_COUNTRY_OF_RISK ],
        [ sh:class cpi:Geography ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:HAS_REPORTED_GEOGRAPHY ],
        [ sh:class cpi:Industry ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:OPERATES_IN_INDUSTRY ],
        [ sh:class cpi:Exposure ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:HAS_EXPOSURE ],
        [ sh:datatype xsd:string ;
            sh:in ( "PROPOSED" "APPROVED" "REJECTED" "SUPERSEDED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cpi:status ],
        [ sh:class cpi:BusinessActivity ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:HAS_BUSINESS_ACTIVITY ],
        [ sh:class cpi:RiskAttribute ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:HAS_RISK_ATTRIBUTE ],
        [ sh:class cpi:Country ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:INCORPORATED_IN ],
        [ sh:class cpi:CreditRating ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:HAS_CREDIT_RATING ],
        [ sh:class cpi:Subsector ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:IN_SUBSECTOR ],
        [ sh:class cpi:Loan ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:BORROWS ],
        [ sh:class cpi:LegalEntity ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:HAS_PARENT_LEGAL_ENTITY ],
        [ sh:class cpi:RiskObservation ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:HAS_RISK_OBSERVATION ],
        [ sh:class cpi:Sector ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:IN_SECTOR ],
        [ sh:minCount 0 ;
            sh:path cpi:customer_kind ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path rdfs:label ],
        [ sh:class cpi:CorporateGroup ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:BELONGS_TO_GROUP ],
        [ sh:class cpi:CustomerSegment ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:MEMBER_OF_SEGMENT ],
        [ sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class cpi:SourcePassage ] [ sh:class cpi:OperationalEvidence ] ) ;
            sh:path cpi:sourceRef ] ;
    sh:sparql [ sh:message "SYNTHETIC_PROVENANCE" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
            $this cpi:synthetic false; cpi:sourceRef ?p . ?p cpi:synthetic true . }""" ],
        [ sh:message "PROPERTY_CLASS: customer_reference" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
                $this cpi:customer_reference ?v . FILTER NOT EXISTS {
                    $this a ?type . FILTER (?type IN (cpi:Customer))
                } }""" ],
        [ sh:message "PROPERTY_CLASS: customer_kind" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
                $this cpi:customer_kind ?v . FILTER NOT EXISTS {
                    $this a ?type . FILTER (?type IN (cpi:Customer))
                } }""" ],
        [ sh:message "EXAMPLE_ISOLATION" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
            ?instance a cpi:SemanticInstance; cpi:mode "EXAMPLE" . $this cpi:synthetic false . }""" ] ;
    sh:targetClass cpi:Party .

cpi:PolicyClassShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path cpi:taxonomy_id ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path rdfs:label ],
        [ sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class cpi:SourcePassage ] [ sh:class cpi:OperationalEvidence ] ) ;
            sh:path cpi:sourceRef ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path cpi:taxonomy_version ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cpi:synthetic ],
        [ sh:datatype xsd:string ;
            sh:in ( "PROPOSED" "APPROVED" "REJECTED" "SUPERSEDED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cpi:status ] ;
    sh:sparql [ sh:message "SYNTHETIC_PROVENANCE" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
            $this cpi:synthetic false; cpi:sourceRef ?p . ?p cpi:synthetic true . }""" ],
        [ sh:message "EXAMPLE_ISOLATION" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
            ?instance a cpi:SemanticInstance; cpi:mode "EXAMPLE" . $this cpi:synthetic false . }""" ] ;
    sh:targetClass cpi:PolicyClass .

cpi:PolicyConcernShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cpi:synthetic ],
        [ sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class cpi:SourcePassage ] [ sh:class cpi:OperationalEvidence ] ) ;
            sh:path cpi:sourceRef ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path cpi:concern_code ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path rdfs:label ],
        [ sh:datatype xsd:string ;
            sh:in ( "PROPOSED" "APPROVED" "REJECTED" "SUPERSEDED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cpi:status ] ;
    sh:sparql [ sh:message "EXAMPLE_ISOLATION" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
            ?instance a cpi:SemanticInstance; cpi:mode "EXAMPLE" . $this cpi:synthetic false . }""" ],
        [ sh:message "SYNTHETIC_PROVENANCE" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
            $this cpi:synthetic false; cpi:sourceRef ?p . ?p cpi:synthetic true . }""" ] ;
    sh:targetClass cpi:PolicyConcern .

cpi:PolicyRuleShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:datatype xsd:string ;
            sh:in ( "QUANTITATIVE"^^xsd:string "QUALITATIVE"^^xsd:string "EXCEPTION_RULE"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cpi:rule_kind ],
        [ sh:class cpi:BorrowerType ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:APPLIES_TO_BORROWER_TYPE ],
        [ sh:class cpi:PolicyClass ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:DERIVED_FROM_POLICY_CLASS ],
        [ sh:class cpi:SourcePassage ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:DERIVED_FROM ],
        [ sh:class cpi:RiskAttribute ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:EVALUATES_RISK_ATTRIBUTE ],
        [ sh:class cpi:Exception ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:HAS_EXCEPTION ],
        [ sh:class cpi:Geography ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:APPLIES_IN ],
        [ sh:class cpi:ApprovalRequirement ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:REQUIRES_APPROVAL ],
        [ sh:class cpi:Product ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:APPLIES_TO_PRODUCT ],
        [ sh:class cpi:Threshold ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:HAS_THRESHOLD ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path cpi:rule_reference ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:minLength 1 ;
            sh:path cpi:requirement_text ],
        [ sh:class cpi:ApprovalRequirement ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:REQUIRES_APPROVAL_ABOVE_THRESHOLD ],
        [ sh:class cpi:Product ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:DOCUMENTS_PRODUCT_SCOPE ],
        [ sh:class cpi:Industry ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:APPLIES_TO_INDUSTRY ],
        [ sh:class cpi:CustomerSegment ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:APPLIES_TO_SEGMENT ],
        [ sh:class cpi:PolicyVersion ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:PART_OF_VERSION ],
        [ sh:class cpi:ConditionGroup ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:HAS_CONDITION ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cpi:synthetic ],
        [ sh:class cpi:EvidenceRequirement ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:REQUIRES_EVIDENCE ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path rdfs:label ],
        [ sh:class cpi:EffectivePeriod ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:HAS_EFFECTIVE_PERIOD ],
        [ sh:class cpi:PolicyConcern ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:CONCERNS ],
        [ sh:class cpi:Subsector ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:APPLIES_TO_SUBSECTOR ],
        [ sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class cpi:SourcePassage ] [ sh:class cpi:OperationalEvidence ] ) ;
            sh:path cpi:sourceRef ],
        [ sh:class cpi:TaxonomyConcept ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:CLASSIFIED_AS ],
        [ sh:class cpi:ApprovalRequirement ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:REQUIRES_APPROVAL_ON_BREACH ],
        [ sh:datatype xsd:string ;
            sh:in ( "PROPOSED" "APPROVED" "REJECTED" "SUPERSEDED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cpi:status ],
        [ sh:class cpi:RiskMetric ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:USES_METRIC ],
        [ sh:class cpi:IndustryTier ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:APPLIES_TO_INDUSTRY_TIER ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:minLength 1 ;
            sh:path cpi:source_rule_code ] ;
    sh:sparql [ sh:message "SYNTHETIC_PROVENANCE" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
            $this cpi:synthetic false; cpi:sourceRef ?p . ?p cpi:synthetic true . }""" ],
        [ sh:message "THRESHOLD_METRIC" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cpi:HAS_THRESHOLD ?t . ?t cpi:MEASURED_BY ?m .
                FILTER NOT EXISTS { $this cpi:USES_METRIC ?m } }""" ],
        [ sh:message "QUANTITATIVE_RULE" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cpi:rule_kind "QUANTITATIVE"^^xsd:string .
                FILTER (NOT EXISTS { $this cpi:HAS_THRESHOLD ?t } || NOT EXISTS { $this cpi:USES_METRIC ?m }) }""" ],
        [ sh:message "EXAMPLE_ISOLATION" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
            ?instance a cpi:SemanticInstance; cpi:mode "EXAMPLE" . $this cpi:synthetic false . }""" ],
        [ sh:message "SOURCE_VERSION" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cpi:PART_OF_VERSION ?v; cpi:DERIVED_FROM ?p .
                ?p cpi:SOURCE_IN_VERSION ?other . FILTER (?v != ?other) }""" ],
        [ sh:message "EXCEPTION_LINKS" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cpi:HAS_EXCEPTION ?e . FILTER NOT EXISTS { ?e cpi:EXCEPTION_TO $this } }""" ] ;
    sh:targetClass cpi:PolicyRule .

cpi:PolicySectionShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path rdfs:label ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cpi:synthetic ],
        [ sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class cpi:SourcePassage ] [ sh:class cpi:OperationalEvidence ] ) ;
            sh:path cpi:sourceRef ],
        [ sh:class cpi:PolicyVersion ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:PART_OF_VERSION ],
        [ sh:datatype xsd:string ;
            sh:in ( "PROPOSED" "APPROVED" "REJECTED" "SUPERSEDED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cpi:status ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path cpi:section_reference ],
        [ sh:class cpi:PolicySection ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:PARENT_SECTION ],
        [ sh:class cpi:PolicyRule ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:CONTAINS_RULE ] ;
    sh:sparql [ sh:message "EXAMPLE_ISOLATION" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
            ?instance a cpi:SemanticInstance; cpi:mode "EXAMPLE" . $this cpi:synthetic false . }""" ],
        [ sh:message "CONTAINMENT: rule version" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cpi:PART_OF_VERSION ?v; cpi:CONTAINS_RULE ?r .
                ?r cpi:PART_OF_VERSION ?other . FILTER (?v != ?other) }""" ],
        [ sh:message "CONTAINMENT: section cycle" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cpi:PARENT_SECTION+ $this }""" ],
        [ sh:message "SYNTHETIC_PROVENANCE" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
            $this cpi:synthetic false; cpi:sourceRef ?p . ?p cpi:synthetic true . }""" ],
        [ sh:message "CONTAINMENT: parent version" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cpi:PARENT_SECTION ?p; cpi:PART_OF_VERSION ?v .
                ?p cpi:PART_OF_VERSION ?other . FILTER (?v != ?other) }""" ] ;
    sh:targetClass cpi:PolicySection .

cpi:PolicyVersionShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:class cpi:PolicySection ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:CONTAINS_SECTION ],
        [ sh:class cpi:Industry ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:APPLIES_TO_INDUSTRY ],
        [ sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class cpi:SourcePassage ] [ sh:class cpi:OperationalEvidence ] ) ;
            sh:path cpi:sourceRef ],
        [ sh:class cpi:CustomerSegment ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:APPLIES_TO_SEGMENT ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path cpi:version ],
        [ sh:class cpi:EffectivePeriod ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:HAS_EFFECTIVE_PERIOD ],
        [ sh:class cpi:ConditionGroup ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:HAS_EXCLUSION ],
        [ sh:class cpi:Subsector ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:APPLIES_TO_SUBSECTOR ],
        [ sh:class cpi:ConditionGroup ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:HAS_APPLICABILITY ],
        [ sh:class cpi:BorrowerType ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:APPLIES_TO_BORROWER_TYPE ],
        [ sh:class cpi:IndustryTier ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:APPLIES_TO_INDUSTRY_TIER ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cpi:source_checksum ;
            sh:pattern "^[a-f0-9]{64}$" ],
        [ sh:class cpi:Geography ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:APPLIES_IN ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path rdfs:label ],
        [ sh:class cpi:PolicyRule ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:CONTAINS_RULE ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cpi:synthetic ],
        [ sh:class cpi:CreditPolicy ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:VERSION_OF ],
        [ sh:class cpi:Product ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path cpi:APPLIES_TO_PRODUCT ],
        [ sh:datatype xsd:string ;
            sh:in ( "PROPOSED" "APPROVED" "REJECTED" "SUPERSEDED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cpi:status ] ;
    sh:sparql [ sh:message "EXAMPLE_ISOLATION" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
            ?instance a cpi:SemanticInstance; cpi:mode "EXAMPLE" . $this cpi:synthetic false . }""" ],
        [ sh:message "SYNTHETIC_PROVENANCE" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
            $this cpi:synthetic false; cpi:sourceRef ?p . ?p cpi:synthetic true . }""" ],
        [ sh:message "CONTAINMENT: version children" ;
            sh:select """PREFIX cpi: <urn:cpi:ontology:credit-policy:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
            { $this cpi:CONTAINS_RULE ?child } UNION { $this cpi:CONTAINS_SECTION ?child }
            ?child cpi:PART_OF_VERSION ?other . FILTER ($this != ?other) }""" ] ;
    sh:targetClass cpi:PolicyVersion .

cpi:ProductShape a sh:NodeShape ;
    sh:closed true ;
