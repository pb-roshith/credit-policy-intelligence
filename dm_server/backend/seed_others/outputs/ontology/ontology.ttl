cpi:CorporateGroup a owl:Class ;
    rdfs:label "Corporate group" ;
    rdfs:comment "A group of affiliated parties." ;
    rdfs:subClassOf cpi:Party ;
    cpi:ontologyLayer "Domain" .

cpi:Counterparty a owl:Class ;
    rdfs:label "Counterparty" ;
    rdfs:comment "A party on the other side of a credit transaction." ;
    rdfs:subClassOf cpi:Party ;
    cpi:ontologyLayer "Domain" .

cpi:EXCEPTION_TO a owl:ObjectProperty ;
    rdfs:label "exception to" ;
    rdfs:comment "The one base rule from which an exception permits deviation." ;
    rdfs:domain cpi:Exception ;
    rdfs:range cpi:PolicyRule ;
    cpi:ontologyLayer "Policy" .

cpi:Guarantor a owl:Class ;
    rdfs:label "Guarantor" ;
    rdfs:comment "A party that provides a guarantee." ;
    rdfs:subClassOf cpi:Party ;
    cpi:ontologyLayer "Domain" .

cpi:LegalEntity a owl:Class ;
    rdfs:label "Legal entity" ;
    rdfs:comment "An independently constituted organization that can be a parent entity." ;
    rdfs:subClassOf cpi:Party ;
    cpi:ontologyLayer "Domain" .

cpi:Lender a owl:Class ;
    rdfs:label "Lender" ;
    rdfs:comment "A party providing credit." ;
    rdfs:subClassOf cpi:Party ;
    cpi:ontologyLayer "Domain" .

cpi:Purpose a owl:Class ;
    rdfs:label "Purpose" ;
    rdfs:comment "The stated intended use of funding." ;
    cpi:ontologyLayer "Domain" .

cpi:RiskGrade a owl:Class ;
    rdfs:label "Risk grade" ;
    rdfs:comment "A grade assigned under a risk classification scale." ;
    rdfs:subClassOf cpi:RiskAttribute ;
    cpi:ontologyLayer "Domain" .

cpi:Sponsor a owl:Class ;
    rdfs:label "Sponsor" ;
    rdfs:comment "A party that supports a borrower or a financed transaction." ;
    rdfs:subClassOf cpi:Party ;
    cpi:ontologyLayer "Domain" .

cpi:Tenant a owl:Class ;
    rdfs:label "Tenant" ;
    rdfs:comment "A party leasing financed or pledged property." ;
    rdfs:subClassOf cpi:Party ;
    cpi:ontologyLayer "Domain" .

cpi:BookingLocation a owl:Class ;
    rdfs:label "Booking location" ;
    rdfs:comment "The office or location where a facility is booked." ;
    cpi:ontologyLayer "Domain" .

cpi:BusinessActivity a owl:Class ;
    rdfs:label "Business activity" ;
    rdfs:comment "An economic activity conducted by a party or financed by a facility." ;
    cpi:ontologyLayer "Domain" .

cpi:Collateral a owl:Class ;
    rdfs:label "Collateral" ;
    rdfs:comment "An asset or security pledged against credit." ;
    cpi:ontologyLayer "Domain" .

cpi:Currency a owl:Class ;
    rdfs:label "Currency" ;
    rdfs:comment "The currency in which a credit amount is denominated." ;
    cpi:ontologyLayer "Domain" .

cpi:DecisionOutcome a owl:Class ;
    rdfs:label "Decision outcome" ;
    rdfs:comment "The recorded result of a rule assessment." ;
    cpi:ontologyLayer "Decision" .

cpi:Guarantee a owl:Class ;
    rdfs:label "Guarantee" ;
    rdfs:comment "A commitment by a guarantor to support an obligation." ;
    cpi:ontologyLayer "Domain" .

cpi:IndustryTier a owl:Class ;
    rdfs:label "Industry tier" ;
    rdfs:comment "A risk tier assigned to an industry under the relevant classification." ;
    cpi:ontologyLayer "Domain" .

cpi:Limit a owl:Class ;
    rdfs:label "Limit" ;
    rdfs:comment "An authorized exposure ceiling." ;
    cpi:ontologyLayer "Domain" .

cpi:PolicyConcern a owl:Class ;
    rdfs:label "Policy concern" ;
    rdfs:comment "A source-backed subject or dependency used to navigate rules." ;
    cpi:ontologyLayer "Policy" .

cpi:Sector a owl:Class ;
    rdfs:label "Sector" ;
    rdfs:comment "A broad economic classification." ;
    cpi:ontologyLayer "Domain" .

cpi:ApprovalAuthority a owl:Class ;
    rdfs:label "Approval authority" ;
    rdfs:comment "An accountable role or committee empowered to make a specified decision." ;
    cpi:ontologyLayer "Policy" .

cpi:BorrowerType a owl:Class ;
    rdfs:label "Borrower type" ;
    rdfs:comment "A classification used for borrower eligibility." ;
    cpi:ontologyLayer "Domain" .

cpi:CreditRating a owl:Class ;
    rdfs:label "Credit rating" ;
    rdfs:comment "An observed credit rating under an identified rating type." ;
    rdfs:subClassOf cpi:RiskAttribute ;
    cpi:ontologyLayer "Domain" .

cpi:EffectivePeriod a owl:Class ;
    rdfs:label "Effective period" ;
    rdfs:comment "An inclusive start date and optional inclusive end date; absent period means unknown validity." ;
    cpi:ontologyLayer "Policy" .

cpi:PolicyClass a owl:Class ;
    rdfs:label "Policy class" ;
    rdfs:comment "A policy category or topic in the current policy taxonomy." ;
    rdfs:subClassOf cpi:TaxonomyConcept ;
    cpi:ontologyLayer "Policy" .

cpi:Region a owl:Class ;
    rdfs:label "Region" ;
    rdfs:comment "A geographic grouping of territories." ;
    rdfs:subClassOf cpi:Geography ;
    cpi:ontologyLayer "Domain" .

cpi:Tenor a owl:Class ;
    rdfs:label "Tenor" ;
    rdfs:comment "The duration of a facility in months." ;
    cpi:ontologyLayer "Domain" .

cpi:CreditPolicy a owl:Class ;
    rdfs:label "Credit policy" ;
    rdfs:comment "A stable policy identity across separately identified versions." ;
    cpi:ontologyLayer "Policy" .

cpi:Customer a owl:Class ;
    rdfs:label "Customer" ;
    rdfs:comment "A person or organization with a banking relationship." ;
    rdfs:subClassOf cpi:Party ;
    cpi:ontologyLayer "Domain" .

cpi:EvidenceRequirement a owl:Class ;
    rdfs:label "Evidence requirement" ;
    rdfs:comment "A required evidence type and optional freshness condition." ;
    cpi:ontologyLayer "Policy" .

cpi:Industry a owl:Class ;
    rdfs:label "Industry" ;
    rdfs:comment "An economic classification of a party or financed activity." ;
    cpi:ontologyLayer "Domain" .

cpi:Jurisdiction a owl:Class ;
    rdfs:label "Jurisdiction" ;
    rdfs:comment "A territory under a particular legal or regulatory authority." ;
    rdfs:subClassOf cpi:Geography ;
    cpi:ontologyLayer "Domain" .

cpi:OperationalEvidence a owl:Class ;
    rdfs:label "Operational evidence" ;
    rdfs:comment "A source reference for a deal fact or an assessment output." ;
    cpi:ontologyLayer "Decision" .

cpi:RuleAssessment a owl:Class ;
    rdfs:label "Rule assessment" ;
    rdfs:comment "An evaluation of a specific credit request against a specific policy rule." ;
    cpi:ontologyLayer "Decision" .

cpi:Subsector a owl:Class ;
    rdfs:label "Subsector" ;
    rdfs:comment "A finer economic classification within a sector." ;
    cpi:ontologyLayer "Domain" .

cpi:TaxonomyConcept a owl:Class ;
    rdfs:label "Taxonomy concept" ;
    rdfs:comment "A reference to a controlled classification concept; classification is distinct from executable applicability." ;
    cpi:ontologyLayer "Policy" .

cpi:Country a owl:Class ;
    rdfs:label "Country" ;
    rdfs:comment "A country identified under an explicit geographic code scheme." ;
    rdfs:subClassOf cpi:Geography ;
    cpi:ontologyLayer "Domain" .

cpi:CustomerSegment a owl:Class ;
    rdfs:label "Customer segment" ;
    rdfs:comment "A controlled grouping of customers, such as SME; no numerical SME definition is assumed." ;
    cpi:ontologyLayer "Domain" .

cpi:RiskAttribute a owl:Class ;
    rdfs:label "Risk attribute" ;
    rdfs:comment "A qualitative or quantitative characteristic used in credit-risk analysis." ;
    cpi:ontologyLayer "Domain" .

cpi:RiskObservation a owl:Class ;
    rdfs:label "Risk observation" ;
    rdfs:comment "An observed deal risk value with the unit supplied by its source." ;
    cpi:ontologyLayer "Domain" .

cpi:Threshold a owl:Class ;
    rdfs:label "Threshold" ;
    rdfs:comment "A numerical boundary with an operator and unit, measured against exactly one metric." ;
    cpi:ontologyLayer "Policy" .

cpi:Borrower a owl:Class ;
    rdfs:label "Borrower" ;
    rdfs:comment "A customer seeking or receiving credit; a specialized Customer." ;
    rdfs:subClassOf cpi:Customer ;
    cpi:ontologyLayer "Domain" .

cpi:ConditionGroup a owl:Class ;
    rdfs:label "Condition group" ;
    rdfs:comment "An explicit AND, OR or NOT expression over conditions or nested groups." ;
    cpi:ontologyLayer "Policy" .

cpi:ControlEvidence a owl:Class ;
    rdfs:label "Control evidence" ;
    rdfs:comment "An actual evidence artifact with its recorded verification state." ;
    cpi:ontologyLayer "Policy" .

cpi:DataAttribute a owl:Class ;
    rdfs:label "Data attribute" ;
    rdfs:comment "An exact source-system or workbook attribute; bindings require separate governance." ;
    cpi:ontologyLayer "Applicability" .

cpi:Loan a owl:Class ;
    rdfs:label "Loan" ;
    rdfs:comment "An originated credit agreement or facility." ;
    rdfs:subClassOf cpi:Facility ;
    cpi:ontologyLayer "Domain" .

cpi:PolicySection a owl:Class ;
    rdfs:label "Policy section" ;
    rdfs:comment "A section of one policy version, optionally nested within another section." ;
    cpi:ontologyLayer "Policy" .

cpi:Condition a owl:Class ;
    rdfs:label "Condition" ;
    rdfs:comment "A typed comparison used in scope, eligibility or exception logic." ;
    cpi:ontologyLayer "Policy" .

cpi:RiskMetric a owl:Class ;
    rdfs:label "Risk metric" ;
    rdfs:comment "A defined quantitative measure with declared permitted units and optional formula." ;
    rdfs:subClassOf cpi:RiskAttribute ;
    cpi:ontologyLayer "Domain" .

cpi:ApprovalRequirement a owl:Class ;
    rdfs:label "Approval requirement" ;
    rdfs:comment "A required decision by an identified authority; this is not an approval already granted." ;
    cpi:ontologyLayer "Policy" .

cpi:Exposure a owl:Class ;
    rdfs:label "Exposure" ;
    rdfs:comment "A credit exposure measured at the applicable entity and reporting scope." ;
    cpi:ontologyLayer "Domain" .

cpi:Product a owl:Class ;
    rdfs:label "Product" ;
    rdfs:comment "A controlled credit product or facility type." ;
    cpi:ontologyLayer "Domain" .

cpi:Exception a owl:Class ;
    rdfs:label "Exception" ;
    rdfs:comment "A conditional deviation from one base rule. Approval and alternative rules are explicit links." ;
    cpi:ontologyLayer "Policy" .

cpi:LoanApplication a owl:Class ;
    rdfs:label "Loan application" ;
    rdfs:comment "A request for credit, distinct from an originated loan." ;
    rdfs:subClassOf cpi:CreditRequest ;
    cpi:ontologyLayer "Domain" .

cpi:SourcePassage a owl:Class ;
    rdfs:label "Source passage" ;
    rdfs:comment "Exact evidence text, source identity, version and checksum; never a generated policy summary." ;
    cpi:ontologyLayer "Policy" .

cpi:Geography a owl:Class ;
    rdfs:label "Geography" ;
    rdfs:comment "A jurisdiction or geographic grouping used in explicit policy scope." ;
    cpi:ontologyLayer "Domain" .

cpi:CreditRequest a owl:Class ;
    rdfs:label "Credit request" ;
    rdfs:comment "A request for one or more credit facilities." ;
    cpi:ontologyLayer "Domain" .

cpi:PolicyVersion a owl:Class ;
    rdfs:label "Policy version" ;
    rdfs:comment "An immutable, source-bound version of a credit policy." ;
    cpi:ontologyLayer "Policy" .

cpi:Facility a owl:Class ;
    rdfs:label "Facility" ;
    rdfs:comment "A requested or committed credit arrangement." ;
    cpi:ontologyLayer "Domain" .

cpi:Party a owl:Class ;
    rdfs:label "Party" ;
    rdfs:comment "A person, organization, or group with a role in a credit relationship." ;
    cpi:ontologyLayer "Domain" .

cpi:PolicyRule a owl:Class ;
    rdfs:label "Policy rule" ;
    rdfs:comment "A source-derived normative requirement within exactly one policy version." ;
    cpi:ontologyLayer "Policy" .

