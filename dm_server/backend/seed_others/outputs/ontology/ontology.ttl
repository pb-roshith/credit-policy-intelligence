    rdfs:domain cpi:ControlEvidence ;
    rdfs:range cpi:EvidenceRequirement ;
    cpi:ontologyLayer "Policy" .

cpi:SOURCE_IN_VERSION a owl:ObjectProperty ;
    rdfs:label "source in version" ;
    rdfs:comment "The policy version containing an exact source passage." ;
    rdfs:domain cpi:SourcePassage ;
    rdfs:range cpi:PolicyVersion ;
    cpi:ontologyLayer "Policy" .

cpi:SUBJECT_TO_LIMIT a owl:ObjectProperty ;
    rdfs:label "subject to limit" ;
    rdfs:comment "A documented ceiling covering the exposure or facility." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( cpi:Exposure cpi:Facility ) ] ;
    rdfs:range cpi:Limit ;
    cpi:ontologyLayer "Domain" .

cpi:SemanticInstance a owl:Class .

cpi:TESTS_ATTRIBUTE a owl:ObjectProperty ;
    rdfs:label "tests attribute" ;
    rdfs:comment "A condition names a field with an explicit binding in the deal fact registry." ;
    rdfs:domain cpi:Condition ;
    rdfs:range cpi:DataAttribute ;
    cpi:ontologyLayer "Applicability" .

cpi:USES_METRIC a owl:ObjectProperty ;
