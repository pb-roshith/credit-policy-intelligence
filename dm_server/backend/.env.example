# Shared database, identity and AI settings are loaded from cpi_server/backend/.env.
# Set this optional override in the process environment.
DM_CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# Leave blank to keep using the service database configuration without restoring snapshots.
# Use postgresql:// URLs for three distinct PostgreSQL databases.
CPI_SEED_DATABASE_URL=
DOSSIER_SEED_DATABASE_URL=
MCP_SEED_DATABASE_URL=
