# Local PostgreSQL
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=cpi_credit_dossier_mcp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me

# Mistral Document Library
MISTRAL_API_KEY=your_mistral_api_key_here
# In production set these in the workload environment. Required secrets are
# loaded from Azure Key Vault through managed identity rather than this file.
APP_ENV=development
AZURE_KEY_VAULT_URL=
MISTRAL_TIMEOUT_MS=60000

# Local MCP server
MCP_HOST=127.0.0.1
MCP_PORT=8004
MCP_TRANSPORT=sse
