# AI provider: gemini or mistral
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=your_gemini_api_key_here

# Local PostgreSQL
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=cpi_credit_dossier_mcp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me

# Mistral Document Library
MISTRAL_API_KEY=your_mistral_api_key_here
# In production, inject secrets in the workload environment using the deployment secret manager.
APP_ENV=development
AZURE_KEY_VAULT_URL=
MISTRAL_TIMEOUT_MS=60000

# Local MCP server
MCP_HOST=127.0.0.1
MCP_PORT=8004
MCP_TRANSPORT=sse
# Hosted MCP PostgreSQL connection (for example a separate Neon database).
# When set, POSTGRES_* below are not used and database creation is skipped.
MCP_DATABASE_URL=
DOSSIER_DATA_AUTO_IMPORT=true
DOSSIER_DATA_DIR=
