# AI provider: gemini or mistral
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=your_gemini_api_key_here

ADMIN_USER_ID=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password
SESSION_COOKIE_SECURE=false
# Comma-separated exact frontend origins. Do not use * with credentialed requests.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Enable only when the public application is served exclusively over HTTPS.
ENABLE_HSTS=false
MAX_REQUEST_BODY_BYTES=1048576
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
DATABASE_URL=postgresql://postgres:root@localhost:5432/credit_policy_intelligence
MISTRAL_API_KEY=replace-with-your-mistral-api-key
MISTRAL_POLICY_MODEL=mistral-medium-latest
MISTRAL_TIMEOUT_MS=90000
# Credit Dossier hosts the single common deal API. Same server-only key in both backends.
SHARED_DEAL_API_URL=http://127.0.0.1:8003
SHARED_DEAL_API_KEY=replace-with-a-random-service-key
SHARED_DEAL_TIMEOUT_SECONDS=120
MISTRAL_MANUFACTURING_TIMEOUT_MS=450000
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_STATEMENT_TIMEOUT_MS=120000
DATABASE_TRANSACTION_RETRIES=3
DATABASE_RETRY_BASE_DELAY_MS=50
POLICY_DOCUMENT_TIMEOUT_SECONDS=1500
POLICY_JOB_TIMEOUT_SECONDS=36000

# Governed policy inventory. API keys remain backend-only.
RULE_MAX_FILE_BYTES=20971520
RULE_CLAUSE_BATCH_SIZE=4
RULE_EXTRACTION_RETRIES=2
APP_ENV=development
# Local development only. In production inject DATA_ENCRYPTION_KEY or
# DATA_ENCRYPTION_KEY_FILE through deployment configuration.
DATA_ENCRYPTION_KEY=
# Requires APP_ENV=development and an explicit admin action on a synthetic rule.
RULE_DEMO_AUTO_APPROVE=false

# Bounded per-policy AI processing concurrency (1-4).
RULE_INVENTORY_WORKERS=2

# Risk Knowledge is integrated into the existing CPI API and PostgreSQL store.
# CPI reads seeds from dm_server/backend/seed_others at the workspace root.
# Override CPI_SEED_DIR when deploying the seed bundle at a different absolute path.
# CPI_SEED_DIR=
# Default workbook is dm_server/backend/seed_others/risk_schema/Risk Data Model_Oct 2026.xlsx.
CPI_RISK_SCHEMA_PATH=
LLM_PROVIDER=mistral
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# Optional graph mirror; leave unset to use NetworkX without a graph server.
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=
POLICY_GRAPH_LLM_FALLBACK=false
POLICY_GRAPH_FALLBACK_MAX_SPANS=20
