import React,{useState} from 'react';
import {Upload,FileText,Database,ArrowUpRight,Play,CheckCircle2} from 'lucide-react';
import {Panel,Badge,Empty,Source,pretty} from '../components/ui';
import {api,post} from '../services/api';
export default function Assets({state,run,refresh,showSource,processing=false,onOpenRules}) {
 const [tab,setTab]=useState('schema'),[selected,setSelected]=useState(null),[clauses,setClauses]=useState([]);
 const kind=processing?'policy':tab;
 const docs=state.documents.filter(d=>d.document_type===kind);
 async function upload(file){if(!file)return;const body=new FormData();body.append('file',file);await api('/assets/'+kind,{method:'POST',body});await refresh()}
 async function inspect(id){const result=await api(`/documents/${id}/clauses`);setClauses(result);setSelected(id)}
 return <>{!processing&&<div className="tabs">{[['schema','Enterprise Risk Schema'],['reference','Reference Knowledge'],['policy','Policy Documents']].map(([id,label])=><button key={id} className={tab===id?'active':''} onClick={()=>{setTab(id);setSelected(null)}}>{label}<span>{state.documents.filter(d=>d.document_type===id).length}</span></button>)}</div>}
 {processing&&<div className="pipeline-strip"><span><FileText size={17}/> Policy document</span><b>→</b><span>Source clauses</span><b>→</b><span>Classification</span><b>→</b><span>Candidate rules</span><b>→</b><span>Human review</span></div>}
 <div className="asset-layout"><Panel title={processing?'Process policy documents':pretty(kind)+' assets'} sub={kind==='schema'?'Source structures remain intact. Enrichment stays separate.':'Every extracted object retains the original passage and source location.'}>
 <label className="upload-zone"><Upload size={26}/><strong>Choose a {kind==='schema'?'schema workbook':'document'} to upload</strong><span>{kind==='schema'?'XLSX · CRDM Entity / CRDM Attribute headers':'PDF, DOCX, TXT or Markdown'} · up to 20 MB</span><input type="file" aria-label={'Upload '+kind} accept={kind==='schema'?'.xlsx':'.pdf,.docx,.txt,.md,.markdown'} onChange={e=>{const f=e.target.files[0];run(()=>upload(f),'Source asset uploaded');e.target.value=''}}/></label>
 {!docs.length&&<Empty>No assets uploaded in this category.</Empty>}{docs.map(d=><article className={'asset-row '+(selected===d.document_id?'selected':'')} key={d.document_id}><span className="file-icon">{kind==='schema'?<Database size={22}/>:<FileText size={22}/>}</span><div><h3>{d.document_name}</h3><p>{d.format.toUpperCase()} · {kind==='schema'?`${d.metadata.entities} entities · ${d.metadata.attribute_records} attributes`:'Version '+d.version+' · Effective '+(d.effective_date||'UNKNOWN')}</p><Badge>{d.synthetic?'SYNTHETIC_DEMO':'SOURCE'}</Badge>{d.metadata.last_processing_provider&&<span className="processed"><CheckCircle2 size={12}/> Processed</span>}</div><div className="asset-actions"><button onClick={()=>showSource(d.document_id)}>View source <ArrowUpRight size={13}/></button>{kind!=='schema'&&<button onClick={()=>run(()=>inspect(d.document_id),'Clauses loaded')}>Clauses</button>}{d.metadata.existing_policy_id?<button className="primary" onClick={onOpenRules}>Open existing extraction workflow</button>:<button className="primary" onClick={()=>run(async()=>{await post(`/documents/${d.document_id}/process`);await refresh();if(kind!=='schema')await inspect(d.document_id)},kind==='schema'?'Vocabulary proposals created':'Document processing complete')}><Play size={13}/>{kind==='schema'?'Propose vocabulary':kind==='reference'?'Discover ontology':'Extract rules'}</button>}</div></article>)}</Panel>
 <Panel title="Evidence by design" sub="Traceability begins at ingestion."><ol className="principles"><li><strong>Original wording preserved</strong><p>Every clause stores its full extracted text. Original file bytes remain available for download.</p></li><li><strong>Locations stay attached</strong><p>Document, version, section, clause and page where available. Missing metadata is shown as UNKNOWN.</p></li><li><strong>Suggestions stay candidates</strong><p>Extraction cannot approve a rule, vocabulary value or relationship.</p></li></ol><div className="notice">{state.provider==='MockLLMProvider'?'Mock mode retains unfamiliar policy wording as unresolved candidates. Existing catalog policies use the current CPI extraction workflow; configure an external provider for additional uploads.':'External provider responses are schema validated before storage. Human approval is still required.'}</div>{kind==='schema'&&docs.map(d=><div key={d.document_id} className="source-warnings">{d.metadata.warnings?.map(w=><p key={w}>{w}</p>)}</div>)}</Panel></div>
 {selected&&<Panel title="Source clauses" sub="Exact extracted passages and explainable classification checks.">{clauses.map(c=><div className="clause-card" key={c.clause_id}><div><strong>Clause {c.source.clause}</strong><span className="source-meta">{c.source.section}</span></div><p className="original-text">{c.raw_text}</p><div className="button-row">{c.categories.map(k=><Badge key={k}>{k}</Badge>)}</div><small className="muted">{c.classification_method} · Model probability unavailable</small></div>)}</Panel>}
 </>
}
