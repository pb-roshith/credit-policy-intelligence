@prefix cpi: <urn:cpi:ontology:credit-policy:> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:cpi:ontology:credit-policy> a owl:Ontology ;
    rdfs:label "CPI credit policy business ontology" ;
    rdfs:comment "Current semantic schema for source-backed policy knowledge. Business approval remains explicit. Closed-world validation is specified separately in SHACL." ;
    owl:versionIRI cpi:1.2.0 ;
    owl:versionInfo "1.2.0" .

cpi:APPLIES_FOR a owl:ObjectProperty ;
    rdfs:label "applies for" ;
    rdfs:comment "A borrower submits a credit application." ;
    rdfs:domain cpi:Borrower ;
    rdfs:range cpi:LoanApplication .

cpi:APPLIES_IN a owl:ObjectProperty ;
    rdfs:label "applies in" ;
    rdfs:comment "Explicit geographic scope of a rule." ;
    rdfs:domain cpi:PolicyRule ;
    rdfs:range cpi:Geography .

cpi:APPLIES_TO_PRODUCT a owl:ObjectProperty ;
    rdfs:label "applies to product" ;
    rdfs:comment "Explicit applicability to a product, distinct from classification." ;
    rdfs:domain cpi:PolicyRule ;
    rdfs:range cpi:Product .

cpi:APPLIES_TO_SEGMENT a owl:ObjectProperty ;
    rdfs:label "applies to segment" ;
    rdfs:comment "Explicit applicability to a customer segment." ;
    rdfs:domain cpi:PolicyRule ;
    rdfs:range cpi:CustomerSegment .

cpi:Assertion a owl:Class .

cpi:BINDS_TO_ATTRIBUTE a owl:ObjectProperty ;
    rdfs:label "binds to attribute" ;
    rdfs:comment "An explicit proposed or reviewed metric-to-data binding; never inferred from similar labels." ;
    rdfs:domain cpi:RiskMetric ;
    rdfs:range cpi:DataAttribute .

cpi:BORROWS a owl:ObjectProperty ;
    rdfs:label "borrows" ;
    rdfs:comment "A borrower is a party to an originated loan." ;
    rdfs:domain cpi:Borrower ;
    rdfs:range cpi:Loan .

cpi:CLASSIFIED_AS a owl:ObjectProperty ;
    rdfs:label "classified as" ;
    rdfs:comment "A semantic entity is classified using an external controlled taxonomy." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( cpi:PolicyRule cpi:Product cpi:CustomerSegment cpi:RiskMetric cpi:Geography ) ] ;
    rdfs:range cpi:TaxonomyConcept .

cpi:CONTAINS_RULE a owl:ObjectProperty ;
    rdfs:label "contains rule" ;
    rdfs:comment "A policy version or section contains a rule." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( cpi:PolicyVersion cpi:PolicySection ) ] ;
    rdfs:range cpi:PolicyRule .

cpi:CONTAINS_SECTION a owl:ObjectProperty ;
    rdfs:label "contains section" ;
    rdfs:comment "A version contains a section." ;
    rdfs:domain cpi:PolicyVersion ;
    rdfs:range cpi:PolicySection .

cpi:DERIVED_FROM a owl:ObjectProperty ;
    rdfs:label "derived from" ;
    rdfs:comment "A rule is grounded in one or more exact source passages from its own policy version." ;
    rdfs:domain cpi:PolicyRule ;
    rdfs:range cpi:SourcePassage .

cpi:EVIDENCE_FOR a owl:ObjectProperty ;
    rdfs:label "evidence for" ;
    rdfs:comment "An evidence artifact supports an application, rule or exception." ;
    rdfs:domain cpi:ControlEvidence ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( cpi:LoanApplication cpi:PolicyRule cpi:Exception ) ] .

cpi:GOVERNED_BY a owl:ObjectProperty ;
    rdfs:label "governed by" ;
    rdfs:comment "The exact policy version governing a loan; not inferred merely from product mentions." ;
    rdfs:domain cpi:Loan ;
    rdfs:range cpi:PolicyVersion .

cpi:HAS_APPLICABILITY a owl:ObjectProperty ;
    rdfs:label "has applicability" ;
    rdfs:comment "Source-backed scope inherited by rules of this policy version." ;
    rdfs:domain cpi:PolicyVersion ;
    rdfs:range cpi:ConditionGroup .

cpi:HAS_CONDITION a owl:ObjectProperty ;
    rdfs:label "has condition" ;
    rdfs:comment "The explicit logical condition for a rule, exception or approval requirement." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( cpi:PolicyRule cpi:Exception cpi:ApprovalRequirement ) ] ;
    rdfs:range cpi:ConditionGroup .

cpi:HAS_EFFECTIVE_PERIOD a owl:ObjectProperty ;
    rdfs:label "has effective period" ;
    rdfs:comment "An explicitly stated validity period; no period implies no known validity." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( cpi:PolicyVersion cpi:PolicyRule cpi:Exception ) ] ;
    rdfs:range cpi:EffectivePeriod .

cpi:HAS_EXCEPTION a owl:ObjectProperty ;
    rdfs:label "has exception" ;
    rdfs:comment "A rule permits an explicitly stated exception." ;
    rdfs:domain cpi:PolicyRule ;
    rdfs:range cpi:Exception ;
    owl:inverseOf cpi:EXCEPTION_TO .

cpi:HAS_EXCLUSION a owl:ObjectProperty ;
    rdfs:label "has exclusion" ;
    rdfs:comment "Source-backed exclusion from a policy version." ;
    rdfs:domain cpi:PolicyVersion ;
    rdfs:range cpi:ConditionGroup .

cpi:HAS_MEMBER a owl:ObjectProperty ;
    rdfs:label "has member" ;
    rdfs:comment "A logical expression contains comparison terms or nested expressions." ;
    rdfs:domain cpi:ConditionGroup ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( cpi:Condition cpi:ConditionGroup ) ] .

cpi:HAS_THRESHOLD a owl:ObjectProperty ;
    rdfs:label "has threshold" ;
    rdfs:comment "A rule has a numerical boundary." ;
    rdfs:domain cpi:PolicyRule ;
    rdfs:range cpi:Threshold .

cpi:IMPLEMENTED_BY_RULE a owl:ObjectProperty ;
    rdfs:label "implemented by rule" ;
    rdfs:comment "An optional alternative rule specifies the permitted deviation." ;
    rdfs:domain cpi:Exception ;
    rdfs:range cpi:PolicyRule .

cpi:MEASURED_BY a owl:ObjectProperty ;
    rdfs:label "measured by" ;
    rdfs:comment "The metric against which a threshold is interpreted." ;
    rdfs:domain cpi:Threshold ;
    rdfs:range cpi:RiskMetric .

cpi:MEMBER_OF_SEGMENT a owl:ObjectProperty ;
    rdfs:label "member of segment" ;
    rdfs:comment "Source-backed customer membership in a segment." ;
    rdfs:domain cpi:Customer ;
    rdfs:range cpi:CustomerSegment .

cpi:OF_PRODUCT a owl:ObjectProperty ;
    rdfs:label "of product" ;
    rdfs:comment "The product type of an originated loan." ;
    rdfs:domain cpi:Loan ;
    rdfs:range cpi:Product .

cpi:PARENT_SECTION a owl:ObjectProperty ;
    rdfs:label "parent section" ;
    rdfs:comment "Optional containing section within the same version." ;
    rdfs:domain cpi:PolicySection ;
    rdfs:range cpi:PolicySection .

cpi:PART_OF_VERSION a owl:ObjectProperty ;
    rdfs:label "part of version" ;
    rdfs:comment "A section or rule belongs to exactly one policy version." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( cpi:PolicySection cpi:PolicyRule ) ] ;
    rdfs:range cpi:PolicyVersion .

cpi:REQUESTS_PRODUCT a owl:ObjectProperty ;
    rdfs:label "requests product" ;
    rdfs:comment "The product requested by an application." ;
    rdfs:domain cpi:LoanApplication ;
    rdfs:range cpi:Product .

cpi:REQUIRES_APPROVAL a owl:ObjectProperty ;
    rdfs:label "requires approval" ;
    rdfs:comment "A rule or exception requires a decision, not evidence that it has been granted." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( cpi:PolicyRule cpi:Exception ) ] ;
    rdfs:range cpi:ApprovalRequirement .

cpi:REQUIRES_APPROVAL_FROM a owl:ObjectProperty ;
    rdfs:label "requires approval from" ;
    rdfs:comment "The role or committee required for an approval decision." ;
    rdfs:domain cpi:ApprovalRequirement ;
    rdfs:range cpi:ApprovalAuthority .

cpi:REQUIRES_EVIDENCE a owl:ObjectProperty ;
    rdfs:label "requires evidence" ;
    rdfs:comment "A rule or approval requires an evidence type." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( cpi:PolicyRule cpi:ApprovalRequirement ) ] ;
    rdfs:range cpi:EvidenceRequirement .

cpi:RESULTS_IN a owl:ObjectProperty ;
    rdfs:label "results in" ;
    rdfs:comment "An application results in an originated loan; absence does not imply rejection." ;
    rdfs:domain cpi:LoanApplication ;
    rdfs:range cpi:Loan .

cpi:SATISFIES_REQUIREMENT a owl:ObjectProperty ;
    rdfs:label "satisfies requirement" ;
    rdfs:comment "A recorded claim that an evidence artifact satisfies a requirement; verification remains explicit." ;
    rdfs:domain cpi:ControlEvidence ;
    rdfs:range cpi:EvidenceRequirement .

cpi:SOURCE_IN_VERSION a owl:ObjectProperty ;
    rdfs:label "source in version" ;
    rdfs:comment "The policy version containing an exact source passage." ;
    rdfs:domain cpi:SourcePassage ;
    rdfs:range cpi:PolicyVersion .

cpi:SemanticInstance a owl:Class .

cpi:USES_METRIC a owl:ObjectProperty ;
    rdfs:label "uses metric" ;
    rdfs:comment "A rule uses a defined risk measure." ;
    rdfs:domain cpi:PolicyRule ;
    rdfs:range cpi:RiskMetric .

cpi:VERSION_OF a owl:ObjectProperty ;
    rdfs:label "version of" ;
    rdfs:comment "A policy version belongs to one stable policy identity." ;
    rdfs:domain cpi:PolicyVersion ;
    rdfs:range cpi:CreditPolicy .

cpi:allowed_units a owl:DatatypeProperty ;
    rdfs:domain cpi:RiskMetric ;
    rdfs:range xsd:string .

cpi:application_reference a owl:DatatypeProperty ;
    rdfs:domain cpi:LoanApplication ;
    rdfs:range xsd:string .

cpi:attribute_name a owl:DatatypeProperty ;
    rdfs:domain cpi:DataAttribute ;
    rdfs:range xsd:string .

cpi:authority_code a owl:DatatypeProperty ;
    rdfs:domain cpi:ApprovalAuthority ;
    rdfs:range xsd:string .

cpi:authority_kind a owl:DatatypeProperty ;
    rdfs:domain cpi:ApprovalAuthority ;
    rdfs:range xsd:string .

cpi:clause_reference a owl:DatatypeProperty ;
    rdfs:domain cpi:SourcePassage ;
    rdfs:range xsd:string .

cpi:code_scheme a owl:DatatypeProperty ;
    rdfs:domain cpi:Geography ;
    rdfs:range xsd:string .

cpi:collected_on a owl:DatatypeProperty ;
    rdfs:domain cpi:ControlEvidence ;
    rdfs:range xsd:date .

cpi:currency a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( cpi:LoanApplication cpi:Loan ) ] ;
    rdfs:range xsd:string .

cpi:customer_kind a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( cpi:Customer cpi:Borrower ) ] ;
    rdfs:range xsd:string .

cpi:customer_reference a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( cpi:Customer cpi:Borrower ) ] ;
    rdfs:range xsd:string .

cpi:decision_type a owl:DatatypeProperty ;
    rdfs:domain cpi:ApprovalRequirement ;
    rdfs:range xsd:string .

cpi:document_reference a owl:DatatypeProperty ;
    rdfs:domain cpi:SourcePassage ;
    rdfs:range xsd:string .

cpi:end_date a owl:DatatypeProperty ;
    rdfs:domain cpi:EffectivePeriod ;
    rdfs:range xsd:date .

cpi:entity_name a owl:DatatypeProperty ;
    rdfs:domain cpi:DataAttribute ;
    rdfs:range xsd:string .

cpi:evidence_reference a owl:DatatypeProperty ;
    rdfs:domain cpi:ControlEvidence ;
    rdfs:range xsd:string .

cpi:evidence_type a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( cpi:EvidenceRequirement cpi:ControlEvidence ) ] ;
    rdfs:range xsd:string .

cpi:exception_reference a owl:DatatypeProperty ;
    rdfs:domain cpi:Exception ;
    rdfs:range xsd:string .

cpi:field a owl:DatatypeProperty ;
    rdfs:domain cpi:Condition ;
    rdfs:range xsd:string .

cpi:formula a owl:DatatypeProperty ;
    rdfs:domain cpi:RiskMetric ;
    rdfs:range xsd:string .

cpi:geography_code a owl:DatatypeProperty ;
    rdfs:domain cpi:Geography ;
    rdfs:range xsd:string .

cpi:loan_reference a owl:DatatypeProperty ;
    rdfs:domain cpi:Loan ;
    rdfs:range xsd:string .

cpi:logic a owl:DatatypeProperty ;
    rdfs:domain cpi:ConditionGroup ;
    rdfs:range xsd:string .

cpi:maximum_age_days a owl:DatatypeProperty ;
    rdfs:domain cpi:EvidenceRequirement ;
    rdfs:range xsd:integer .

cpi:metric_key a owl:DatatypeProperty ;
    rdfs:domain cpi:RiskMetric ;
    rdfs:range xsd:string .

cpi:mode a owl:DatatypeProperty ;
    rdfs:range xsd:string .

cpi:notes a owl:DatatypeProperty ;
    rdfs:domain cpi:ApprovalRequirement ;
    rdfs:range xsd:string .

cpi:ontologyVersion a owl:DatatypeProperty ;
    rdfs:range xsd:string .

cpi:operator a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( cpi:Condition cpi:Threshold ) ] ;
    rdfs:range xsd:string .

cpi:origin a owl:DatatypeProperty ;
    rdfs:domain cpi:SourcePassage ;
    rdfs:range xsd:string .

cpi:page a owl:DatatypeProperty ;
    rdfs:domain cpi:SourcePassage ;
    rdfs:range xsd:integer .

cpi:policy_reference a owl:DatatypeProperty ;
    rdfs:domain cpi:CreditPolicy ;
    rdfs:range xsd:string .

cpi:product_code a owl:DatatypeProperty ;
    rdfs:domain cpi:Product ;
    rdfs:range xsd:string .

cpi:rationale a owl:DatatypeProperty ;
    rdfs:domain cpi:Exception ;
    rdfs:range xsd:string .

cpi:registry_reference a owl:DatatypeProperty ;
    rdfs:domain cpi:DataAttribute ;
    rdfs:range xsd:string .

cpi:requested_amount a owl:DatatypeProperty ;
    rdfs:domain cpi:LoanApplication ;
    rdfs:range xsd:decimal .

cpi:requirement_text a owl:DatatypeProperty ;
    rdfs:domain cpi:PolicyRule ;
    rdfs:range xsd:string .

cpi:risk_domain a owl:DatatypeProperty ;
    rdfs:domain cpi:CreditPolicy ;
    rdfs:range xsd:string .

cpi:rule_kind a owl:DatatypeProperty ;
    rdfs:domain cpi:PolicyRule ;
    rdfs:range xsd:string .

cpi:rule_reference a owl:DatatypeProperty ;
    rdfs:domain cpi:PolicyRule ;
    rdfs:range xsd:string .

cpi:section_reference a owl:DatatypeProperty ;
    rdfs:domain cpi:PolicySection ;
    rdfs:range xsd:string .

cpi:segment_code a owl:DatatypeProperty ;
    rdfs:domain cpi:CustomerSegment ;
    rdfs:range xsd:string .

cpi:sourceRef a owl:ObjectProperty ;
    rdfs:range cpi:SourcePassage .

cpi:source_checksum a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( cpi:PolicyVersion cpi:SourcePassage ) ] ;
    rdfs:range xsd:string .

cpi:start_date a owl:DatatypeProperty ;
    rdfs:domain cpi:EffectivePeriod ;
    rdfs:range xsd:date .

cpi:status a owl:DatatypeProperty ;
    rdfs:range xsd:string .

cpi:synthetic a owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

cpi:taxonomy_id a owl:DatatypeProperty ;
    rdfs:domain cpi:TaxonomyConcept ;
    rdfs:range xsd:string .

cpi:taxonomy_version a owl:DatatypeProperty ;
    rdfs:domain cpi:TaxonomyConcept ;
    rdfs:range xsd:string .

cpi:text a owl:DatatypeProperty ;
    rdfs:domain cpi:SourcePassage ;
    rdfs:range xsd:string .

cpi:unit a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( cpi:Condition cpi:Threshold ) ] ;
    rdfs:range xsd:string .

cpi:value a rdf:Property ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( cpi:Condition cpi:Threshold ) ] .

cpi:verification_state a owl:DatatypeProperty ;
    rdfs:domain cpi:ControlEvidence ;
    rdfs:range xsd:string .

cpi:version a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( cpi:PolicyVersion cpi:SourcePassage ) ] ;
    rdfs:range xsd:string .

cpi:EXCEPTION_TO a owl:ObjectProperty ;
    rdfs:label "exception to" ;
    rdfs:comment "The one base rule from which an exception permits deviation." ;
    rdfs:domain cpi:Exception ;
    rdfs:range cpi:PolicyRule .

cpi:ApprovalAuthority a owl:Class ;
    rdfs:label "Approval authority" ;
    rdfs:comment "An accountable role or committee empowered to make a specified decision." .

cpi:CreditPolicy a owl:Class ;
    rdfs:label "Credit policy" ;
    rdfs:comment "A stable policy identity across separately identified versions." .

cpi:EffectivePeriod a owl:Class ;
    rdfs:label "Effective period" ;
    rdfs:comment "An inclusive start date and optional inclusive end date; absent period means unknown validity." .

cpi:TaxonomyConcept a owl:Class ;
    rdfs:label "Taxonomy concept" ;
    rdfs:comment "A reference to a controlled classification concept; classification is distinct from executable applicability." .

cpi:Borrower a owl:Class ;
    rdfs:label "Borrower" ;
    rdfs:comment "A customer seeking or receiving credit; a specialized Customer." ;
    rdfs:subClassOf cpi:Customer .

cpi:Customer a owl:Class ;
    rdfs:label "Customer" ;
    rdfs:comment "A person or organization with a banking relationship." .

cpi:CustomerSegment a owl:Class ;
    rdfs:label "Customer segment" ;
    rdfs:comment "A controlled grouping of customers, such as SME; no numerical SME definition is assumed." .

cpi:DataAttribute a owl:Class ;
    rdfs:label "Data attribute" ;
    rdfs:comment "An exact source-system or workbook attribute; bindings require separate governance." .

cpi:EvidenceRequirement a owl:Class ;
    rdfs:label "Evidence requirement" ;
    rdfs:comment "A required evidence type and optional freshness condition." .

cpi:Geography a owl:Class ;
    rdfs:label "Geography" ;
    rdfs:comment "A jurisdiction or geographic grouping used in explicit policy scope." .

cpi:Condition a owl:Class ;
    rdfs:label "Condition" ;
    rdfs:comment "A typed comparison used in scope, eligibility or exception logic." .

cpi:Product a owl:Class ;
    rdfs:label "Product" ;
    rdfs:comment "A controlled credit product or facility type." .

cpi:Threshold a owl:Class ;
    rdfs:label "Threshold" ;
    rdfs:comment "A numerical boundary with an operator and unit, measured against exactly one metric." .

cpi:ApprovalRequirement a owl:Class ;
    rdfs:label "Approval requirement" ;
    rdfs:comment "A required decision by an identified authority; this is not an approval already granted." .

cpi:ConditionGroup a owl:Class ;
    rdfs:label "Condition group" ;
    rdfs:comment "An explicit AND, OR or NOT expression over conditions or nested groups." .

cpi:ControlEvidence a owl:Class ;
    rdfs:label "Control evidence" ;
    rdfs:comment "An actual evidence artifact with its recorded verification state." .

cpi:Loan a owl:Class ;
    rdfs:label "Loan" ;
    rdfs:comment "An originated credit agreement or facility." .

cpi:PolicySection a owl:Class ;
    rdfs:label "Policy section" ;
    rdfs:comment "A section of one policy version, optionally nested within another section." .

cpi:LoanApplication a owl:Class ;
    rdfs:label "Loan application" ;
    rdfs:comment "A request for credit, distinct from an originated loan." .

cpi:RiskMetric a owl:Class ;
    rdfs:label "Risk metric" ;
    rdfs:comment "A defined quantitative measure with declared permitted units and optional formula." .

cpi:Exception a owl:Class ;
    rdfs:label "Exception" ;
    rdfs:comment "A conditional deviation from one base rule. Approval and alternative rules are explicit links." .

cpi:SourcePassage a owl:Class ;
    rdfs:label "Source passage" ;
    rdfs:comment "Exact evidence text, source identity, version and checksum; never a generated policy summary." .

cpi:PolicyVersion a owl:Class ;
    rdfs:label "Policy version" ;
    rdfs:comment "An immutable, source-bound version of a credit policy." .

cpi:PolicyRule a owl:Class ;
    rdfs:label "Policy rule" ;
    rdfs:comment "A source-derived normative requirement within exactly one policy version." .

