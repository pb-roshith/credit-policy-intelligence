          "required": [
            "field",
            "operator"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "operator": {
                    "const": "EXISTS"
                  }
                }
              },
              "then": {
                "not": {
                  "required": [
                    "value"
                  ]
                }
              },
              "else": {
                "required": [
                  "value"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "operator": {
                    "enum": [
                      "IN",
                      "NOT_IN"
                    ]
                  }
                }
              },
              "then": {
                "properties": {
                  "value": {
                    "type": "array"
                  }
                }
              },
              "else": {
                "properties": {
                  "value": {
                    "not": {
                      "type": "array"
                    }
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "operator": {
                    "enum": [
                      "GT",
                      "GTE",
                      "LT",
                      "LTE"
                    ]
                  }
                }
              },
              "then": {
                "properties": {
                  "value": {
                    "type": "number"
                  }
                }
              }
            }
          ]
        }
