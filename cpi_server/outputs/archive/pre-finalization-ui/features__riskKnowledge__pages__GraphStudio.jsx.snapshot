import React,{useEffect,useState} from 'react';
import {ArrowRight,GitBranch} from 'lucide-react';
import Graph from '../graph/Graph';
import {api} from '../services/api';
import {Panel,Badge,Source,ReviewControls,ExportButton} from '../components/ui';
import PolicyScope from './PolicyScope';
import SemanticOntology from './SemanticOntology';
import SemanticKnowledge from './SemanticKnowledge';

export default function GraphStudio(props) {
 return props.ontology?<SemanticOntology renderRelationships={()=><GraphExplorer {...props}/>}/>:<SemanticKnowledge {...props} renderOperational={()=><GraphExplorer {...props}/>}/>;
}

function GraphExplorer({state,concepts,ontology=false,run,refresh,showSource,setRule,go,onOpenRules,canReview}) {
 const [requestInput,setRequestInput]=useState(''),[requestId,setRequestId]=useState(''),[scopePolicy,setScopePolicy]=useState(null);
 const [graph,setGraph]=useState(null),[filters,setFilters]=useState(()=>{const focus=sessionStorage.getItem('riskKnowledgeFocus')||'';sessionStorage.removeItem('riskKnowledgeFocus');return {domain:'',entity_type:'',predicate:'',source:'',status:'',focus}}),[relationship,setRelationship]=useState(null),[node,setNode]=useState(null),[error,setError]=useState('');
 const byId=Object.fromEntries(concepts.map(c=>[c.concept_id,c]));
 useEffect(()=>{let active=true;setError('');setGraph(null);setNode(null);const path=requestId&&!ontology?`/requests/${encodeURIComponent(requestId)}/graph?`+new URLSearchParams({focus:filters.focus}):'/graph?'+new URLSearchParams({...filters,layer:ontology?'ontology':'policy'});api(path).then(d=>{if(active)setGraph(d)}).catch(e=>{if(active)setError(e.message)});return()=>{active=false}},[filters,ontology,state,requestId]);
 const option=(key,value)=>setFilters(f=>({...f,[key]:value}));
 const relation=state.ontology.find(r=>r.relationship_id===relationship);
 const decisions=graph?.report?.decisions||[];
 return <>
 {!ontology&&<Panel title="Trace a credit request" sub="Follow source-backed policies and rules, with deterministic applicability decisions."><form className="toolbar" onSubmit={e=>{e.preventDefault();option('focus','');setRequestId(requestInput.trim())}}><label>Credit request ID<input value={requestInput} onChange={e=>setRequestInput(e.target.value)} placeholder="Enter a request available to your account" required/></label><button className="primary" type="submit">Trace request</button><button type="button" onClick={()=>{setRequestId('');option('focus','')}}>Show shared graph</button></form></Panel>}
 <div className="toolbar"><div className="button-row">
 <button className={!filters.focus?'primary':''} onClick={()=>option('focus','')}>Full {ontology?'ontology':'policy graph'}</button>
 <button onClick={()=>{setRequestId('');setFilters({domain:'',entity_type:'',predicate:'',source:'',status:'',focus:concepts.find(c=>c.kind==='ENTITY'&&c.source.origin==='SOURCE_SCHEMA')?.concept_id||''})}}><GitBranch size={15}/>Explore source schema</button>
 {node&&<button onClick={()=>option('focus',node.id)}>Explore selected node</button>}
 {node?.type==='GovernedPolicyRule'&&<button onClick={onOpenRules}>Open governed rule library</button>}
 {node?.type==='PolicyRule'&&<button onClick={()=>{setRule(node.id);go('Rule Review')}}>Review rule <ArrowRight size={14}/></button>}
 {node?.type==='PolicyDocument'&&canReview&&<button onClick={()=>setScopePolicy(Number(node.id.replace('CPI-POLICY-','')))}>Review policy scope</button>}
 </div><ExportButton kind={ontology?'ontology':'graph'}/></div>
 <Panel title={ontology?'Ontology explorer':requestId?`Applicability graph: ${requestId}`:'Policy knowledge graph'} sub="Click a node for evidence; explore it to traverse its incoming and outgoing relationships.">
 {!requestId&&<div className="graph-filters"><label>Risk domain<select value={filters.domain} onChange={e=>option('domain',e.target.value)}><option value="">All domains</option><option>Credit Risk</option><option>UNKNOWN</option></select></label><label>Entity type<select value={filters.entity_type} onChange={e=>option('entity_type',e.target.value)}><option value="">All entities</option>{['GovernedPolicyRule','PolicyRule','PolicyClause','PolicyScope','Condition','Exception','ApprovalAuthority','PolicyDocument','ATTRIBUTE','ENTITY','VALUE'].map(v=><option key={v}>{v}</option>)}</select></label><label>Relationship<select value={filters.predicate} onChange={e=>option('predicate',e.target.value)}><option value="">All relationships</option>{[...new Set(['CONTAINS','DERIVED_FROM','APPLIES_TO','MAPS_TO','HAS_SCOPE','HAS_CONDITION','REQUIRES','APPROVED_BY','HAS_EXCEPTION',...state.ontology.map(r=>r.predicate)])].map(v=><option key={v}>{v}</option>)}</select></label><label>Source<input placeholder="Document name" value={filters.source} onChange={e=>option('source',e.target.value)}/></label><label>Review status<select value={filters.status} onChange={e=>option('status',e.target.value)}><option value="">All statuses</option>{['SOURCE','AI_PROPOSED','CANDIDATE','APPROVED','ACTIVE','REQUIRES_REVIEW','DRAFT','REJECTED','SUPERSEDED'].map(v=><option key={v}>{v}</option>)}</select></label></div>}
 {error&&<div role="alert" className="notice error">{error}</div>}{graph?<Graph key={(ontology?'o':'g')+requestId+filters.focus} data={graph} onNode={setNode} onDocument={showSource}/>:!error&&<div className="loading">Loading graph...</div>}
 {graph?.truncated&&<div className="notice">Showing {graph.nodes.length} of {graph.total_nodes} nodes. Select a policy or rule below to explore its source and relationships.</div>}
 </Panel>
 {!!decisions.length&&<Panel title="Applicability decisions" sub="Unknown scope stays unresolved. These selections use no LLM."><div className="relationship-list">{decisions.map(d=><button key={d.graph_node_id} onClick={()=>option('focus',d.graph_node_id)}><span>{d.candidate_type} {d.candidate_id}</span><Badge>{d.applicability}</Badge><span>{d.reason}</span></button>)}</div></Panel>}
 {scopePolicy&&canReview&&<PolicyScope key={scopePolicy} policyId={scopePolicy} run={run} refresh={refresh} onClose={()=>setScopePolicy(null)}/>}
 {ontology&&<Panel title="Relationship review" sub="Candidate discovery never implies approval."><div className="relationship-list">{state.ontology.map(r=><button className={relationship===r.relationship_id?'selected':''} onClick={()=>setRelationship(r.relationship_id)} key={r.relationship_id}><span>{byId[r.subject]?.preferred_name||r.subject}</span><code>{r.predicate}</code><span>{byId[r.object]?.preferred_name||r.object}</span><Badge>{r.status}</Badge></button>)}</div></Panel>}
 {ontology&&relation&&<Panel title="Review ontology relationship"><div className="grid two"><Source source={relation.source} onDocument={showSource}/><div><p className="muted">Approve both taxonomy endpoints before approving this relationship.</p><ReviewControls key={relation.relationship_id} kind="ontology" id={relation.relationship_id} run={run} onRefresh={refresh}/></div></div></Panel>}
 </>
}
