<urn:cpi:example:credit-score> a cpi:RiskMetric ;
    rdfs:label "Credit score" ;
    cpi:allowed_units "score_points"^^xsd:string ;
    cpi:metric_key "credit_score"^^xsd:string ;
    cpi:sourceRef <urn:cpi:example:passage> ;
    cpi:status "PROPOSED" ;
    cpi:synthetic true .

<urn:cpi:example:dti> a cpi:RiskMetric ;
    rdfs:label "Debt to income" ;
    cpi:allowed_units "%"^^xsd:string ;
    cpi:formula "debt_obligations / income * 100"^^xsd:string ;
    cpi:metric_key "dti"^^xsd:string ;
    cpi:sourceRef <urn:cpi:example:passage> ;
    cpi:status "PROPOSED" ;
    cpi:synthetic true .

