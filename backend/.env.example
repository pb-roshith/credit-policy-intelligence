ADMIN_USER_ID=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password
SESSION_COOKIE_SECURE=false
# Comma-separated exact frontend origins. Do not use * with credentialed requests.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Enable only when the public application is served exclusively over HTTPS.
ENABLE_HSTS=false
MAX_REQUEST_BODY_BYTES=1048576
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
DATABASE_URL=postgresql://postgres:root@localhost:5432/credit_policy_intelligence
MISTRAL_API_KEY=replace-with-your-mistral-api-key
MISTRAL_POLICY_MODEL=mistral-medium-latest
MISTRAL_TIMEOUT_MS=90000
MISTRAL_MANUFACTURING_TIMEOUT_MS=450000
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_STATEMENT_TIMEOUT_MS=120000
DATABASE_TRANSACTION_RETRIES=3
DATABASE_RETRY_BASE_DELAY_MS=50
POLICY_DOCUMENT_TIMEOUT_SECONDS=1500
POLICY_JOB_TIMEOUT_SECONDS=36000
